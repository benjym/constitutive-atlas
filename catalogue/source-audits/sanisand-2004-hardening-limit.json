    },
    "cz": {
      "shape": "scalar",
      "unit": "1",
      "default": 600.0
    },
    "p_at": {
      "shape": "scalar",
      "unit": "Pa",
      "default": 100000.0
    },
    "sigma": {
      "shape": "sym",
      "unit": "Pa"
    },
    "e": {
      "shape": "scalar",
      "unit": "1"
    },
    "alpha": {
      "shape": "sym",
      "unit": "1"
    },
    "z": {
      "shape": "sym",
      "unit": "1"
    },
    "alpha_in": {
      "shape": "sym",
      "unit": "1"
    },
    "d_epsilon": {
      "shape": "sym",
      "unit": "1"
    }
  },
  "terms": [
    {
      "name": "p",
      "expression": "trace(sigma)/3",
      "shape": "scalar",
      "unit": "Pa",
      "locator": "p. 627, multiaxial definitions"
    },
    {
      "name": "s",
      "expression": "dev(sigma)",
      "shape": "sym",
      "unit": "Pa",
      "locator": "p. 627, multiaxial definitions"
    },
    {
      "name": "r",
      "expression": "s/p",
      "shape": "sym",
      "unit": "1",
      "locator": "p. 627, multiaxial definitions"
    },
    {
      "name": "yield_value",
      "expression": "norm(s-p*alpha)-sqrt(2/3)*p*m",
      "shape": "scalar",
      "unit": "Pa",
      "locator": "Eq. 13, p. 627"
    },
    {
      "name": "n",
      "expression": "(r-alpha)/(sqrt(2/3)*m)",
      "shape": "sym",
      "unit": "1",
      "locator": "Eq. 14, p. 627",
      "note": "Evaluated only on the yield cone; no off-surface extension is selected."
    },
    {
      "name": "G",
      "expression": "G0*p_at*(2.97-e)**2/(1+e)*(p/p_at)**(1/2)",
      "shape": "scalar",
      "unit": "Pa",
      "locator": "Eq. 3, p. 623"
    },
    {
      "name": "K",
      "expression": "2*(1+nu)/(3*(1-2*nu))*G",
      "shape": "scalar",
      "unit": "Pa",
      "locator": "Eq. 3, p. 623"
    },
    {
      "name": "ec",
      "expression": "e0-lambda_c*(p/p_at)**xi",
      "shape": "scalar",
      "unit": "1",
      "locator": "Eq. 8, p. 624"
    },
    {
      "name": "psi",
      "expression": "e-ec",
      "shape": "scalar",
      "unit": "1",
      "locator": "state parameter, p. 624"
    },
    {
      "name": "cos3theta",
      "expression": "sqrt(6)*cube_trace(n)",
      "shape": "scalar",
      "unit": "1",
      "locator": "Eq. 15, p. 628"
    },
    {
      "name": "g",
      "expression": "2*c/((1+c)-(1-c)*cos3theta)",
      "shape": "scalar",
      "unit": "1",
      "locator": "Eq. 16, p. 628"
    },
    {
      "name": "alpha_b",
      "expression": "sqrt(2/3)*(g*M*exp(-nb*psi)-m)*n",
      "shape": "sym",
      "unit": "1",
      "locator": "Eq. 17, p. 628"
    },
    {
      "name": "alpha_d",
      "expression": "sqrt(2/3)*(g*M*exp(nd*psi)-m)*n",
      "shape": "sym",
      "unit": "1",
      "locator": "Eq. 17, p. 628"
    },
    {
      "name": "B",
      "expression": "1+(3/2)*(1-c)/c*g*cos3theta",
      "shape": "scalar",
      "unit": "1",
      "locator": "Eq. 19b, p. 628"
    },
    {
      "name": "C",
      "expression": "3*sqrt(3/2)*(1-c)/c*g",
      "shape": "scalar",
      "unit": "1",
      "locator": "Eq. 19c, p. 628"
    },
    {
      "name": "Rdev",
      "expression": "B*n-C*(tensor_square(n)-I/3)",
      "shape": "sym",
      "unit": "1",
      "locator": "Eq. 19a, p. 628"
    },
    {
      "name": "b0",
      "expression": "G0*h0*(1-ch*e)*(p/p_at)**(-1/2)",
      "shape": "scalar",
      "unit": "1",
      "locator": "Eq. 6, p. 623"
    },
    {
      "name": "hardening_distance",
      "expression": "dot(alpha-alpha_in,n)",
      "shape": "scalar",
      "unit": "1",
      "locator": "Eq. 24 denominator, p. 631"
    },
    {
      "name": "Ad",
      "expression": "A0*(1+max(dot(z,n),0))",
      "shape": "scalar",
      "unit": "1",
      "locator": "Eq. 27, p. 631"
    },
    {
      "name": "D",
      "expression": "Ad*dot(alpha_d-alpha,n)",
      "shape": "scalar",
      "unit": "1",
      "locator": "Eq. 25, p. 631"
    },
    {
      "name": "R",
      "expression": "Rdev+D*I/3",
      "shape": "sym",
      "unit": "1",
      "locator": "Eq. 19a, p. 628"
    },
    {
      "name": "volumetric_increment",
      "expression": "trace(d_epsilon)",
      "shape": "scalar",
      "unit": "1",
      "locator": "strain decomposition, p. 629"
    },
    {
      "name": "de",
      "expression": "dev(d_epsilon)",
      "shape": "sym",
      "unit": "1",
      "locator": "strain decomposition, p. 629"
    },
    {
      "name": "hardening_numerator",
      "expression": "(2/3)*p*b0*dot(alpha_b-alpha,n)",
      "shape": "scalar",
      "unit": "Pa",
      "locator": "Derived from Eqs. 20\u201324, pp. 629, 631; see limit dossier"
    },
    {
      "name": "elastic_loading_denominator",
      "expression": "2*G*(B-C*cube_trace(n))-K*D*dot(n,r)",
      "shape": "scalar",
      "unit": "Pa",
      "locator": "Derived from Eqs. 20\u201324, pp. 629, 631; see limit dossier"
    },
    {
      "name": "loading_numerator",
      "expression": "2*G*dot(n,de)-K*volumetric_increment*dot(n,r)",
      "shape": "scalar",
      "unit": "Pa",
      "locator": "Derived Eq. 20 numerator includes K; apparent printed omission remains an independent-review item."
    },
    {
      "name": "scaled_loading_denominator",
      "expression": "hardening_numerator+hardening_distance*elastic_loading_denominator",
      "shape": "scalar",
      "unit": "Pa",
      "locator": "Derived from Eqs. 20\u201324, pp. 629, 631; see limit dossier"
    },
    {
      "name": "scaled_loading_index",
      "expression": "loading_numerator/scaled_loading_denominator",
      "shape": "scalar",
      "unit": "1",
      "locator": "Derived from Eqs. 20\u201324, pp. 629, 631; see limit dossier"
    },
    {
      "name": "plastic_multiplier",
      "expression": "hardening_distance*max(scaled_loading_index,0)",
      "shape": "scalar",
      "unit": "1",
      "locator": "Derived from Eqs. 20\u201324, pp. 629, 631; see limit dossier"
    },
    {
      "name": "multiplier_times_h",
      "expression": "b0*max(scaled_loading_index,0)",
      "shape": "scalar",
      "unit": "1",
      "locator": "Derived from Eqs. 20\u201324, pp. 629, 631; see limit dossier"
    },
    {
      "name": "plastic_strain_increment",
      "expression": "plastic_multiplier*R",
      "shape": "sym",
      "unit": "1",
      "locator": "Derived from Eqs. 20\u201324, pp. 629, 631; see limit dossier"
    },
    {
      "name": "stress_increment",
      "expression": "2*G*de+K*volumetric_increment*I-plastic_multiplier*(2*G*Rdev+K*D*I)",
      "shape": "sym",
      "unit": "Pa",
      "locator": "Derived from Eqs. 20\u201324, pp. 629, 631; see limit dossier"
    },
    {
      "name": "backstress_increment",
      "expression": "(2/3)*multiplier_times_h*(alpha_b-alpha)",
      "shape": "sym",
      "unit": "1",
      "locator": "Derived from Eqs. 20\u201324, pp. 629, 631; see limit dossier"
    },
    {
      "name": "fabric_increment",
      "expression": "-cz*max(-trace(plastic_strain_increment),0)*(zmax*n+z)",
      "shape": "sym",
      "unit": "1",
      "locator": "Derived from Eqs. 20\u201324, pp. 629, 631; see limit dossier"
    },
    {
      "name": "void_ratio_increment",
      "expression": "-(1+e)*volumetric_increment",
      "shape": "scalar",
      "unit": "1",
      "locator": "Project constant-solid-volume closure, not a numbered SANISAND equation."
    }
  ],
  "audit_domain": {
    "on_cone_relative_tolerance": 1e-10,
