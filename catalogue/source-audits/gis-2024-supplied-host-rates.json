  "scope": "Instantaneous supplied-host GIS directional rates with respect to a dimensionless path coordinate. de means its strain derivative/direction, not an integrated finite update. E,m,C,S,f must be independently supplied by the host. No HP/ASBS evaluation, e update, state integration or admission.",
  "convention": {
    "stress": "compression positive",
    "strain": "compression positive",
    "h": "full symmetric compression-positive memory",
    "mandel_order": [
      "xx",
      "yy",
      "zz",
      "sqrt(2)xy",
      "sqrt(2)yz",
      "sqrt(2)xz"
    ],
    "source_mapping": "sigma_atlas=-sigma_source; de_atlas=-de_source; h_atlas=-h_source; m_atlas=-m_source; f_atlas=-f_source; E action unchanged after same Cartesian/Mandel basis mapping. rho, q, k, C, S, Omega unchanged."
  },
