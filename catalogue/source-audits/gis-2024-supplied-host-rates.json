        0,
        0,
        0,
        0,
        0,
        0
      ],
      "k": null,
      "q": null,
      "suppression": null
    },
    "explanation": "For finite admissible host/state, rates vanish as norm(de) tends to zero regardless of direction; k and suppression have no unique directional value. Return undefined diagnostics rather than invent k=m_R. Nonzero inputs whose norm underflows are rejected, not treated as zero."
  },
  "terms": [
    {
      "name": "hn",
      "expression": "norm(h)",
      "shape": "scalar",
      "unit": "1",
      "locator": "p6 Eq34"
    },
    {
      "name": "hdir",
      "expression": "select(hn>0,h/hn,0*I)",
      "shape": "sym",
      "unit": "1",
      "locator": "p6 Eq34; compression-positive mapping"
    },
    {
      "name": "rho",
      "expression": "hn/R",
      "shape": "scalar",
      "unit": "1",
      "locator": "p6 Eq35"
    },
    {
      "name": "dn",
      "expression": "norm(de)",
      "shape": "scalar",
      "unit": "1",
      "locator": "p7 Eq40; rate-independent direction input"
    },
    {
      "name": "loading",
      "expression": "dot(hdir,de)",
      "shape": "scalar",
      "unit": "1",
      "locator": "p5 Eq33"
    },
    {
      "name": "h_rhs",
      "expression": "select(loading>0,de-hdir*(rho**beta_R)*loading,de)",
      "shape": "sym",
      "unit": "1",
      "locator": "p5 Eq33; p6 adoption in Section5"
    },
    {
      "name": "chi",
      "expression": "chi_0+Omega*(chi_max-chi_0)",
      "shape": "scalar",
      "unit": "1",
      "locator": "p7 Eq42"
    },
    {
      "name": "gamma",
      "expression": "gamma_chi*chi",
      "shape": "scalar",
      "unit": "1",
      "locator": "p7 Eq41"
    },
    {
      "name": "Omega_rhs",
      "expression": "C_Omega*(1-rho**gamma_Omega-Omega)*dn",
      "shape": "scalar",
      "unit": "1",
      "locator": "p7 Eq43"
    },
    {
      "name": "q",
      "expression": "loading/dn",
      "shape": "scalar",
      "unit": "1",
      "locator": "p6 Eq39; nonzero de only"
    },
    {
      "name": "k",
      "expression": "select(loading>0,(1-rho**chi_R)*m_R+rho**chi_R*((1-q)*m_T+q),rho**chi_R*(1+q)*m_T+(1-rho**chi_R*(1+q))*m_R)",
      "shape": "scalar",
      "unit": "1",
      "locator": "p6 Eq39; algebraically equivalent convex interpolation avoids full-memory cancellation"
    },
    {
      "name": "suppression",
      "expression": "S**(k**gamma)",
      "shape": "scalar",
      "unit": "1",
      "locator": "p7 Eq40; nested exponent"
    },
    {
      "name": "effective_de",
      "expression": "de-m*C*suppression*dn+f",
      "shape": "sym",
      "unit": "1",
      "locator": "p7 Eq40; f supplied homogeneous host correction"
    },
    {
      "name": "sigma_rhs",
      "expression": "k*E_effective_de",
      "shape": "sym",
      "unit": "Pa",
      "locator": "p7 Eq40; supplied host linear action applied to effective_de"
    }
  ],
  "outputs": [
    "h_rhs",
    "Omega_rhs",
    "sigma_rhs"
  ],
  "excluded": [
