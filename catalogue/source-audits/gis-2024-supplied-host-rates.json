  "host_action": {
    "name": "E",
    "representation": "supplied finite real 6x6 Mandel linear-action matrix",
    "unit": "Pa",
    "input": "effective_de",
    "output": {
      "name": "E_effective_de",
      "shape": "sym",
      "unit": "Pa"
    },
    "meaning": "Caller supplies E at this instantaneous state; no stiffness construction or positive-definiteness claim."
  },
  "audit_domain": {
    "requirements": [
      "finite exact typed inputs, no bools",
      "0<R; 0<beta_R,chi_R,gamma_chi,chi_0,gamma_Omega",
      "chi_max>=chi_0; C_Omega>=0",
      "1<=m_T<=m_R",
      "0<=Omega<=1; norm(h)<=R",
      "C>=0; S>=0",
      "m is normalized to absolute tolerance 1e-12",
      "f is an explicitly supplied host correction; degree-one homogeneity and zero-at-zero are host obligations"
    ],
    "policy": "Bounded positive-parameter audit domain, not asserted exhaustive source parameter bounds. No clipping or norm floor.",
    "roundoff_policy": "Accept norm(h) up to R+16*ulp(R) solely for tensor-component roundoff at prescribed boundary; retain the supplied h unchanged, no projection or clipping. Raw q may lie within64*ulp(1) of[-1,1]; it is retained, not clipped. Nonpositive unresolved k is rejected."
  },
  "zero_direction": {
    "kind": "analytic zero-rate continuation, not source-specified k value",
    "requirements": [
      "de all exactly zero",
      "f all exactly zero"
    ],
    "outputs": {
      "h_rhs": [
        0,
        0,
        0,
        0,
        0,
        0
