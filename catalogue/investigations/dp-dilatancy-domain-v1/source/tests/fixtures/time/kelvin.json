{
  "schema_version": "0.2",
  "status": "draft",
  "id": "test-kelvin",
  "name": "Synthetic Kelvin-Voigt observable verification fixture",
  "family": "engine verification only",
  "description": "Algebraic stress depends on persistent elastic stress and imposed strain rate; engine test only.",
  "sources": [
    {
      "url": "https://github.com/benjym/constitutive-atlas/blob/main/docs/TIMED_SCHEDULES.md",
      "role": "analytical verification specification",
      "locator": "Synthetic Kelvin-Voigt law and analytical ramp/creep check; not Terracotta"
    }
  ],
  "formulation": {
    "time_dependence": "physical_time",
    "equation_form": "ode"
  },
  "parameters": {
    "Kmod": {
      "default": 20000000.0,
      "min": 1,
      "max": 1000000000000.0,
      "unit": "Pa"
    },
    "Gmod": {
      "default": 12000000.0,
      "min": 1,
      "max": 1000000000000.0,
      "unit": "Pa"
    },
    "tau": {
      "default": 2,
      "min": 1e-06,
      "max": 1000000.0,
      "unit": "s"
    },
    "time_limit": {
      "default": 1000000000.0,
      "min": 0.001,
      "max": 1000000000000.0,
      "unit": "s"
    },
    "viscosity": {
      "unit": {
        "si": [
          1,
          -1,
          -1,
          0
        ]
      },
      "default": 24000000.0,
      "min": 1,
      "max": 1000000000000.0
    }
  },
  "state": [
    {
      "name": "sigma",
      "shape": "sym",
      "unit": "Pa",
      "scale": "Kmod",
      "initial": [
        100000,
        100000,
        100000,
        0,
        0,
        0
      ]
    }
  ],
  "derived": [],
  "equations": {
    "sigma": "Kmod * trace(strain_rate) * I + 2 * Gmod * dev(strain_rate)"
  },
  "domain": [
    "time < time_limit"
  ],
  "observables": [
    {
      "name": "stress",
      "shape": "sym",
      "unit": "Pa",
      "scale": "Kmod",
      "expr": "sigma + 2 * viscosity * dev(strain_rate)"
    }
  ]
}
