{
  "schema_version": "0.1",
  "status": "transcribed",
  "parameters": {
    "p_ref": {
      "default": 100000,
      "min": 1,
      "max": 10000000000.0,
      "unit": "Pa",
      "label": "Reference stress / numerical scaling"
    },
    "M": {
      "default": 1.2,
      "min": 0.1,
      "max": 3,
      "unit": "1",
      "label": "Critical-state slope"
    },
    "lambda_c": {
      "default": 0.2,
      "min": 0.001,
      "max": 1,
      "unit": "1",
      "label": "Virgin compression index"
    },
    "kappa": {
      "default": 0.04,
      "min": 0.0001,
      "max": 0.5,
      "unit": "1",
      "label": "Swelling index"
    },
    "nu": {
      "default": 0.25,
      "min": -0.9,
      "max": 0.49,
      "unit": "1",
      "label": "Poisson ratio"
    }
  },
  "state": [
    {
      "name": "sigma",
      "unit": "Pa",
      "initial": [
        100000.0,
        100000.0,
        100000.0,
        0,
        0,
        0
      ],
      "shape": "sym",
      "scale": "p_ref"
    },
    {
      "name": "e",
      "unit": "1",
      "initial": 0.7,
      "shape": "scalar",
      "scale": "1"
    },
    {
      "name": "pc",
      "unit": "Pa",
      "initial": 200000,
      "shape": "scalar",
      "scale": "p_ref"
    },
    {
      "name": "gamma",
      "unit": "1",
      "initial": 0,
      "shape": "scalar",
      "scale": "1",
      "transient": true,
      "multiplier": true
    }
  ],
  "derived": [
    {
      "name": "mean",
      "expr": "trace(sigma) / 3"
    },
    {
      "name": "q2",
      "expr": "1.5 * dot(dev(sigma),dev(sigma))"
    },
    {
      "name": "K",
      "expr": "(1 + e) * mean / kappa"
    },
    {
      "name": "G",
      "expr": "3 * K * (1 - 2 * nu) / (2 * (1 + nu))"
    },
    {
      "name": "yield_scaled",
      "expr": "(q2 + M**2 * mean * (mean - pc)) / p_ref**2"
    },
    {
      "name": "plastic_volume",
      "expr": "gamma * M**2 * (2 * mean - pc) / pc_n"
    }
  ],
  "domain": [
    "e > 0",
    "lambda_c > kappa",
    "mean > p_ref * 1e-8",
    "pc > p_ref * 1e-8",
    "gamma > -1e-9"
  ],
  "integration": "residual",
  "id": "modified-cam-clay",
  "name": "Modified Cam Clay",
  "family": "critical-state plasticity",
  "description": "Associated Modified Cam Clay with pressure/void-ratio dependent elasticity, exponential hardening, and backward-Euler integration. Demonstration parameters; finite rotation is unsupported.",
  "sources": [
    {
      "url": "https://www.opengeosys.org/docs/benchmarks/small-deformations/modifiedcamclay/ModifiedCamClay_report.pdf",
      "locator": "Model equations and incremental formulation; use repository equations for the precise integration convention",
      "role": "formulation"
    }
  ],
  "equations": {
    "sigma": "sigma - sigma_n - K * trace(de) * I - 2 * G * dev(de) + gamma * (6 * G * dev(sigma) / pc_n + K * M**2 * (2 * mean - pc) / pc_n * I)",
    "e": "e - (1 + e_n) * exp(-trace(de)) + 1",
    "pc": "pc - pc_n * exp((1 + e) * plastic_volume / (lambda_c - kappa))",
    "gamma": "sqrt(gamma**2 + yield_scaled**2) - gamma + yield_scaled"
  },
  "initial_checks": [
    "yield_scaled <= 1e-8"
  ]
}
