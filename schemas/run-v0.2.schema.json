{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://benjym.github.io/constitutive-atlas/schemas/run-v0.2.schema.json",
  "title": "Physical-time mixed-control schedule v0.2",
  "description": "Small-strain fixed-frame Mandel order xx,yy,zz,sqrt(2)xy,sqrt(2)yz,sqrt(2)xz. SI values; one stress/strain control per component. Additional semantic checks enforce representable increasing time, unique IDs and total output budgets.",
  "type": "object",
  "required": [
    "schema_version",
    "units",
    "model",
    "start_time",
    "segments",
    "solver"
  ],
  "properties": {
    "schema_version": {
      "const": "0.2"
    },
    "units": {
      "const": "SI"
    },
    "model": {
      "type": "string",
      "minLength": 1
    },
    "parameters": {
      "type": "array",
      "maxItems": 1024,
      "items": {
        "type": "number"
      }
    },
    "initial": {
      "type": "array",
      "minItems": 1,
      "maxItems": 24,
      "items": {
        "type": "number"
      }
    },
    "initial_strain": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "type": "number"
      }
    },
    "initial_strain_rate": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "type": "number"
      }
    },
    "start_time": {
      "type": "number"
    },
    "segments": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "required": [
          "id",
          "duration",
          "samples",
          "controls"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[A-Za-z0-9_-]+$"
          },
          "duration": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "samples": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5000
          },
          "controls": {
            "type": "array",
            "minItems": 6,
            "maxItems": 6,
            "items": {
              "oneOf": [
                {
                  "type": "object",
                  "required": [
                    "quantity",
                    "kind"
                  ],
                  "properties": {
                    "quantity": {
                      "enum": [
                        "strain",
                        "stress"
                      ]
                    },
                    "kind": {
                      "const": "hold"
                    }
                  },
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "required": [
                    "quantity",
                    "kind",
                    "value"
                  ],
                  "properties": {
                    "quantity": {
                      "enum": [
                        "strain",
                        "stress"
                      ]
                    },
                    "kind": {
                      "enum": [
                        "rate",
                        "target"
                      ]
                    },
                    "value": {
                      "type": "number"
                    }
                  },
                  "additionalProperties": false
                }
              ]
            }
          }
        },
        "additionalProperties": false
      }
    },
    "solver": {
      "type": "object",
      "required": [
        "method"
      ],
      "properties": {
        "method": {
          "const": "backward-euler-step-doubling"
        },
        "relative_tolerance": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "absolute_scale_fraction": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "minimum_step": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "maximum_step": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "maximum_substeps": {
          "type": "integer",
          "minimum": 2,
          "maximum": 1000000
        },
        "nonlinear_tolerance": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 0.001
        },
        "maximum_iterations": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
