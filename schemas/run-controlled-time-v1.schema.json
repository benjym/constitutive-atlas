{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Controlled physical-time complete restart and linear-field schedule",
  "type": "object",
  "required": [
    "profile",
    "model",
    "context",
    "settings",
    "segments"
  ],
  "properties": {
    "profile": {
      "const": "controlled-time-ode-v1"
    },
    "model": {
      "type": "string"
    },
    "context": {
      "type": "object",
      "required": [
        "state",
        "time",
        "controls",
        "control_rates",
        "parameters",
        "model_sha256",
        "profile"
      ],
      "properties": {
        "state": {
          "type": "object",
          "additionalProperties": {
            "oneOf": [
              {
                "type": "number"
              },
              {
                "type": "array",
                "minItems": 6,
                "maxItems": 6,
                "items": {
                  "type": "number"
                }
              }
            ]
          }
        },
        "time": {
          "type": "number"
        },
        "controls": {
          "type": "object",
          "additionalProperties": {
            "oneOf": [
              {
                "type": "number"
              },
              {
                "type": "array",
                "minItems": 6,
                "maxItems": 6,
                "items": {
                  "type": "number"
                }
              }
            ]
          }
        },
        "control_rates": {
          "type": "object",
          "additionalProperties": {
            "oneOf": [
              {
                "type": "number"
              },
              {
                "type": "array",
                "minItems": 6,
                "maxItems": 6,
                "items": {
                  "type": "number"
                }
              }
            ]
          }
        },
        "parameters": {
          "type": "object",
          "additionalProperties": {
            "type": "number"
          }
        },
        "model_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "profile": {
          "const": "controlled-time-ode-v1"
        }
      },
      "additionalProperties": false
    },
    "settings": {
      "type": "object",
      "required": [
        "absolute_scale_fraction",
        "relative_tolerance",
        "minimum_step_seconds",
        "maximum_step_seconds",
        "maximum_depth",
        "maximum_trials"
      ],
      "properties": {
        "absolute_scale_fraction": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "relative_tolerance": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "minimum_step_seconds": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "maximum_step_seconds": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "maximum_depth": {
          "type": "integer",
          "minimum": 1,
          "maximum": 60
        },
        "maximum_trials": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        }
      },
      "additionalProperties": false
    },
    "segments": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "required": [
          "id",
          "duration",
          "samples",
          "controls_end"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,80}$"
          },
          "duration": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "samples": {
            "type": "integer",
            "minimum": 1,
            "maximum": 200
          },
          "controls_end": {
            "type": "object",
            "additionalProperties": {
              "oneOf": [
                {
                  "type": "number"
                },
                {
                  "type": "array",
                  "minItems": 6,
                  "maxItems": 6,
                  "items": {
                    "type": "number"
                  }
                }
              ]
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
