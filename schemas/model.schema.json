{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://geomechanics-constitutive-atlas.creamyjoy12.chatgpt.site/schemas/model.schema.json",
  "title": "Constitutive Atlas model v0.1",
  "description": "Structural schema; atlas.model.validate additionally enforces dimensions, tensor types and symbol resolution. JSON files are the canonical JSON-compatible subset of YAML.",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "name",
    "family",
    "description",
    "status",
    "sources",
    "integration",
    "parameters",
    "state",
    "derived",
    "equations",
    "domain"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "family": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "status": {
      "enum": [
        "draft",
        "transcribed",
        "numerically-tested",
        "reviewed"
      ]
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "url",
          "locator",
          "role"
        ],
        "properties": {
          "url": {
            "type": "string",
            "pattern": "^https?://"
          },
          "locator": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "integration": {
      "enum": [
        "residual",
        "rate"
      ]
    },
    "parameters": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "type": "string",
        "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
      },
      "additionalProperties": {
        "type": "object",
        "required": [
          "default",
          "min",
          "max",
          "unit"
        ],
        "properties": {
          "default": {
            "type": "number"
          },
          "min": {
            "type": "number"
          },
          "max": {
            "type": "number"
          },
          "unit": {
            "enum": [
              "1",
              "Pa"
            ]
          },
          "label": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "state": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "name",
          "shape",
          "unit",
          "initial",
          "scale"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
          },
          "shape": {
            "enum": [
              "scalar",
              "sym"
            ]
          },
          "unit": {
            "enum": [
              "1",
              "Pa"
            ]
          },
          "initial": {
            "oneOf": [
              {
                "type": "number"
              },
              {
                "type": "array",
                "items": {
                  "type": "number"
                },
                "minItems": 6,
                "maxItems": 6
              }
            ]
          },
          "scale": {
            "type": "string",
            "minLength": 1,
            "maxLength": 10000
          },
          "transient": {
            "type": "boolean"
          },
          "multiplier": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      }
    },
    "derived": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "expr"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
          },
          "expr": {
            "type": "string",
            "minLength": 1,
            "maxLength": 10000
          }
        },
        "additionalProperties": false
      }
    },
    "equations": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "type": "string",
        "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
      },
      "additionalProperties": {
        "type": "string",
        "minLength": 1,
        "maxLength": 10000
      }
    },
    "domain": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 10000
      }
    },
    "initial_checks": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 10000
      }
    }
  },
  "additionalProperties": false
}
