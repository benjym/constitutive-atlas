{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://benjym.github.io/constitutive-atlas/schemas/model-v0.2.schema.json",
  "title": "Constitutive Atlas physical-time ODE model v0.2",
  "description": "Physical-time ODE subset. Equations have state/second units. Semantic validation is additionally required; DAE and physical-time residual forms are not yet supported.",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "name",
    "family",
    "description",
    "status",
    "sources",
    "parameters",
    "state",
    "derived",
    "equations",
    "domain",
    "formulation"
  ],
  "properties": {
    "schema_version": {
      "const": "0.2"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "family": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "status": {
      "enum": [
        "draft",
        "transcribed",
        "numerically-tested",
        "reviewed"
      ]
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "url",
          "locator",
          "role"
        ],
        "properties": {
          "url": {
            "type": "string",
            "pattern": "^https?://",
            "description": "Persistent clickable source URL, preferably the original publication DOI or an official author/institutional page. Retain this link in all generated catalogues and browser views.",
            "format": "uri"
          },
          "locator": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "parameters": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "type": "string",
        "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
      },
      "additionalProperties": {
        "type": "object",
        "required": [
          "default",
          "min",
          "max",
          "unit"
        ],
        "properties": {
          "default": {
            "type": "number"
          },
          "min": {
            "type": "number"
          },
          "max": {
            "type": "number"
          },
          "unit": {
            "oneOf": [
              {
                "enum": [
                  "1",
                  "Pa",
                  "s",
                  "K"
                ]
              },
              {
                "type": "object",
                "required": [
                  "si"
                ],
                "properties": {
                  "si": {
                    "type": "array",
                    "minItems": 4,
                    "maxItems": 4,
                    "items": {
                      "oneOf": [
                        {
                          "type": "number",
                          "minimum": -16,
                          "maximum": 16
                        },
                        {
                          "type": "string",
                          "pattern": "^-?[0-9]{1,3}/[1-9][0-9]?$"
                        }
                      ]
                    }
                  }
                },
                "additionalProperties": false
              }
            ]
          },
          "label": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "state": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "name",
          "shape",
          "unit",
          "initial",
          "scale"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
          },
          "shape": {
            "enum": [
              "scalar",
              "sym"
            ]
          },
          "unit": {
            "oneOf": [
              {
                "enum": [
                  "1",
                  "Pa",
                  "s",
                  "K"
                ]
              },
              {
                "type": "object",
                "required": [
                  "si"
                ],
                "properties": {
                  "si": {
                    "type": "array",
                    "minItems": 4,
                    "maxItems": 4,
                    "items": {
                      "oneOf": [
                        {
                          "type": "number",
                          "minimum": -16,
                          "maximum": 16
                        },
                        {
                          "type": "string",
                          "pattern": "^-?[0-9]{1,3}/[1-9][0-9]?$"
                        }
                      ]
                    }
                  }
                },
                "additionalProperties": false
              }
            ]
          },
          "initial": {
            "oneOf": [
              {
                "type": "number"
              },
              {
                "type": "array",
                "items": {
                  "type": "number"
                },
                "minItems": 6,
                "maxItems": 6
              }
            ]
          },
          "scale": {
            "type": "string",
            "minLength": 1,
            "maxLength": 10000
          },
          "transient": {
            "type": "boolean"
          },
          "multiplier": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      }
    },
    "derived": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "expr"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
          },
          "expr": {
            "type": "string",
            "minLength": 1,
            "maxLength": 10000
          }
        },
        "additionalProperties": false
      }
    },
    "equations": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "type": "string",
        "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
      },
      "additionalProperties": {
        "type": "string",
        "minLength": 1,
        "maxLength": 10000
      }
    },
    "domain": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 10000
      }
    },
    "initial_checks": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 10000
      }
    },
    "formulation": {
      "type": "object",
      "required": [
        "time_dependence",
        "equation_form"
      ],
      "properties": {
        "time_dependence": {
          "const": "physical_time"
        },
        "equation_form": {
          "const": "ode"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
