+inline bool recorded_control_correction(std::vector<State> a, State b, State& x) {
+    if(a.empty()||a.front().empty()||a.size()!=b.size()||a.size()<a.front().size())return false;
+    const auto m=a.size(), n=a.front().size();
+    if(m==n)return solve_linear(a,b,x);
+    for(size_t j=0;j<n;++j){
+        double length=0.;
+        for(size_t i=j;i<m;++i)length=std::hypot(length,a[i][j]);
+        if(!std::isfinite(length)||length<1e-14)return false;
+        State v(m-j);
+        for(size_t i=j;i<m;++i)v[i-j]=a[i][j]/length;
+        v[0]+=std::copysign(1.,v[0]);
+        double vv=0.;for(double t:v)vv+=t*t;
+        for(size_t k=j;k<n;++k){
+            double dot=0.;for(size_t i=j;i<m;++i)dot+=v[i-j]*a[i][k];
+            for(size_t i=j;i<m;++i)a[i][k]-=(2.*dot/vv)*v[i-j];
+        }
+        double dot=0.;for(size_t i=j;i<m;++i)dot+=v[i-j]*b[i];
+        for(size_t i=j;i<m;++i)b[i]-=(2.*dot/vv)*v[i-j];
+    }
+    a.resize(n);b.resize(n);
+    return solve_linear(a,b,x);
