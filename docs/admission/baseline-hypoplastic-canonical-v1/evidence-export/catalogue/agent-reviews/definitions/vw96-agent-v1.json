{
  "schema_version": "0.1",
  "status": "transcribed",
  "parameters": {
    "p_ref": {
      "default": 100000,
      "min": 1,
      "max": 10000000000.0,
      "unit": "Pa",
      "label": "Reference stress / numerical scaling"
    },
    "phi": {
      "default": 0.5235987755982988,
      "min": 0.1,
      "max": 1.2,
      "unit": "1",
      "label": "Critical friction angle [rad]"
    },
    "hs": {
      "default": 5800000000.0,
      "min": 1000000.0,
      "max": 1000000000000.0,
      "unit": "Pa",
      "label": "Granular hardness"
    },
    "n": {
      "default": 0.28,
      "min": 0.05,
      "max": 0.9,
      "unit": "1",
      "label": "Pressure dependency exponent"
    },
    "ed0": {
      "default": 0.53,
      "min": 0.01,
      "max": 2,
      "unit": "1",
      "label": "Dense-limit void ratio at zero pressure"
    },
    "ec0": {
      "default": 0.84,
      "min": 0.02,
      "max": 3,
      "unit": "1",
      "label": "Critical-state void ratio at zero pressure"
    },
    "ei0": {
      "default": 1.0,
      "min": 0.03,
      "max": 4,
      "unit": "1",
      "label": "Loose-limit void ratio at zero pressure"
    },
    "alpha": {
      "default": 0.13,
      "min": 0.01,
      "max": 1,
      "unit": "1",
      "label": "Density influence exponent"
    },
    "beta": {
      "default": 1.05,
      "min": 0,
      "max": 5,
      "unit": "1",
      "label": "Stiffness density exponent"
    }
  },
  "state": [
    {
      "name": "sigma",
      "unit": "Pa",
      "initial": [
        100000.0,
        100000.0,
        100000.0,
        0,
        0,
        0
      ],
      "shape": "sym",
      "scale": "p_ref"
    },
    {
      "name": "e",
      "unit": "1",
      "initial": 0.7,
      "shape": "scalar",
      "scale": "1"
    }
  ],
  "derived": [
    {
      "name": "mean",
      "expr": "trace(sigma) / 3"
    },
    {
      "name": "hat",
      "expr": "sigma / trace(sigma)"
    },
    {
      "name": "hsdev",
      "expr": "dev(hat)"
    },
    {
      "name": "j2",
      "expr": "dot(hsdev, hsdev)"
    },
    {
      "name": "tanpsi",
      "expr": "sqrt(3 * j2)"
    },
    {
      "name": "lode",
      "expr": "select(j2 > 1e-24, -sqrt(6) * cube_trace(hsdev) / j2**1.5, 0)"
    },
    {
      "name": "F",
      "expr": "sqrt(tanpsi**2 / 8 + (2 - tanpsi**2) / (2 + sqrt(2) * tanpsi * lode)) - tanpsi / (2 * sqrt(2))"
    },
    {
      "name": "a",
      "expr": "sqrt(3) * (3 - sin(phi)) / (2 * sqrt(2) * sin(phi))"
    },
    {
      "name": "compression",
      "expr": "exp(-(3 * mean / hs)**n)"
    },
    {
      "name": "ed",
      "expr": "ed0 * compression"
    },
    {
      "name": "ec",
      "expr": "ec0 * compression"
    },
    {
      "name": "ei",
      "expr": "ei0 * compression"
    },
    {
      "name": "fd",
      "expr": "((e - ed) / (ec - ed))**alpha"
    },
    {
      "name": "fe",
      "expr": "(ec / e)**beta"
    },
    {
      "name": "fb",
      "expr": "hs / n * (ei0 / ec0)**beta * (1 + ei) / ei * (3 * mean / hs)**(1 - n) / (3 + a**2 - a * sqrt(3) * ((ei0 - ed0) / (ec0 - ed0))**alpha)"
    },
    {
      "name": "factor",
      "expr": "fb * fe / dot(hat,hat)"
    },
    {
      "name": "linear",
      "expr": "factor * (F**2 * de + a**2 * dot(hat,de) * hat)"
    },
    {
      "name": "nonlinear",
      "expr": "-factor * fd * a * F * (hat + hsdev)"
    }
  ],
  "domain": [
    "e > 0",
    "mean > p_ref * 1e-8",
    "ed0 < ec0",
    "ec0 < ei0",
    "e > ed",
    "e < ei",
    "F > 0",
    "fb > 0 * p_ref"
  ],
  "integration": "rate",
  "id": "hypoplastic-sand-vw96",
  "name": "Sand hypoplasticity — von Wolffersdorff (1996)",
  "family": "hypoplasticity",
  "description": "Compression-positive transcription of the von Wolffersdorff stress-rate law. Uses the published Karlsruhe sand parameter example (not Wichtmann calibration). Infinitesimal kinematics; zero spin.",
  "sources": [
    {
      "url": "https://www.uibk.ac.at/de/geotechnik/bodenmechanik/forschung/hypoplasticity-copy-2/",
      "locator": "Wolfgang Fellin, Equations of the Hypoplastic Law (1999-10-01), section 5, visually inspected images 18–26 and Karlsruhe row. Image URLs/hashes: catalogue/source-audits/hypoplastic-sand-vw96-fellin-1999.json. Full original 1996 paper review remains pending.",
      "role": "implementation-author equation summary"
    },
    {
      "url": "https://doi.org/10.1002/(SICI)1099-1484(199607)1:3<251::AID-CFM13>3.0.CO;2-3",
      "locator": "von Wolffersdorff (1996), pp. 251–271",
      "role": "original publication"
    }
  ],
  "equations": {
    "sigma": "linear + nonlinear * norm(de)",
    "e": "-(1 + e) * trace(de)"
  }
}
