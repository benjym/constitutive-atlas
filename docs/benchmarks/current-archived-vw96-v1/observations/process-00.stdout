{"schema_version":"0.1","sha256":"c43016f8f8becb1b9b8fb44be037ee59de09cea9237d026c33f56962025e840c","models":[{"schema_version":"0.1","status":"transcribed","parameters":{"p_ref":{"default":100000,"min":1,"max":10000000000.0,"unit":"Pa","label":"Reference stress / numerical scaling"},"E":{"default":30000000.0,"min":1,"max":1000000000000.0,"unit":"Pa","label":"Young modulus"},"nu":{"default":0.25,"min":-0.99,"max":0.499,"unit":"1","label":"Poisson ratio"},"M":{"default":1.2,"min":0,"max":3,"unit":"1","label":"Friction slope"},"Md":{"default":0.2,"min":0,"max":3,"unit":"1","label":"Dilatancy slope"},"c":{"default":10000,"min":0,"max":1000000000.0,"unit":"Pa","label":"Yield intercept"}},"state":[{"name":"sigma","unit":"Pa","initial":[100000.0,100000.0,100000.0,0,0,0],"shape":"sym","scale":"p_ref"},{"name":"e","unit":"1","initial":0.7,"shape":"scalar","scale":"1"},{"name":"gamma","unit":"1","initial":0,"shape":"scalar","scale":"1","transient":true,"multiplier":true}],"derived":[{"name":"K","expr":"E / (3 * (1 - 2 * nu))"},{"name":"G","expr":"E / (2 * (1 + nu))"},{"name":"mean","expr":"trace(sigma) / 3"},{"name":"q","expr":"sqrt(1.5 * dot(dev(sigma), dev(sigma)))"},{"name":"direction_q","expr":"max(q, p_ref * 1e-12)"},{"name":"yield_scaled","expr":"(q - M * mean - c) / p_ref"}],"domain":["e > 0","gamma > -1e-9"],"integration":"residual","id":"drucker-prager","name":"Drucker\u2013Prager, nonassociated perfect plasticity","family":"elastoplasticity","description":"Smooth Drucker\u2013Prager cone f=q-M p-c with separate dilatancy slope Md. Backward Euler; q direction regularized at 1e-12 p_ref. No tensile cap.","sources":[{"url":"https://opensees.github.io/OpenSeesDocumentation/user/manual/material/ndMaterials/DruckerPrager.html","locator":"Drucker\u2013Prager yield and flow conventions; this entry is the explicitly stated perfect-plastic specialization","role":"formulation"}],"equations":{"sigma":"sigma - sigma_n - K * trace(de) * I - 2 * G * dev(de) + gamma * (3 * G * dev(sigma) / direction_q - K * Md * I)","e":"e - (1 + e_n) * exp(-trace(de)) + 1","gamma":"sqrt(gamma**2 + yield_scaled**2) - gamma + yield_scaled"},"initial_checks":["yield_scaled <= 1e-8"]},{"schema_version":"0.1","status":"draft","parameters":{"p_ref":{"default":100000,"min":1,"max":10000000000.0,"unit":"Pa","label":"Reference stress / numerical scaling"},"phi":{"default":0.5235987755982988,"min":0.1,"max":1.2,"unit":"1","label":"Critical friction angle [rad]"},"hs":{"default":5800000000.0,"min":1000000.0,"max":1000000000000.0,"unit":"Pa","label":"Granular hardness"},"n":{"default":0.28,"min":0.05,"max":0.9,"unit":"1","label":""},"ed0":{"default":0.53,"min":0.01,"max":2,"unit":"1","label":""},"ec0":{"default":0.84,"min":0.02,"max":3,"unit":"1","label":""},"ei0":{"default":1.0,"min":0.03,"max":4,"unit":"1","label":""},"alpha":{"default":0.13,"min":0.01,"max":1,"unit":"1","label":""},"beta":{"default":1.05,"min":0,"max":5,"unit":"1","label":""},"R":{"default":0.0001,"min":1e-07,"max":0.01,"unit":"1","label":""},"mR":{"default":5,"min":1,"max":30,"unit":"1","label":""},"mT":{"default":2,"min":1,"max":30,"unit":"1","label":""},"beta_r":{"default":0.5,"min":0.05,"max":5,"unit":"1","label":""},"chi":{"default":6,"min":0.1,"max":20,"unit":"1","label":""}},"state":[{"name":"sigma","unit":"Pa","initial":[100000.0,100000.0,100000.0,0,0,0],"shape":"sym","scale":"p_ref"},{"name":"e","unit":"1","initial":0.7,"shape":"scalar","scale":"1"},{"name":"h","unit":"1","initial":[0,0,0,0,0,0],"shape":"sym","scale":"R"}],"derived":[{"name":"mean","expr":"trace(sigma) / 3"},{"name":"hat","expr":"sigma / trace(sigma)"},{"name":"hsdev","expr":"dev(hat)"},{"name":"j2","expr":"dot(hsdev, hsdev)"},{"name":"tanpsi","expr":"sqrt(3 * j2)"},{"name":"lode","expr":"select(j2 > 1e-24, -sqrt(6) * cube_trace(hsdev) / j2**1.5, 0)"},{"name":"F","expr":"sqrt(tanpsi**2 / 8 + (2 - tanpsi**2) / (2 + sqrt(2) * tanpsi * lode)) - tanpsi / (2 * sqrt(2))"},{"name":"a","expr":"sqrt(3) * (3 - sin(phi)) / (2 * sqrt(2) * sin(phi))"},{"name":"compression","expr":"exp(-(3 * mean / hs)**n)"},{"name":"ed","expr":"ed0 * compression"},{"name":"ec","expr":"ec0 * compression"},{"name":"ei","expr":"ei0 * compression"},{"name":"fd","expr":"((e - ed) / (ec - ed))**alpha"},{"name":"fe","expr":"(ec / e)**beta"},{"name":"fb","expr":"hs / n * (ei0 / ec0)**beta * (1 + ei) / ei * (3 * mean / hs)**(1 - n) / (3 + a**2 - a * sqrt(3) * ((ei0 - ed0) / (ec0 - ed0))**alpha)"},{"name":"factor","expr":"fb * fe / dot(hat,hat)"},{"name":"linear","expr":"factor * (F**2 * de + a**2 * dot(hat,de) * hat)"},{"name":"nonlinear","expr":"-factor * fd * a * F * (hat + hsdev)"},{"name":"hn","expr":"norm(h)"},{"name":"eta","expr":"select(hn > 0, h / hn, 0 * I)"},{"name":"rho","expr":"min(hn / R, 1)"},{"name":"projection","expr":"dot(eta,de)"},{"name":"linear_eta","expr":"factor * (F**2 * eta + a**2 * dot(hat,eta) * hat)"},{"name":"overlay","expr":"rho**chi * mT + (1 - rho**chi) * mR"}],"domain":["e > 0","mean > p_ref * 1e-8","ed0 < ec0","ec0 < ei0","e > ed","e < ei","F > 0","fb > 0 * p_ref","hn < R * 1.01","mR >= mT"],"integration":"rate","id":"hypoplastic-sand-igs97","name":"Sand hypoplasticity + intergranular strain (1997)","family":"hypoplasticity","description":"Draft IGS overlay on the von Wolffersdorff base law; compression-positive h and strain. Equation transcription requires independent review before scientific use.","sources":[{"url":"https://www.uibk.ac.at/de/geotechnik/bodenmechanik/forschung/hypoplasticity-copy-2/","locator":"Equations of the Hypoplastic Law, section 5, images 18\u201326; Karlsruhe parameter row","role":"equation transcription"},{"url":"https://doi.org/10.1002/(SICI)1099-1484(199607)1:3<251::AID-CFM13>3.0.CO;2-3","locator":"von Wolffersdorff (1996), pp. 251\u2013271","role":"original publication"},{"url":"https://doi.org/10.1002/(SICI)1099-1484(199710)2:4<279::AID-CFM29>3.0.CO;2-8","locator":"Niemunis & Herle (1997), hypoplastic model for cohesionless soils with elastic strain range; IGS evolution and stiffness overlay","role":"original publication; independent transcription review pending"},{"url":"https://www.numgeo.de/wp-content/uploads/2023/08/numgeo_keyword_manual.pdf","locator":"Section 7.4.1.1, equations 7.74\u20137.82; overlay only, without optional numgeo modifications","role":"implementation-author equation cross-check"}],"equations":{"sigma":"overlay * linear + select(projection > 0, rho**chi * ((1 - mT) * linear_eta + nonlinear) * projection, rho**chi * (mR - mT) * linear_eta * projection)","e":"-(1 + e) * trace(de)","h":"de - select(projection > 0, rho**beta_r * eta * projection, 0 * I)"}},{"schema_version":"0.1","status":"transcribed","parameters":{"p_ref":{"default":100000,"min":1,"max":10000000000.0,"unit":"Pa","label":"Reference stress / numerical scaling"},"phi":{"default":0.5235987755982988,"min":0.1,"max":1.2,"unit":"1","label":"Critical friction angle [rad]"},"hs":{"default":5800000000.0,"min":1000000.0,"max":1000000000000.0,"unit":"Pa","label":"Granular hardness"},"n":{"default":0.28,"min":0.05,"max":0.9,"unit":"1","label":""},"ed0":{"default":0.53,"min":0.01,"max":2,"unit":"1","label":""},"ec0":{"default":0.84,"min":0.02,"max":3,"unit":"1","label":""},"ei0":{"default":1.0,"min":0.03,"max":4,"unit":"1","label":""},"alpha":{"default":0.13,"min":0.01,"max":1,"unit":"1","label":""},"beta":{"default":1.05,"min":0,"max":5,"unit":"1","label":""}},"state":[{"name":"sigma","unit":"Pa","initial":[100000.0,100000.0,100000.0,0,0,0],"shape":"sym","scale":"p_ref"},{"name":"e","unit":"1","initial":0.7,"shape":"scalar","scale":"1"}],"derived":[{"name":"mean","expr":"trace(sigma) / 3"},{"name":"hat","expr":"sigma / trace(sigma)"},{"name":"hsdev","expr":"dev(hat)"},{"name":"j2","expr":"dot(hsdev, hsdev)"},{"name":"tanpsi","expr":"sqrt(3 * j2)"},{"name":"lode","expr":"select(j2 > 1e-24, -sqrt(6) * cube_trace(hsdev) / j2**1.5, 0)"},{"name":"F","expr":"sqrt(tanpsi**2 / 8 + (2 - tanpsi**2) / (2 + sqrt(2) * tanpsi * lode)) - tanpsi / (2 * sqrt(2))"},{"name":"a","expr":"sqrt(3) * (3 - sin(phi)) / (2 * sqrt(2) * sin(phi))"},{"name":"compression","expr":"exp(-(3 * mean / hs)**n)"},{"name":"ed","expr":"ed0 * compression"},{"name":"ec","expr":"ec0 * compression"},{"name":"ei","expr":"ei0 * compression"},{"name":"fd","expr":"((e - ed) / (ec - ed))**alpha"},{"name":"fe","expr":"(ec / e)**beta"},{"name":"fb","expr":"hs / n * (ei0 / ec0)**beta * (1 + ei) / ei * (3 * mean / hs)**(1 - n) / (3 + a**2 - a * sqrt(3) * ((ei0 - ed0) / (ec0 - ed0))**alpha)"},{"name":"factor","expr":"fb * fe / dot(hat,hat)"},{"name":"linear","expr":"factor * (F**2 * de + a**2 * dot(hat,de) * hat)"},{"name":"nonlinear","expr":"-factor * fd * a * F * (hat + hsdev)"}],"domain":["e > 0","mean > p_ref * 1e-8","ed0 < ec0","ec0 < ei0","e > ed","e < ei","F > 0","fb > 0 * p_ref"],"integration":"rate","id":"hypoplastic-sand-vw96","name":"Sand hypoplasticity \u2014 von Wolffersdorff (1996)","family":"hypoplasticity","description":"Compression-positive transcription of the von Wolffersdorff stress-rate law. Uses the published Karlsruhe sand parameter example (not Wichtmann calibration). Infinitesimal kinematics; zero spin.","sources":[{"url":"https://www.uibk.ac.at/de/geotechnik/bodenmechanik/forschung/hypoplasticity-copy-2/","locator":"Equations of the Hypoplastic Law, section 5, images 18\u201326; Karlsruhe parameter row","role":"equation transcription"},{"url":"https://doi.org/10.1002/(SICI)1099-1484(199607)1:3<251::AID-CFM13>3.0.CO;2-3","locator":"von Wolffersdorff (1996), pp. 251\u2013271","role":"original publication"}],"equations":{"sigma":"linear + nonlinear * norm(de)","e":"-(1 + e) * trace(de)"}},{"schema_version":"0.1","status":"transcribed","parameters":{"p_ref":{"default":100000,"min":1,"max":10000000000.0,"unit":"Pa","label":"Reference stress / numerical scaling"},"E":{"default":30000000.0,"min":1,"max":1000000000000.0,"unit":"Pa","label":"Young modulus"},"nu":{"default":0.25,"min":-0.99,"max":0.499,"unit":"1","label":"Poisson ratio"}},"state":[{"name":"sigma","unit":"Pa","initial":[100000.0,100000.0,100000.0,0,0,0],"shape":"sym","scale":"p_ref"},{"name":"e","unit":"1","initial":0.7,"shape":"scalar","scale":"1"}],"derived":[{"name":"K","expr":"E / (3 * (1 - 2 * nu))"},{"name":"G","expr":"E / (2 * (1 + nu))"}],"domain":["e > 0"],"integration":"residual","id":"linear-elastic","name":"Linear isotropic elasticity","family":"elasticity","description":"Infinitesimal isotropic elasticity. Demonstration parameters, not calibrated to a soil.","sources":[{"url":"https://github.com/ufz/ogs/blob/b5d0f115c75ee74a7cdbfad533625a550a416fda/MaterialLib/SolidModels/LinearElasticIsotropic.h","locator":"MaterialProperties::lambda, mu, bulk_modulus; elasticTangentStiffness","role":"Pinned reference formulation"},{"url":"https://github.com/ufz/ogs/blob/b5d0f115c75ee74a7cdbfad533625a550a416fda/MaterialLib/SolidModels/LinearElasticIsotropic.cpp","locator":"LinearElasticIsotropic::integrateStress; sigma_prev + C * (eps_m - eps_m_prev)","role":"Pinned incremental stress update"},{"url":"https://github.com/benjym/constitutive-atlas/blob/main/docs/models/linear-elastic.md","locator":"Equation mapping; project-specific void-ratio bookkeeping and small-strain limits","role":"Transcription dossier"}],"equations":{"sigma":"sigma - sigma_n - K * trace(de) * I - 2 * G * dev(de)","e":"e - (1 + e_n) * exp(-trace(de)) + 1"}},{"schema_version":"0.1","status":"transcribed","parameters":{"p_ref":{"default":100000,"min":1,"max":10000000000.0,"unit":"Pa","label":"Reference stress / numerical scaling"},"M":{"default":1.2,"min":0.1,"max":3,"unit":"1","label":"Critical-state slope"},"lambda_c":{"default":0.2,"min":0.001,"max":1,"unit":"1","label":"Virgin compression index"},"kappa":{"default":0.04,"min":0.0001,"max":0.5,"unit":"1","label":"Swelling index"},"nu":{"default":0.25,"min":-0.9,"max":0.49,"unit":"1","label":"Poisson ratio"}},"state":[{"name":"sigma","unit":"Pa","initial":[100000.0,100000.0,100000.0,0,0,0],"shape":"sym","scale":"p_ref"},{"name":"e","unit":"1","initial":0.7,"shape":"scalar","scale":"1"},{"name":"pc","unit":"Pa","initial":200000,"shape":"scalar","scale":"p_ref"},{"name":"gamma","unit":"1","initial":0,"shape":"scalar","scale":"1","transient":true,"multiplier":true}],"derived":[{"name":"mean","expr":"trace(sigma) / 3"},{"name":"q2","expr":"1.5 * dot(dev(sigma),dev(sigma))"},{"name":"K","expr":"(1 + e) * mean / kappa"},{"name":"G","expr":"3 * K * (1 - 2 * nu) / (2 * (1 + nu))"},{"name":"yield_scaled","expr":"(q2 + M**2 * mean * (mean - pc)) / p_ref**2"},{"name":"plastic_volume","expr":"gamma * M**2 * (2 * mean - pc) / pc_n"}],"domain":["e > 0","lambda_c > kappa","mean > p_ref * 1e-8","pc > p_ref * 1e-8","gamma > -1e-9"],"integration":"residual","id":"modified-cam-clay","name":"Modified Cam Clay","family":"critical-state plasticity","description":"Associated Modified Cam Clay with pressure/void-ratio dependent elasticity, exponential hardening, and backward-Euler integration. Demonstration parameters; finite rotation is unsupported.","sources":[{"url":"https://www.opengeosys.org/docs/benchmarks/small-deformations/modifiedcamclay/ModifiedCamClay_report.pdf","locator":"Model equations and incremental formulation; use repository equations for the precise integration convention","role":"formulation"}],"equations":{"sigma":"sigma - sigma_n - K * trace(de) * I - 2 * G * dev(de) + gamma * (6 * G * dev(sigma) / pc_n + K * M**2 * (2 * mean - pc) / pc_n * I)","e":"e - (1 + e_n) * exp(-trace(de)) + 1","pc":"pc - pc_n * exp((1 + e) * plastic_volume / (lambda_c - kappa))","gamma":"sqrt(gamma**2 + yield_scaled**2) - gamma + yield_scaled"},"initial_checks":["yield_scaled <= 1e-8"]}]}
