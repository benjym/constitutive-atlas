{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Normalized material-point experiment",
  "type": "object",
  "required": [
    "schema_version",
    "kind",
    "id",
    "material",
    "protocol",
    "conventions",
    "provenance",
    "initial",
    "rows"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "kind": {
      "const": "experiment"
    },
    "id": {
      "type": "string"
    },
    "material": {
      "type": "string"
    },
    "protocol": {
      "type": "string"
    },
    "conventions": {
      "type": "object",
      "required": [
        "stress",
        "strain",
        "stress_unit",
        "strain_unit"
      ],
      "properties": {
        "stress": {
          "const": "compression-positive"
        },
        "strain": {
          "const": "compression-positive"
        },
        "stress_unit": {
          "const": "Pa"
        },
        "strain_unit": {
          "const": "1"
        }
      },
      "additionalProperties": false
    },
    "provenance": {
      "type": "object",
      "required": [
        "source_url",
        "member_sha256",
        "archive_sha256"
      ],
      "properties": {
        "source_url": {
          "type": "string"
        },
        "member_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "archive_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "initial": {
      "type": "object"
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "rows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "axial_strain",
          "q"
        ],
        "properties": {
          "axial_strain": {
            "type": "number"
          },
          "volumetric_strain": {
            "type": "number"
          },
          "radial_strain": {
            "type": "number"
          },
          "void_ratio": {
            "type": "number"
          },
          "q": {
            "type": "number"
          },
          "p": {
            "type": "number"
          },
          "pore_pressure": {
            "type": "number"
          },
          "pore_pressure_absolute": {
            "type": "number"
          },
          "radial_effective_stress": {
            "type": "number"
          },
          "axial_effective_stress": {
            "type": "number"
          },
          "elapsed_time": {
            "type": "number"
          },
          "axial_displacement": {
            "type": "number"
          },
          "axial_force": {
            "type": "number"
          },
          "cell_pressure": {
            "type": "number"
          },
          "cross_sectional_area": {
            "type": "number"
          },
          "total_axial_stress": {
            "type": "number"
          },
          "volume_change": {
            "type": "number"
          },
          "axial_reported_stress": {
            "type": "number"
          },
          "radial_reported_stress": {
            "type": "number"
          }
        },
        "additionalProperties": false
      }
    },
    "source_table": {
      "type": "object",
      "description": "Native worksheet observations with original row numbers, headers and units; not browser plot channels."
    }
  },
  "additionalProperties": false
}
