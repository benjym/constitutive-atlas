+            wanted=[x for f in m['state'] for x in (expected[f['name']].v if isinstance(expected[f['name']],Sym) else [expected[f['name']]])]
+            for a,b in zip(wanted,result['values']):self.assertAlmostEqual(a,b,delta=1e-9*max(1,abs(a)))
+
+
