    "norm(B) <= 1e280",
    "Bnorm > 0",
    "abs(Bnorm) <= 1e280",
    "norm(sigma_unit) <= 1e280",
    "norm(Caux) <= 1e280/p_scale",
    "abs(G) <= 1e280/p_scale",
    "abs(ratio) <= 1e280",
    "abs(asbs_den) <= 1e280/p_scale",
    "abs(asbs_t) <= p_scale*1e280",
    "norm(asbs_vector) <= 1e280",
    "asbs_norm > 0",
    "abs(asbs_norm) <= 1e280",
    "fdAstar > 0",
    "abs(fdAstar) <= 1e280",
    "norm(m) <= 1e280",
    "C > 0",
    "abs(C) <= 1e280",
    "S > 0",
    "abs(S) <= 1e280",
    "norm(f) <= 1e280",
    "abs(hn) <= 1e280",
    "norm(hdir) <= 1e280",
    "abs(rho) <= 1e280",
    "abs(dn) <= 1e280",
    "abs(h_loading) <= 1e280",
    "norm(h_rhs) <= 1e280",
    "abs(chi) <= 1e280",
    "abs(gamma) <= 1e280",
    "abs(Omega_rhs) <= 1e280",
    "abs(q) <= 1e280",
    "k > 0",
    "abs(k) <= 1e280",
    "abs(suppression) <= 1e280",
    "norm(effective_de) <= 1e280",
    "norm(E_effective_de) <= p_scale*1e280",
    "norm(sigma_rhs) <= p_scale*1e280",
    "abs(h_absolute_components) <= 1e280",
    "abs(de_absolute_components) <= 1e280"
  ],
  "formulation": {
