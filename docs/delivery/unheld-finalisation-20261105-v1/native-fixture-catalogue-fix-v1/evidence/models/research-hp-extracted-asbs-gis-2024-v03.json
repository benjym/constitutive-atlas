    "p > 0*p_scale",
    "abs(p) <= p_scale*1e280",
    "norm(H) <= 1e280",
    "norm(Hdev) <= 1e280",
    "Q > 0",
    "abs(Q) <= 1e280",
    "abs(j2) <= 1e280",
    "abs(tanpsi) <= 1e280",
    "abs(cos3theta) <= 1e280",
    "Fden > 0",
    "abs(Fden) <= 1e280",
    "Frad > 0",
