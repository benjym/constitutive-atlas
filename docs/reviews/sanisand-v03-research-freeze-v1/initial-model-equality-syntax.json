{
  "schema_version": "0.3",
  "id": "research-sanisand-2004-fixed-memory-be-v03",
  "name": "SANISAND-2004 project fixed-memory BE — v0.3 research candidate",
  "family": "bounding-surface plasticity research",
  "status": "draft",
  "description": "Original continuous law with explicitly named project fixed-memory backward-Euler finite-product discretization. Effective Cauchy stress, fixed-frame small-strain compression-positive Mandel. Explicit sigma/e/alpha/fabric/alpha_in preparation; gamma is a temporary rescaled multiplier, not accumulated plastic strain. Restricted initial monotonic research scope; no canonical reversal, scientific admission, experimental calibration or public-host qualification. New initial guard rejects unsupported on-direction zero-distance nonpositive-hardening states; existing legacy definitions and evidence are preserved.",
  "parameters": {
    "G0": {
      "default": 125.0,
      "min": 1,
      "max": 1000,
      "unit": "1"
    },
    "nu": {
      "default": 0.05,
      "min": 0,
      "max": 0.49,
      "unit": "1"
    },
    "M": {
      "default": 1.25,
      "min": 0.1,
      "max": 3,
      "unit": "1"
    },
    "c": {
      "default": 0.712,
      "min": 0.1,
      "max": 1,
      "unit": "1"
    },
    "lambda_c": {
      "default": 0.019,
      "min": 0,
      "max": 0.2,
      "unit": "1"
    },
    "e0": {
      "default": 0.934,
      "min": 0.1,
      "max": 2,
      "unit": "1"
    },
    "xi": {
      "default": 0.7,
      "min": 0.1,
      "max": 2,
      "unit": "1"
    },
    "m": {
      "default": 0.01,
      "min": 0.001,
      "max": 0.1,
      "unit": "1"
    },
    "h0": {
      "default": 7.05,
      "min": 0.01,
      "max": 100,
      "unit": "1"
    },
    "ch": {
      "default": 0.968,
      "min": 0,
      "max": 2,
      "unit": "1"
    },
    "nb": {
      "default": 1.1,
      "min": 0,
      "max": 10,
      "unit": "1"
    },
    "A0": {
      "default": 0.704,
      "min": 0,
      "max": 10,
      "unit": "1"
    },
    "nd": {
      "default": 3.5,
      "min": 0,
      "max": 10,
      "unit": "1"
    },
    "zmax": {
      "default": 4.0,
      "min": 0,
      "max": 20,
      "unit": "1"
    },
    "cz": {
      "default": 600.0,
      "min": 0,
      "max": 2000,
      "unit": "1"
    },
    "p_at": {
      "default": 100000.0,
      "min": 1,
      "max": 10000000000.0,
      "unit": "Pa"
    }
  },
  "state": [
    {
      "name": "sigma",
      "shape": "sym",
      "unit": "Pa",
      "scale": "p_at",
      "initial": [
        100000.0,
        100000.0,
        100000.0,
        0,
        0,
        0
      ],
      "semantics": {
        "role": "persistent",
        "quantity": "cauchy_stress",
        "transformation": "symmetric_spatial_tensor"
      }
    },
    {
      "name": "e",
      "shape": "scalar",
      "unit": "1",
      "scale": "1",
      "initial": 0.7,
      "semantics": {
        "role": "persistent",
        "quantity": "void_ratio",
        "transformation": "scalar_invariant"
      }
    },
    {
      "name": "alpha",
      "shape": "sym",
      "unit": "1",
      "scale": "1",
      "initial": [
        0,
        0,
        0,
        0,
        0,
        0
      ],
      "semantics": {
        "role": "persistent",
        "quantity": "deviatoric_backstress_ratio",
        "transformation": "symmetric_spatial_tensor"
      }
    },
    {
      "name": "fabric",
      "shape": "sym",
      "unit": "1",
      "scale": "1",
      "initial": [
        0,
        0,
        0,
        0,
        0,
        0
      ],
      "semantics": {
        "role": "persistent",
        "quantity": "fabric_dilatancy_tensor",
        "transformation": "symmetric_spatial_tensor"
      }
    },
    {
      "name": "alpha_in",
      "shape": "sym",
      "unit": "1",
      "scale": "1",
      "initial": [
        0,
        0,
        0,
        0,
        0,
        0
      ],
      "semantics": {
        "role": "persistent",
        "quantity": "loading_process_initial_backstress_ratio",
        "transformation": "symmetric_spatial_tensor"
      }
    },
    {
      "name": "gamma",
      "shape": "scalar",
      "unit": "1",
      "scale": "1",
      "initial": 0,
      "semantics": {
        "role": "plastic_multiplier",
        "quantity": "incremental_plastic_multiplier_times_endpoint_hardening_coefficient",
        "transformation": "scalar_invariant"
      }
    }
  ],
  "derived": [
    {
      "name": "p",
      "expr": "trace(sigma)/3"
    },
    {
      "name": "s",
      "expr": "dev(sigma)"
    },
    {
      "name": "r",
      "expr": "s/p"
    },
    {
      "name": "yield_value",
      "expr": "norm(s-p*alpha)-sqrt(2/3)*p*m"
    },
    {
      "name": "relative_norm",
      "expr": "norm(r-alpha)"
    },
    {
      "name": "n",
      "expr": "select(relative_norm > 0, (r-alpha) / relative_norm, 0 * I)"
    },
    {
      "name": "G",
      "expr": "G0*p_at*(2.97-e)**2/(1+e)*(p/p_at)**(1/2)"
    },
    {
      "name": "K",
      "expr": "2*(1+nu)/(3*(1-2*nu))*G"
    },
    {
      "name": "ec",
      "expr": "e0-lambda_c*(p/p_at)**xi"
    },
    {
      "name": "psi",
      "expr": "e-ec"
    },
    {
      "name": "cos3theta",
      "expr": "sqrt(6)*cube_trace(n)"
    },
    {
      "name": "g",
      "expr": "2*c/((1+c)-(1-c)*cos3theta)"
    },
    {
      "name": "alpha_b",
      "expr": "sqrt(2/3)*(g*M*exp(-nb*psi)-m)*n"
    },
    {
      "name": "alpha_d",
      "expr": "sqrt(2/3)*(g*M*exp(nd*psi)-m)*n"
    },
    {
      "name": "B",
      "expr": "1+(3/2)*(1-c)/c*g*cos3theta"
    },
    {
      "name": "C",
      "expr": "3*sqrt(3/2)*(1-c)/c*g"
    },
    {
      "name": "Rdev",
      "expr": "dev(B*n-C*tensor_square(n))"
    },
    {
      "name": "b0",
      "expr": "G0*h0*(1-ch*e)*(p/p_at)**(-1/2)"
    },
    {
      "name": "hardening_distance",
      "expr": "dot(alpha-alpha_in,n)"
    },
    {
      "name": "Ad",
      "expr": "A0*(1+max(dot(fabric,n),0))"
    },
    {
      "name": "D",
      "expr": "Ad*dot(alpha_d-alpha,n)"
    },
    {
      "name": "R",
      "expr": "Rdev+D*I/3"
    },
    {
      "name": "plastic_multiplier",
      "expr": "gamma * hardening_distance / b0"
    },
    {
      "name": "cone_scaled",
      "expr": "yield_value / p_at"
    }
  ],
  "domain": [
    "p > 0 * p_at",
    "e > 0",
    "e < 2.97",
    "1 - ch * e > 0",
    "hardening_distance >= 0",
    "gamma >= 0",
    "abs(trace(alpha)) <= 1e-12",
    "abs(trace(fabric)) <= 1e-12",
    "abs(trace(alpha_in)) <= 1e-12"
  ],
  "initial_checks": [
    "yield_value / p_at <= 1e-8",
    "select(relative_norm > 0, select(hardening_distance == 0, dot(alpha_b-alpha,n) > 0, 1 > 0), 1 > 0)"
  ],
  "sources": [
    {
      "url": "https://doi.org/10.1061/%28ASCE%290733-9399%282004%29130%3A6%28622%29",
      "role": "original continuous formulation",
      "locator": "Dafalias and Manzari (2004), Eqs. (3), (13)-(27); current e elasticity; normalized off-cone extension and finite discretization are project choices."
    },
    {
      "url": "https://github.com/benjym/constitutive-atlas/blob/main/docs/models/sanisand-2004-fixed-memory-be.md",
      "role": "project discretization and scope",
      "locator": "Research backward-Euler products and gamma complementarity; fixed initial memory; not a complete original-model admission."
    }
  ],
  "equations": {
    "sigma": "sigma - sigma_n - 2*G*dev(de) - K*trace(de)*I + plastic_multiplier*(2*G*Rdev+K*D*I)",
    "e": "e - (1+e_n)*exp(-trace(de)) + 1",
    "alpha": "alpha-alpha_n-(2/3)*gamma*(alpha_b-alpha)",
    "fabric": "fabric-fabric_n+cz*max(-plastic_multiplier*D,0)*(zmax*n+fabric)",
    "alpha_in": "alpha_in-alpha_in_n",
    "gamma": "sqrt(gamma**2+cone_scaled**2)-gamma+cone_scaled"
  },
  "formulation": {
    "time_dependence": "strain_path",
    "equation_form": "incremental_residual",
    "kinematics": "small_strain_3d",
    "frame": "fixed_spatial",
    "objective_rate": "none",
    "tensor_representation": "mandel",
    "stress_sign": "compression_positive",
    "strain_sign": "compression_positive",
    "inputs": {
      "equation": {
        "de": {
          "quantity": "strain_increment",
          "measure": "infinitesimal_strain",
          "shape": "sym",
          "unit": "1",
          "configuration": "current",
          "sampling": "increment",
          "constraint": "finite"
        }
      },
      "advance": {}
    },
    "stress": {
      "source": "state",
      "name": "sigma",
      "measure": "cauchy",
      "scope": "effective"
    }
  },
  "initialization": {
    "method": "explicit_state",
    "default_policy": "examples_only",
    "required_state": [
      "sigma",
      "e",
      "alpha",
      "fabric",
      "alpha_in"
    ],
    "validation": "domain_and_initial_checks"
  }
}
