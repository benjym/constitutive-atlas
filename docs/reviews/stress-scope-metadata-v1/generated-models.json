  "models": [
    {
      "schema_version": "0.3",
      "status": "draft",
      "id": "scope-clock",
      "name": "Synthetic nonautonomous clock verification fixture",
      "family": "engine verification only",
      "description": "Scalar ODE with a known quadratic solution; no stress-first state requirement.",
      "sources": [
        {
          "url": "https://github.com/benjym/constitutive-atlas/blob/main/docs/TEMPORAL_INTEGRATION.md",
          "role": "analytical verification specification",
          "locator": "Maxwell deviatoric law; not Terracotta"
        }
      ],
      "formulation": {
        "time_dependence": "physical_time",
        "equation_form": "ode",
        "kinematics": "small_strain_3d",
        "frame": "fixed_spatial",
        "objective_rate": "none",
        "tensor_representation": "mandel",
        "stress_sign": "compression_positive",
        "strain_sign": "compression_positive",
        "stress": {
          "source": "none"
        },
        "inputs": {
          "equation": {
            "time": {
              "quantity": "time",
              "shape": "scalar",
              "unit": "s",
              "sampling": "stage",
              "constraint": "finite"
            },
            "strain_rate": {
              "quantity": "strain_rate",
              "measure": "infinitesimal_strain_rate",
              "shape": "sym",
              "unit": {
                "si": [
                  0,
                  0,
                  -1,
                  0
                ]
              },
              "configuration": "current",
              "sampling": "stage",
              "constraint": "finite"
            }
          },
          "advance": {
            "start_time": {
              "quantity": "time",
              "shape": "scalar",
              "unit": "s",
              "sampling": "start",
              "constraint": "finite"
            },
            "duration": {
              "quantity": "duration",
              "shape": "scalar",
              "unit": "s",
              "sampling": "interval",
              "constraint": "positive_finite"
            }
          }
        }
      },
      "parameters": {
        "tau": {
          "default": 2,
          "min": 1e-06,
          "max": 1000000.0,
          "unit": "s"
        },
        "time_limit": {
          "default": 1000000000.0,
          "min": 0.001,
          "max": 1000000000000.0,
          "unit": "s"
        }
      },
      "state": [
        {
          "name": "x",
          "shape": "scalar",
          "unit": "1",
          "scale": "1",
          "initial": 0,
          "semantics": {
            "role": "persistent",
            "quantity": "unspecified",
            "transformation": "fixed_components"
          }
        }
      ],
      "derived": [],
      "equations": {
        "x": "time / tau**2"
      },
      "domain": [
        "time < time_limit"
      ],
      "initialization": {
        "method": "explicit_state",
        "default_policy": "examples_only",
        "required_state": [
          "x"
        ],
        "validation": "domain_and_initial_checks"
      }
    },
    {
      "schema_version": "0.3",
      "status": "draft",
      "id": "scope-effective-timed",
