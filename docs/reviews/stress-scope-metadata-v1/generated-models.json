        "strain_sign": "compression_positive",
        "stress": {
          "source": "observable",
          "name": "stress",
          "measure": "cauchy",
          "scope": "effective"
        },
        "inputs": {
          "equation": {
            "time": {
              "quantity": "time",
              "shape": "scalar",
              "unit": "s",
              "sampling": "stage",
              "constraint": "finite"
            },
            "strain_rate": {
              "quantity": "strain_rate",
              "measure": "infinitesimal_strain_rate",
              "shape": "sym",
              "unit": {
                "si": [
                  0,
                  0,
                  -1,
                  0
                ]
              },
              "configuration": "current",
              "sampling": "stage",
              "constraint": "finite"
            }
          },
          "advance": {
            "start_time": {
              "quantity": "time",
              "shape": "scalar",
              "unit": "s",
              "sampling": "start",
              "constraint": "finite"
            },
            "duration": {
              "quantity": "duration",
              "shape": "scalar",
              "unit": "s",
              "sampling": "interval",
              "constraint": "positive_finite"
            }
          }
        }
      },
      "parameters": {
        "Kmod": {
          "default": 20000000.0,
          "min": 1,
          "max": 1000000000000.0,
          "unit": "Pa"
        },
        "Gmod": {
          "default": 12000000.0,
          "min": 1,
          "max": 1000000000000.0,
          "unit": "Pa"
        },
        "tau": {
          "default": 2,
          "min": 1e-06,
          "max": 1000000.0,
          "unit": "s"
        },
        "time_limit": {
          "default": 1000000000.0,
          "min": 0.001,
          "max": 1000000000000.0,
          "unit": "s"
        }
      },
      "state": [
        {
          "name": "sigma",
          "shape": "sym",
          "unit": "Pa",
          "scale": "Kmod",
          "initial": [
            140000,
            80000,
            80000,
            0,
            0,
            0
          ],
          "semantics": {
            "role": "persistent",
            "quantity": "unspecified",
            "transformation": "fixed_components"
          }
        }
      ],
      "derived": [],
      "equations": {
        "sigma": "Kmod * trace(strain_rate) * I + 2 * Gmod * dev(strain_rate) - dev(sigma) / tau"
      },
      "domain": [
        "time < time_limit"
      ],
      "observables": [
        {
          "name": "stress",
          "shape": "sym",
          "unit": "Pa",
          "scale": "Kmod",
          "expr": "sigma"
        }
      ],
      "initialization": {
        "method": "explicit_state",
        "default_policy": "examples_only",
        "required_state": [
          "sigma"
        ],
        "validation": "domain_and_initial_checks"
      }
    },
    {
      "schema_version": "0.3",
      "status": "transcribed",
      "parameters": {
        "p_ref": {
          "default": 100000,
          "min": 1,
          "max": 10000000000.0,
          "unit": "Pa",
          "label": "Reference stress / numerical scaling"
        },
        "E": {
          "default": 30000000.0,
          "min": 1,
          "max": 1000000000000.0,
          "unit": "Pa",
          "label": "Young modulus"
        },
        "nu": {
          "default": 0.25,
          "min": -0.99,
          "max": 0.499,
          "unit": "1",
          "label": "Poisson ratio"
        }
      },
      "state": [
        {
          "name": "sigma",
          "unit": "Pa",
          "initial": [
            100000.0,
            100000.0,
            100000.0,
            0,
            0,
            0
          ],
          "shape": "sym",
          "scale": "p_ref",
          "semantics": {
            "role": "persistent",
            "quantity": "cauchy_stress",
            "transformation": "symmetric_spatial_tensor"
          }
        },
        {
          "name": "e",
          "unit": "1",
          "initial": 0.7,
          "shape": "scalar",
          "scale": "1",
          "semantics": {
            "role": "persistent",
            "quantity": "unspecified",
            "transformation": "fixed_components"
          }
        }
      ],
      "derived": [
        {
          "name": "K",
          "expr": "E / (3 * (1 - 2 * nu))"
        },
        {
          "name": "G",
          "expr": "E / (2 * (1 + nu))"
        }
      ],
      "domain": [
        "e > 0"
      ],
      "id": "scope-explicit-incremental",
      "name": "Linear isotropic elasticity",
      "family": "elasticity",
      "description": "Infinitesimal isotropic elasticity. Demonstration parameters, not calibrated to a soil.",
      "sources": [
        {
          "url": "https://github.com/ufz/ogs/blob/b5d0f115c75ee74a7cdbfad533625a550a416fda/MaterialLib/SolidModels/LinearElasticIsotropic.h",
          "locator": "MaterialProperties::lambda, mu, bulk_modulus; elasticTangentStiffness",
          "role": "Pinned reference formulation"
        },
        {
          "url": "https://github.com/ufz/ogs/blob/b5d0f115c75ee74a7cdbfad533625a550a416fda/MaterialLib/SolidModels/LinearElasticIsotropic.cpp",
          "locator": "LinearElasticIsotropic::integrateStress; sigma_prev + C * (eps_m - eps_m_prev)",
          "role": "Pinned incremental stress update"
        },
        {
          "url": "https://github.com/benjym/constitutive-atlas/blob/main/docs/models/linear-elastic.md",
          "locator": "Equation mapping; project-specific void-ratio bookkeeping and small-strain limits",
          "role": "Transcription dossier"
        }
      ],
      "equations": {
        "sigma": "sigma - sigma_n - K * trace(de) * I - 2 * G * dev(de)",
        "e": "e - (1 + e_n) * exp(-trace(de)) + 1"
      },
      "formulation": {
        "time_dependence": "strain_path",
        "equation_form": "incremental_residual",
        "kinematics": "small_strain_3d",
        "frame": "fixed_spatial",
        "objective_rate": "none",
        "tensor_representation": "mandel",
        "stress_sign": "compression_positive",
        "strain_sign": "compression_positive",
        "stress": {
          "source": "state",
          "name": "sigma",
          "measure": "cauchy",
          "scope": "effective"
        },
        "inputs": {
          "equation": {
            "de": {
              "quantity": "strain_increment",
              "measure": "infinitesimal_strain",
              "shape": "sym",
              "unit": "1",
              "configuration": "current",
              "sampling": "increment",
              "constraint": "finite"
            }
          },
          "advance": {}
        }
      },
      "initialization": {
        "method": "explicit_state",
        "default_policy": "examples_only",
        "required_state": [
          "sigma",
          "e"
        ],
        "validation": "domain_and_initial_checks"
      }
    },
