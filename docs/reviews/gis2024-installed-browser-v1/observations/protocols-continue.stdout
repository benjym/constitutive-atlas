 for(let i=0;i<cases.length;i++){
  const row=cases[i],before=await page.evaluate(()=>window.__wires.length);
  await page.locator('#run-file').setInputFiles(row.file);
  await page.waitForFunction(n=>window.__wires.slice(n).some(x=>x.direction==='response')&&!document.querySelector('#export-run').disabled,before);
  const wire=await page.evaluate(n=>window.__wires.slice(n).filter(x=>x.direction==='request'||x.direction==='response'),before);
  const request=wire.find(x=>x.direction==='request'),response=wire.find(x=>x.direction==='response'&&x.data.id===request.data.id);
  if(!response?.data.result?.ok)throw Error(row.id+': '+JSON.stringify(response));
  const result=response.data.result,s=request.data.specification;
  if(result.points.length!==s.steps+1||result.points.some(x=>x.state.length!==14)||JSON.stringify(result.points[0].state)!==JSON.stringify(s.initial))throw Error('History mismatch: '+row.id);
  const pending=page.waitForEvent('download');await page.locator('#export-run').click();const download=await pending;await download.saveAs('output/playwright/gis-installed/case-'+String(i+11).padStart(2,'0')+'.json');
  records.push({id:row.id,request:request.data,response:response.data,dom:await page.locator('#controls').evaluate(el=>Object.fromEntries([...el.querySelectorAll('input[id],select[id]')].map(x=>[x.id,x.value])))});
 }
 const auditDownload=page.waitForEvent('download');await page.evaluate(records=>{const a=document.createElement('a');a.href=URL.createObjectURL(new Blob([JSON.stringify(records,null,2)],{type:'application/json'}));a.download='browser-protocol-wires.json';a.click();},await page.evaluate(()=>window.__wires));
 const event=await auditDownload;await event.saveAs('output/playwright/gis-installed/protocol-wires.json');
 return {cases:records.length,points:records.reduce((n,r)=>n+r.response.result.points.length,0),full_state:14,worker_requests:records.length};
})(page);
