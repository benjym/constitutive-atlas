### Ran Playwright code
```js
await (async (page) => {
 const assert=(value,message)=>{if(!value)throw Error(message);};
 const errors=[];page.on('pageerror',error=>errors.push(String(error)));
 await page.setViewportSize({width:1440,height:1000});
 await page.goto(new URL('#laboratory',page.url()).href);
 await page.locator('#model').selectOption('linear-elastic');
 await page.waitForFunction(()=>document.querySelector('#run-state').textContent.includes('Response up to date'));
 const ordinary=await page.locator('#run-state').textContent();
 await page.locator('#model').selectOption('j2-linear-isotropic-hardening-be');
 await page.waitForFunction(()=>document.querySelector('#j2-material-laboratory')?.shadowRoot.querySelector('#status').textContent.startsWith('Completed'),undefined,{timeout:120000});
 const j2=await page.locator('#j2-material-laboratory #status').textContent();
 await page.locator('#model').selectOption('sls-comsol63-deviatoric-zero-spin-ode');
 await page.waitForFunction(()=>document.querySelector('#sls-status').textContent.startsWith('Completed'),undefined,{timeout:120000});
 const sls=await page.locator('#sls-status').textContent();
 assert(await page.locator('#j2-material-laboratory').isHidden(),'J2 hidden when SLS selected');
 await page.locator('#model').selectOption('burgers-itasca900-dry-zero-spin-ode');
 await page.waitForFunction(()=>document.querySelector('#timed-status').textContent.startsWith('Completed'),undefined,{timeout:120000});
 const burgers=await page.locator('#timed-status').textContent();
 assert(await page.locator('#sls-status').isHidden(),'SLS hidden when Burgers selected');
 await page.locator('#model').selectOption('linear-elastic');
 await page.waitForFunction(()=>document.querySelector('#run-state').textContent.includes('Response up to date'));
 assert(await page.locator('#j2-material-laboratory').isHidden(),'J2 hidden after ordinary return');
 assert(await page.locator('#sls-status').isHidden(),'SLS hidden after ordinary return');
 assert(await page.locator('#timed-status').isHidden(),'Burgers hidden after ordinary return');
 assert(errors.length===0,'No browser runtime errors: '+errors.join('; '));
 const retired={};for(const name of ['j2.html','sls.html','power-creep.html','publications.html','recorded.html']){
  retired[name]=(await page.request.get(new URL(name,page.url()).href)).status();assert(retired[name]===404,'Retired page absent: '+name);
 }
 await page.evaluate(report=>window.__atlasReleaseChecks=report,{status:'passed',ordinary,j2,sls,burgers,errors,retired});
 await page.screenshot({path:'output/playwright/ordinary-release-desktop.png',fullPage:true});
}
)(page);
```
