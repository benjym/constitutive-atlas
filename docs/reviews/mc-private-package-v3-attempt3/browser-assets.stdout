### Ran Playwright code
```js
await (async (page) => { return await page.evaluate(async()=>{ const resources=[...new Set(performance.getEntriesByType("resource").map(x=>x.name).filter(x=>x.startsWith(location.origin+"/constitutive-atlas/")&&!x.includes("blob:")))]; const records=[]; for(const url of resources){ const response=await fetch(url);const body=await response.arrayBuffer(); const hash=[...new Uint8Array(await crypto.subtle.digest("SHA-256",body))].map(x=>x.toString(16).padStart(2,"0")).join("");records.push({path:new URL(url).pathname,status:response.status,sha256:hash});}return records; }); })(page);
```
