      "locator": "Synthetic checked operator transaction; not a constitutive law"
    }
  ],
  "fields": {
    "A": {
      "shape": "sym",
      "unit": "1",
      "storage": "state"
    }
  },
  "inputs": {
    "X": {
      "shape": "sym",
      "unit": "1"
    },
    "gate": {
      "shape": "scalar",
      "unit": "1"
    }
  },
  "phases": [
    {
      "name": "advanced",
      "kind": "advance",
      "base": "parent",
      "bindings": {
        "X": {
          "input": "X"
        },
        "g": {
          "input": "gate"
        }
      },
      "writes": {
        "A": "select(g>0,(select(principal_range_le(X,0*1),trace(X/3),select(principal_max_repeated(X),principal_upper_sum(X)/2,principal_max(X)))-select(principal_range_le(X,0*1),trace(X/3),select(principal_min_repeated(X),principal_lower_sum(X)/2,principal_min(X))))*I,I)"
      }
    }
  ]
