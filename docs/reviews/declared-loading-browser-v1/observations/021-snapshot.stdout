          - group [ref=f1e185]:
            - generic "Equations & source provenance" [active] [ref=f1e186] [cursor=pointer]
            - generic [ref=f1e405]:
              - paragraph [ref=f1e406]: Flattened selected HP/extracted-ASBS+GIS source rates; stress6,e,h6,Omega. Explicit18 physical parameters plus numerical stress scale. Zero spin, no hidden preparation or clamping, no author-code algorithm equivalence or experimental validation. Initial state is a software fixture; source preparation must be supplied explicitly. The full pairing requires computed memory norm <= R with no enlarged tolerance shell; exact sphere arithmetic and finite integration remain explicit verification gates.
              - paragraph [ref=f1e407]: "Equation form: strain_path_rate. State equations are residuals for implicit models, or increments per unit path fraction for strain-path rate models."
              - generic [ref=f1e408]: p = trace(sigma)/3
              - generic [ref=f1e409]: H = sigma/trace(sigma)
              - generic [ref=f1e410]: Hdev = dev(dev(sigma))/trace(sigma)
              - generic [ref=f1e411]: Q = dot(H,H)
              - generic [ref=f1e412]: j2 = dot(Hdev,Hdev)
              - generic [ref=f1e413]: tanpsi = sqrt(3*j2)
              - generic [ref=f1e414]: cos3theta = select(j2>0,-sqrt(6)*cube_trace(Hdev)/j2**1.5,0)
              - generic [ref=f1e415]: Fden = 2+sqrt(2)*tanpsi*cos3theta
              - generic [ref=f1e416]: Frad = tanpsi**2/8+(2-tanpsi**2)/Fden
              - generic [ref=f1e417]: F = sqrt(Frad)-tanpsi/(2*sqrt(2))
              - generic [ref=f1e418]: a = sqrt(3/8)*(3-sin(phi))/sin(phi)
              - generic [ref=f1e419]: compression = exp(-(3*p/hs)**n)
              - generic [ref=f1e420]: ei = ei0*compression
              - generic [ref=f1e421]: ec = ec0*compression
              - generic [ref=f1e422]: ed = ed0*compression
              - generic [ref=f1e423]: fd = ((e-ed)/(ec-ed))**alpha
              - generic [ref=f1e424]: fsden = 3+a**2-a*sqrt(3)*((ei0-ed0)/(ec0-ed0))**alpha
              - generic [ref=f1e425]: fs = hs/n*(ei/e)**beta*(1+ei)/ei*(3*p/hs)**(1-n)/fsden
              - generic [ref=f1e426]: N = -F*a/Q*(H+Hdev)
              - generic [ref=f1e427]: inverse_den = F**2+a**2*Q
              - generic [ref=f1e428]: B = Q/F**2*(N-a**2*H*dot(H,N)/inverse_den)
              - generic [ref=f1e429]: Bnorm = norm(B)
              - generic [ref=f1e430]: sigma_unit = sigma/norm(sigma)
              - generic [ref=f1e431]: Caux = Q/F**2*(sigma_unit-a**2*H*dot(H,sigma_unit)/inverse_den)/fs
              - generic [ref=f1e432]: G = n/hs*trace(sigma_unit)*(3*p/hs)**(n-1)
              - generic [ref=f1e433]: ratio = (1+e)/e
              - generic [ref=f1e434]: asbs_den = G-ratio*trace(Caux)
              - generic [ref=f1e435]: asbs_t = ratio*trace(B)/asbs_den
              - generic [ref=f1e436]: asbs_vector = B+asbs_t*Caux
              - generic [ref=f1e437]: asbs_norm = norm(asbs_vector)
              - generic [ref=f1e438]: fdAstar = 1/asbs_norm
              - generic [ref=f1e439]: m = -B/Bnorm
              - generic [ref=f1e440]: C = Bnorm*fdAstar
              - generic [ref=f1e441]: S = fd/fdAstar
              - generic [ref=f1e442]: f = 0*I
              - generic [ref=f1e443]: hn = norm(h)
              - generic [ref=f1e444]: hdir = select(hn>0,h/hn,0*I)
              - generic [ref=f1e445]: rho = hn/R
              - generic [ref=f1e446]: dn = norm(de)
              - generic [ref=f1e447]: h_loading = dot(hdir,de)
              - generic [ref=f1e448]: h_rhs = select(h_loading>0,de-hdir*(rho**beta_R)*h_loading,de)
              - generic [ref=f1e449]: chi = chi_0+Omega*(chi_max-chi_0)
              - generic [ref=f1e450]: gamma = gamma_chi*chi
              - generic [ref=f1e451]: Omega_rhs = C_Omega*(1-rho**gamma_Omega-Omega)*dn
              - generic [ref=f1e452]: q = select(dn>0,h_loading/dn,0)
              - generic [ref=f1e453]: k = select(h_loading>0,(1-rho**chi_R)*m_R+rho**chi_R*((1-q)*m_T+q),rho**chi_R*(1+q)*m_T+(1-rho**chi_R*(1+q))*m_R)
              - generic [ref=f1e454]: suppression = select(dn>0,S**(k**gamma),0)
              - generic [ref=f1e455]: effective_de = de-m*C*suppression*dn+f
              - generic [ref=f1e456]: E_effective_de = fs*(F**2*effective_de+a**2*H*dot(H,effective_de))/Q
              - generic [ref=f1e457]: sigma_rhs = k*E_effective_de
              - generic [ref=f1e458]: h_absolute_components = abs(dot(h,sym(1,0,0,0,0,0)))+abs(dot(h,sym(0,1,0,0,0,0)))+abs(dot(h,sym(0,0,1,0,0,0)))+abs(dot(h,sym(0,0,0,1,0,0)))+abs(dot(h,sym(0,0,0,0,1,0)))+abs(dot(h,sym(0,0,0,0,0,1)))
              - generic [ref=f1e459]: de_absolute_components = abs(dot(de,sym(1,0,0,0,0,0)))+abs(dot(de,sym(0,1,0,0,0,0)))+abs(dot(de,sym(0,0,1,0,0,0)))+abs(dot(de,sym(0,0,0,1,0,0)))+abs(dot(de,sym(0,0,0,0,1,0)))+abs(dot(de,sym(0,0,0,0,0,1)))
              - generic [ref=f1e460]: spherical_residual = abs(dot(sigma,sym(1,-1,0,0,0,0)))+abs(dot(sigma,sym(0,1,-1,0,0,0)))+abs(dot(sigma,sym(0,0,0,1,0,0)))+abs(dot(sigma,sym(0,0,0,0,1,0)))+abs(dot(sigma,sym(0,0,0,0,0,1)))
              - generic [ref=f1e461]: "sigma : sigma_rhs"
              - generic [ref=f1e462]: "e : -(1+e)*trace(de)"
              - generic [ref=f1e463]: "h : h_rhs"
              - generic [ref=f1e464]: "Omega : Omega_rhs"
              - heading "Declared domain" [level=3] [ref=f1e465]
              - generic [ref=f1e466]: e > 0
              - generic [ref=f1e467]: ed0 < ec0
              - generic [ref=f1e468]: ec0 < ei0
              - generic [ref=f1e469]: p > 0*p_scale
              - generic [ref=f1e470]: ed < e
              - generic [ref=f1e471]: e < ei
              - generic [ref=f1e472]: m_T <= m_R
              - generic [ref=f1e473]: chi_0 <= chi_max
              - generic [ref=f1e474]: Omega >= 0
              - generic [ref=f1e475]: Omega <= 1
              - generic [ref=f1e476]: hn <= R
              - generic [ref=f1e477]: select(hn>0,0,h_absolute_components) <= 0
              - generic [ref=f1e478]: select(dn>0,0,de_absolute_components) <= 0
              - generic [ref=f1e479]: abs(asbs_den) > 0/p_scale
              - generic [ref=f1e480]: cos3theta >= -1-1.4210854715202004e-14
              - generic [ref=f1e481]: cos3theta <= 1+1.4210854715202004e-14
              - generic [ref=f1e482]: q >= -1-1.4210854715202004e-14
              - generic [ref=f1e483]: q <= 1+1.4210854715202004e-14
              - generic [ref=f1e484]: select(dn>0,suppression,1) > 0
              - generic [ref=f1e485]: select(j2>0,0*p_scale,spherical_residual) <= 0*p_scale
              - generic [ref=f1e486]: p > 0*p_scale
              - generic [ref=f1e487]: abs(p) <= p_scale*1e280
              - generic [ref=f1e488]: norm(H) <= 1e280
              - generic [ref=f1e489]: norm(Hdev) <= 1e280
              - generic [ref=f1e490]: Q > 0
              - generic [ref=f1e491]: abs(Q) <= 1e280
              - generic [ref=f1e492]: abs(j2) <= 1e280
              - generic [ref=f1e493]: abs(tanpsi) <= 1e280
              - generic [ref=f1e494]: abs(cos3theta) <= 1e280
              - generic [ref=f1e495]: Fden > 0
              - generic [ref=f1e496]: abs(Fden) <= 1e280
              - generic [ref=f1e497]: Frad > 0
              - generic [ref=f1e498]: abs(Frad) <= 1e280
              - generic [ref=f1e499]: F > 0
              - generic [ref=f1e500]: abs(F) <= 1e280
              - generic [ref=f1e501]: abs(a) <= 1e280
              - generic [ref=f1e502]: compression > 0
              - generic [ref=f1e503]: abs(compression) <= 1e280
              - generic [ref=f1e504]: ei > 0
              - generic [ref=f1e505]: abs(ei) <= 1e280
              - generic [ref=f1e506]: ec > 0
