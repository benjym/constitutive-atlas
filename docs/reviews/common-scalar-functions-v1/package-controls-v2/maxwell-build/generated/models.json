      "id": "maxwell-itasca900-zero-spin-ode",
      "name": "Itasca 9.0 Maxwell continuous law \u2014 dry zero-spin specialization",
      "family": "linear viscoelasticity",
      "description": "Packet-only draft continuous small-strain fixed-frame law derived from Itasca 9.0.182 Eqs4\u20136. Total stress for an explicitly dry uncoupled material point; no pore-pressure model. Not the vendor central-difference algorithm, finite-rotation implementation or an admitted catalogue model. Numeric parameter bounds and initial values are project examples.",
      "status": "draft",
      "sources": [
        {
          "url": "https://docs.itascacg.com/itasca900/common/models/viscous/doc/modelviscous.html",
          "role": "vendor mathematical formulation",
          "locator": "Eqs1\u20136, especially Eq4 coefficients G/eta; trace interpretation of malformed adjacent index expressions"
        },
        {
          "url": "https://docs.itascacg.com/itasca900/common/docproject/source/manual/program_guide/modelformulation/signconventions.html",
          "role": "tensor sign convention",
          "locator": "direct stress, direct strain, strain rate"
        },
        {
          "url": "https://docs.itascacg.com/itasca900/flac3d/zone/test3d/Creep/OedometerMaxwell/oedometermaxwell.html",
          "role": "small-strain dry example and preparation",
          "locator": "Eqs1\u20136, elastic-equilibrium paragraph, model large-strain off; no vendor code executed"
        }
      ],
      "formulation": {
        "time_dependence": "physical_time",
        "equation_form": "ode",
        "kinematics": "small_strain_3d",
        "frame": "fixed_spatial",
        "objective_rate": "none",
