        "strain_sign": "compression_positive",
        "inputs": {
          "equation": {
            "time": {
              "quantity": "time",
              "shape": "scalar",
              "unit": "s",
              "sampling": "stage",
              "constraint": "finite"
            },
            "strain_rate": {
              "quantity": "strain_rate",
              "measure": "infinitesimal_strain_rate",
              "shape": "sym",
              "unit": {
                "si": [
                  0,
                  0,
                  -1,
                  0
                ]
              },
              "configuration": "current",
              "sampling": "stage",
              "constraint": "finite"
            }
          },
          "advance": {
            "start_time": {
              "quantity": "time",
              "shape": "scalar",
              "unit": "s",
              "sampling": "start",
              "constraint": "finite"
            },
            "duration": {
              "quantity": "duration",
              "shape": "scalar",
              "unit": "s",
              "sampling": "interval",
              "constraint": "positive_finite"
            }
          }
        },
