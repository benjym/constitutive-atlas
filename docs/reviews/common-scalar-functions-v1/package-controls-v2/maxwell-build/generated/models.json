          "default": 24000000.0,
          "min": 1e-12,
          "max": 1e+30
        }
      },
      "state": [
        {
          "name": "sigma",
          "shape": "sym",
          "unit": "Pa",
          "scale": "Kmod",
          "initial": [
            0,
            0,
            0,
            0,
            0,
            0
