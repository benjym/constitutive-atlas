          "name": "stress",
          "measure": "cauchy",
          "scope": "total"
        }
      },
      "parameters": {
        "Kmod": {
          "unit": "Pa",
          "default": 20000000.0,
          "min": 1e-12,
          "max": 1e+30
        },
        "Gmod": {
          "unit": "Pa",
          "default": 12000000.0,
          "min": 1e-12,
          "max": 1e+30
        },
        "eta": {
          "unit": {
            "si": [
              1,
              -1,
              -1,
              0
            ]
