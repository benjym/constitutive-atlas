await (async (page) => {
 const mid='research-hp-extracted-asbs-gis-2024-v03';await page.evaluate(mid=>location.hash='catalogue/'+mid,mid);await page.waitForFunction(()=>document.querySelector('#catalogue-dialog').open&&document.querySelector('#catalogue-detail-body').textContent.includes('Recorded source-review status: pending'));
 const body=page.locator('#catalogue-detail-body');const report={title:await page.locator('#catalogue-detail-title').textContent(),text:await body.innerText(),links:await body.locator('a').evaluateAll(links=>links.map(a=>({text:a.textContent,href:a.href}))),formulation:await body.locator('.catalogue-formulation').innerText()};
 const review=report.links.find(x=>x.text==='Original source-review record');const raw=await page.request.get(review.href);report.review=await raw.json();if(report.review.status!=='pending'||report.review.independent||report.review.reviewer)throw Error('Review falsely accepted');
 const json=body.getByRole('link',{name:'Model definition (JSON)'});const opened=page.waitForEvent('popup');await json.click();const popup=await opened;await popup.waitForLoadState('domcontentloaded');report.definition_popup={url:popup.url(),body:await popup.locator('body').innerText()};await popup.close();
 report.numerical_index_gap=report.text.includes('No evidence record for this formulation is indexed in this build.');report.measurement_note=await page.locator('#match-experiment').locator('xpath=../following-sibling::p[1]').textContent();
 const pending=page.waitForEvent('download');await page.evaluate(report=>{const a=document.createElement('a');a.href=URL.createObjectURL(new Blob([JSON.stringify(report,null,2)],{type:'application/json'}));a.download='disclosure-audit.json';a.click();},report);const d=await pending;await d.saveAs('output/playwright/gis-closure/disclosure-audit.json');return {pending_unsigned:true,numerical_index_gap:report.numerical_index_gap,links:report.links};
}
)(page);
