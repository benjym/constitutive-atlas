{
  "schema_version": "0.3",
  "id": "synthetic-controlled-path",
  "name": "NorSand Jefferies 1993 \u2014 active drained axial formulation",
  "family": "critical-state sand plasticity",
  "description": "Exact original active monotonic rigid-plastic axial equations; no elasticity, unloading/cyclic, general Lode or finite-rotation law. Current-volume void-ratio reconstruction and midpoint integration are explicit Atlas numerical choices. Staged capability candidate; not approved or installed. Parameter bounds are prospective numerical study bounds, not universal source ranges.",
  "status": "draft",
  "sources": [
    {
      "url": "https://doi.org/10.1680/geot.1993.43.1.91",
      "locator": "pp91\u2013103; Eqs5\u201312; p98 forward integration and consistency; p101 elasticity limitation",
      "role": "original source, supplied private PDF SHA256 fee99108e493f34eb987c759eddf73cfc86e77102c73e42d099c00f1209851b9"
    }
  ],
  "formulation": {
    "time_dependence": "strain_path",
    "equation_form": "path_ode",
    "kinematics": "small_strain_3d",
    "frame": "fixed_spatial",
    "objective_rate": "none",
    "tensor_representation": "mandel",
    "stress_sign": "compression_positive",
    "strain_sign": "compression_positive",
    "inputs": {
      "equation": {
        "path_coordinate": {
          "quantity": "path_coordinate",
          "shape": "scalar",
          "unit": "1",
          "sampling": "stage",
          "constraint": "finite"
        },
        "u": {
          "quantity": "control",
          "shape": "scalar",
          "unit": "1",
          "sampling": "stage",
          "constraint": "finite",
          "binding": {
            "control": "load",
            "derivative_order": 0
          }
        },
        "du": {
          "quantity": "control",
          "shape": "scalar",
          "unit": "1",
          "sampling": "stage",
          "constraint": "finite",
          "binding": {
            "control": "load",
            "derivative_order": 1
          }
        },
        "unused": {
          "quantity": "control",
          "shape": "scalar",
          "unit": "1",
          "sampling": "stage",
          "constraint": "finite",
          "binding": {
            "control": "unused",
            "derivative_order": 0
          }
        }
      },
      "advance": {
        "start_coordinate": {
          "quantity": "path_coordinate",
          "shape": "scalar",
          "unit": "1",
          "sampling": "start",
          "constraint": "finite"
        },
        "progress": {
          "quantity": "path_progress",
          "shape": "scalar",
          "unit": "1",
          "sampling": "interval",
          "constraint": "nonnegative_finite"
        }
      }
    },
    "stress": {
      "source": "observable",
      "name": "stress",
      "measure": "cauchy",
      "scope": "effective"
    }
  },
  "parameters": {
    "pref": {
      "unit": "Pa",
      "default": 1000,
      "min": 1,
      "max": 100000
    }
  },
  "state": [
    {
      "name": "vscalar",
      "shape": "scalar",
      "unit": "1",
      "scale": "1",
      "initial": 1,
      "semantics": {
        "role": "persistent",
        "quantity": "synthetic_scalar",
        "transformation": "scalar_invariant"
      }
    },
    {
      "name": "A",
      "shape": "sym",
      "unit": "Pa",
      "scale": "pref",
      "initial": [
        0,
        0,
        0,
        0,
        0,
        0
      ],
      "semantics": {
        "role": "persistent",
        "quantity": "synthetic_tensor",
        "transformation": "fixed_components"
      }
    }
  ],
  "derived": [],
  "equations": {
    "vscalar": "u+du",
    "A": "pref*(u+du)*I"
  },
  "domain": [
    "vscalar < 100"
  ],
  "observables": [
    {
      "name": "stress",
      "shape": "sym",
      "unit": "Pa",
      "scale": "pref",
      "expr": "A"
    }
  ],
  "initialization": {
    "method": "explicit_state",
    "default_policy": "examples_only",
    "required_state": [
      "vscalar",
      "A"
    ],
    "validation": "domain_and_initial_checks"
  }
}
