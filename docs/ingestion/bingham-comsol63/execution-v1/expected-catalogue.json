{
  "schema_version": "0.1",
  "sha256": "9d9ad2e8e6f54df5a86b55e886ddf0a57edd43cac7a4828942356134161c7923",
  "models": [
    {
      "schema_version": "0.3",
      "id": "bingham-comsol63-mises-perfect-zero-spin-ode",
      "name": "COMSOL 6.3 Bingham \u2014 von Mises perfect viscoplastic dry zero-spin ODE",
      "family": "elastoviscoplasticity",
      "description": "Small-strain isotropic elastic associative von Mises Bingham law, constant positive yield stress, no isotropic or kinematic hardening and no thermal/pore effects. Compression-positive fixed-frame specialization. Project parameter examples and finite numerical envelope are not source calibration.",
      "status": "draft",
      "sources": [
        {
          "url": "https://doc.comsol.com/6.3/doc/com.comsol.help.sme/sme_ug_theory.06.039.html",
          "locator": "Viscoplasticity images057/059; Equivalent Stress images016/022; Bingham Model images076\u2013078; Time Stepping Eq3-149/150",
          "role": "primary vendor mathematical formulation"
        },
        {
          "url": "https://doc.comsol.com/6.3/doc/com.comsol.help.sme/sme_ug_solid.07.024.html",
          "locator": "Bingham; Plasticity Model; Perfectly plastic; No kinematic hardening; Thermal Effects None",
          "role": "primary exact variant and viscosity unit"
        },
        {
          "url": "https://doc.comsol.com/6.3/doc/com.comsol.help.sme/sme_ug_theory.06.029.html",
          "locator": "Linear Viscoelasticity introduction: elastic strain subtraction; isotropic elastic stress images008\u2013010",
          "role": "primary isotropic elasticity and source sign convention"
        }
      ],
      "formulation": {
        "time_dependence": "physical_time",
        "equation_form": "ode",
        "kinematics": "small_strain_3d",
        "frame": "fixed_spatial",
        "objective_rate": "none",
        "tensor_representation": "mandel",
        "stress_sign": "compression_positive",
        "strain_sign": "compression_positive",
        "inputs": {
          "equation": {
            "time": {
              "quantity": "time",
              "shape": "scalar",
              "unit": "s",
              "sampling": "stage",
              "constraint": "finite"
            },
            "strain_rate": {
              "quantity": "strain_rate",
              "measure": "infinitesimal_strain_rate",
              "shape": "sym",
              "unit": {
                "si": [
                  0,
                  0,
                  -1,
                  0
                ]
              },
              "configuration": "current",
              "sampling": "stage",
              "constraint": "finite"
            }
          },
          "advance": {
            "start_time": {
              "quantity": "time",
              "shape": "scalar",
              "unit": "s",
              "sampling": "start",
              "constraint": "finite"
            },
            "duration": {
              "quantity": "duration",
              "shape": "scalar",
              "unit": "s",
              "sampling": "interval",
              "constraint": "positive_finite"
            }
          }
        },
        "stress": {
          "source": "observable",
          "name": "stress",
          "measure": "cauchy",
          "scope": "total"
        }
      },
      "parameters": {
        "K": {
          "default": 20000000.0,
          "min": 1e-12,
          "max": 1e+30,
          "unit": "Pa",
          "label": "Project illustrative K"
        },
        "G": {
          "default": 10000000.0,
          "min": 1e-12,
          "max": 1e+30,
          "unit": "Pa",
          "label": "Project illustrative G"
        },
        "sigma_y": {
          "default": 100000.0,
          "min": 1e-12,
          "max": 1e+30,
          "unit": "Pa",
          "label": "Project illustrative sigma_y"
        },
        "eta": {
          "default": 20000000.0,
          "min": 1e-12,
          "max": 1e+30,
          "unit": {
            "si": [
              1,
              -1,
              -1,
              0
            ]
          },
          "label": "Project illustrative eta"
        }
      },
      "state": [
        {
          "name": "eps",
          "shape": "sym",
          "unit": "1",
          "scale": "1",
          "initial": [
            0,
            0,
            0,
            0,
            0,
            0
          ],
          "semantics": {
            "role": "persistent",
            "quantity": "infinitesimal_strain",
            "transformation": "symmetric_spatial_tensor"
          }
        },
        {
          "name": "eps_vp",
          "shape": "sym",
          "unit": "1",
          "scale": "1",
          "initial": [
            0,
            0,
            0,
            0,
            0,
            0
          ],
          "semantics": {
            "role": "persistent",
            "quantity": "viscoplastic_strain",
            "transformation": "symmetric_spatial_tensor"
          }
        },
        {
          "name": "alpha",
          "shape": "scalar",
          "unit": "1",
          "scale": "1",
          "initial": 0,
          "semantics": {
            "role": "persistent",
            "quantity": "accumulated_equivalent_viscoplastic_strain",
            "transformation": "scalar_invariant"
          }
        }
      ],
      "derived": [
        {
          "name": "elastic_strain",
          "expr": "eps - eps_vp"
        },
        {
          "name": "sdev",
          "expr": "2 * G * dev(elastic_strain)"
        },
        {
          "name": "q",
          "expr": "sqrt(1.5) * norm(sdev)"
        },
        {
          "name": "lambda_vp",
          "expr": "max(q - sigma_y, 0 * sigma_y) / eta"
        }
      ],
      "equations": {
        "eps": "strain_rate",
        "eps_vp": "1.5 * lambda_vp / max(q, sigma_y) * sdev",
        "alpha": "lambda_vp"
      },
      "domain": [
        "K > 0 * K",
        "G > 0 * G",
        "sigma_y > 0 * sigma_y",
        "eta > 0 * eta",
        "alpha >= 0",
        "abs(trace(eps_vp)) <= 1e-10"
      ],
      "initial_checks": [
        "alpha >= 0",
        "abs(trace(eps_vp)) <= 1e-10"
      ],
      "observables": [
        {
          "name": "stress",
          "shape": "sym",
          "unit": "Pa",
          "scale": "K",
          "expr": "K * trace(elastic_strain) * I + sdev"
        }
      ],
      "initialization": {
        "method": "explicit_state",
        "default_policy": "examples_only",
        "required_state": [
          "eps",
          "eps_vp",
          "alpha"
        ],
        "validation": "domain_and_initial_checks"
      }
    }
  ]
}
