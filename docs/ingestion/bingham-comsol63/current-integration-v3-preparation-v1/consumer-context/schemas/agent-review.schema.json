{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://benjym.github.io/constitutive-atlas/schemas/agent-review.schema.json",
  "title": "Independent agent model review and bounded approval checklist",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "kind": {
      "const": "agent-model-review"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "created_at": {
      "type": "string",
      "minLength": 1
    },
    "source_commit": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-f0-9]{40}$"
    },
    "model": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^models/.+[.]json$"
        },
        "sha256": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "id",
        "path",
        "sha256"
      ],
      "additionalProperties": false
    },
    "status": {
      "enum": [
        "pending",
        "changes-requested",
        "accepted"
      ]
    },
    "reviewer": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "agent"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "run_id": {
          "type": "string",
          "minLength": 1
        },
        "independence_basis": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "kind",
        "name",
        "run_id",
        "independence_basis"
      ],
      "additionalProperties": false
    },
    "author_run_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "scope": {
      "type": "string",
      "minLength": 1
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "blocking_findings": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "checklist": {
      "type": "array",
      "minItems": 9,
      "maxItems": 9,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "enum": [
              "source_provenance",
              "equation_fidelity",
              "conventions_dimensions",
              "initialization_domain",
              "integration_transactions",
              "independent_numerical_evidence",
              "backend_delivery",
              "applicability_claims",
              "reproducibility_rights"
            ]
          },
          "outcome": {
            "enum": [
              "pending",
              "pass",
              "fail",
              "not-applicable"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "id",
          "outcome",
          "reason",
          "evidence"
        ],
        "additionalProperties": false
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "path",
          "sha256"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "kind",
    "id",
    "created_at",
    "source_commit",
    "model",
    "status",
    "reviewer",
    "author_run_ids",
    "scope",
    "limitations",
    "blocking_findings",
    "checklist",
    "artifacts"
  ],
  "additionalProperties": false
}
