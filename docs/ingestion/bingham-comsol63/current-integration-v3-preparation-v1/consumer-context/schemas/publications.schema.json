{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "kind": {
      "const": "publication-lineage"
    },
    "updated_on": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "type": "string",
      "minLength": 1
    },
    "reviewer": {
      "type": "string",
      "minLength": 1
    },
    "independent_review": {
      "const": "pending"
    },
    "publications": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^doi:10[.]"
          },
          "doi": {
            "type": "string",
            "pattern": "^10[.]"
          },
          "url": {
            "type": "string",
            "pattern": "^https://doi[.]org/10[.]"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "authors": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "publication_type": {
            "type": "string",
            "minLength": 1
          },
          "version_role": {
            "enum": [
              "preprint",
              "version-of-record",
              "correction"
            ]
          },
          "publication_date_parts": {
            "type": "array",
            "minItems": 1,
            "maxItems": 3,
            "items": {
              "type": "integer",
              "minimum": 1
            }
          },
          "model_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "properties": {
                "url": {
                  "type": "string",
                  "pattern": "^https://"
                },
                "locator": {
                  "type": "string",
                  "minLength": 1
                },
                "accessed_on": {
                  "type": "string",
                  "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
                },
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              },
              "required": [
                "url",
                "locator",
                "accessed_on"
              ],
              "additionalProperties": false
            }
          },
          "unresolved": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "id",
          "doi",
          "url",
          "title",
          "authors",
          "publication_type",
          "version_role",
          "publication_date_parts",
          "model_ids",
          "evidence",
          "unresolved"
        ],
        "additionalProperties": false
      }
    },
    "relations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "source": {
            "type": "string",
            "minLength": 1
          },
          "target": {
            "type": "string",
            "minLength": 1
          },
          "relation": {
            "enum": [
              "is-preprint-of",
              "corrects",
              "builds-on",
              "discusses"
            ]
          },
          "summary": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "properties": {
                "url": {
                  "type": "string",
                  "pattern": "^https://"
                },
                "locator": {
                  "type": "string",
                  "minLength": 1
                },
                "accessed_on": {
                  "type": "string",
                  "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
                },
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              },
              "required": [
                "url",
                "locator",
                "accessed_on"
              ],
              "additionalProperties": false
            }
          },
          "independent_review": {
            "const": "pending"
          }
        },
        "required": [
          "source",
          "target",
          "relation",
          "summary",
          "evidence",
          "independent_review"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "kind",
    "updated_on",
    "scope",
    "reviewer",
    "independent_review",
    "publications",
    "relations"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://benjym.github.io/constitutive-atlas/schemas/publications.schema.json",
  "title": "Provisional publication lineage graph; independent review pending"
}
