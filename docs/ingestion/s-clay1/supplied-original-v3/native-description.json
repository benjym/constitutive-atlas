{"schema_version":"0.1","sha256":"0e14ef0b1b9a612176cf23c13ae3842033b290cbfd4240adefc60d8bc18d291a","models":[{"schema_version":"0.1","status":"transcribed","parameters":{"p_ref":{"default":100000,"min":1,"max":10000000000.0,"unit":"Pa","label":"Reference stress / numerical scaling"},"E":{"default":30000000.0,"min":1,"max":1000000000000.0,"unit":"Pa","label":"Young modulus"},"nu":{"default":0.25,"min":-0.99,"max":0.499,"unit":"1","label":"Poisson ratio"}},"state":[{"name":"sigma","unit":"Pa","initial":[100000.0,100000.0,100000.0,0,0,0],"shape":"sym","scale":"p_ref"},{"name":"e","unit":"1","initial":0.7,"shape":"scalar","scale":"1"}],"derived":[{"name":"K","expr":"E / (3 * (1 - 2 * nu))"},{"name":"G","expr":"E / (2 * (1 + nu))"}],"domain":["e > 0"],"integration":"residual","id":"linear-elastic","name":"Linear isotropic elasticity","family":"elasticity","description":"Infinitesimal isotropic elasticity. Demonstration parameters, not calibrated to a soil.","sources":[{"url":"https://github.com/ufz/ogs/blob/b5d0f115c75ee74a7cdbfad533625a550a416fda/MaterialLib/SolidModels/LinearElasticIsotropic.h","locator":"MaterialProperties::lambda, mu, bulk_modulus; elasticTangentStiffness","role":"Pinned reference formulation"},{"url":"https://github.com/ufz/ogs/blob/b5d0f115c75ee74a7cdbfad533625a550a416fda/MaterialLib/SolidModels/LinearElasticIsotropic.cpp","locator":"LinearElasticIsotropic::integrateStress; sigma_prev + C * (eps_m - eps_m_prev)","role":"Pinned incremental stress update"},{"url":"https://github.com/benjym/constitutive-atlas/blob/main/docs/models/linear-elastic.md","locator":"Equation mapping; project-specific void-ratio bookkeeping and small-strain limits","role":"Transcription dossier"}],"equations":{"sigma":"sigma - sigma_n - K * trace(de) * I - 2 * G * dev(de)","e":"e - (1 + e_n) * exp(-trace(de)) + 1"}},{"schema_version":"0.1","status":"transcribed","parameters":{"p_ref":{"default":100000,"min":1,"max":10000000000.0,"unit":"Pa","label":"Reference stress / numerical scaling"},"M":{"default":1.2,"min":0.1,"max":3,"unit":"1","label":"Critical-state slope"},"lambda_c":{"default":0.2,"min":0.001,"max":1,"unit":"1","label":"Virgin compression index"},"kappa":{"default":0.04,"min":0.0001,"max":0.5,"unit":"1","label":"Swelling index"},"nu":{"default":0.25,"min":-0.9,"max":0.49,"unit":"1","label":"Poisson ratio"}},"state":[{"name":"sigma","unit":"Pa","initial":[100000.0,100000.0,100000.0,0,0,0],"shape":"sym","scale":"p_ref"},{"name":"e","unit":"1","initial":0.7,"shape":"scalar","scale":"1"},{"name":"pc","unit":"Pa","initial":200000,"shape":"scalar","scale":"p_ref"},{"name":"gamma","unit":"1","initial":0,"shape":"scalar","scale":"1","transient":true,"multiplier":true}],"derived":[{"name":"mean","expr":"trace(sigma) / 3"},{"name":"q2","expr":"1.5 * dot(dev(sigma),dev(sigma))"},{"name":"K","expr":"(1 + e) * mean / kappa"},{"name":"G","expr":"3 * K * (1 - 2 * nu) / (2 * (1 + nu))"},{"name":"yield_scaled","expr":"(q2 + M**2 * mean * (mean - pc)) / p_ref**2"},{"name":"plastic_volume","expr":"gamma * M**2 * (2 * mean - pc) / pc_n"}],"domain":["e > 0","lambda_c > kappa","mean > p_ref * 1e-8","pc > p_ref * 1e-8","gamma > -1e-9"],"integration":"residual","id":"modified-cam-clay","name":"Modified Cam Clay","family":"critical-state plasticity","description":"Associated Modified Cam Clay with endpoint pressure/void-ratio dependent elasticity, exponential log-pc hardening and exponential volume bookkeeping. Project finite-step choices documented in the source dossier; demonstration initialization; finite rotation unsupported.","sources":[{"url":"https://github.com/ufz/ogs/blob/b5d0f115c75ee74a7cdbfad533625a550a416fda/web/content/docs/benchmarks/small-deformations/ModifiedCamClay/ModifiedCamClay_report.pdf","locator":"Silbermann & Nagel, 28 June 2023: equations 14\u201317 and 30b; equation 11 prints M while 30b uses M squared. Section 3.1 hardening differs from atlas exponential log-pc update. Project discretization and normalization: docs/models/modified-cam-clay.md.","role":"formulation"},{"url":"https://docs.itascacg.com/itasca930/common/models/camclay/doc/modelcamclay.html","locator":"Equations 15, 18\u201325: stiffness, yield and associated flow; 31 and 8 have different finite-step hardening/volume updates. Initialization: 32 and 42. Not an executed cross-code comparison.","role":"formulation reference"}],"equations":{"sigma":"sigma - sigma_n - K * trace(de) * I - 2 * G * dev(de) + gamma * (6 * G * dev(sigma) / pc_n + K * M**2 * (2 * mean - pc) / pc_n * I)","e":"e - (1 + e_n) * exp(-trace(de)) + 1","pc":"pc - pc_n * exp((1 + e) * plastic_volume / (lambda_c - kappa))","gamma":"sqrt(gamma**2 + yield_scaled**2) - gamma + yield_scaled"},"initial_checks":["yield_scaled <= 1e-8"]},{"schema_version":"0.3","id":"s-clay1","name":"S-CLAY1 \u2014 Wheeler et al. (2003)","family":"anisotropic critical-state plasticity","status":"transcribed","description":"Original constant-M full 3D S-CLAY1 with associated flow, isotropic pressure-dependent elasticity and volumetric/shear rotational hardening. Atlas endpoint implicit elasticity/fabric and exponential volume/size discretization. Fixed-frame infinitesimal strain; illustrative Otaniemi parameters, no bonding, creep or finite-rotation transport.","sources":[{"url":"https://doi.org/10.1139/T02-119","locator":"Wheeler et al.2003 CGJ40 pp403\u2013418: Eq1 elasticity; Eqs2\u20135,7\u20139 yield/flow/hardening; AppendixA1\u2013A14 tensor generalization. ConstantM option p404/407/413. Atlas finite-step choices: source packet supplied-original-v3/README.md.","role":"original governing formulation"}],"parameters":{"p_ref":{"default":20000,"min":1,"max":1000000000.0,"unit":"Pa","label":"Numerical stress scale"},"M":{"default":1.1,"min":0.1,"max":3,"unit":"1","label":"Critical-state stress ratio"},"lambda_c":{"default":0.44,"min":0.001,"max":2,"unit":"1","label":"Virgin compression slope"},"kappa":{"default":0.04,"min":0.0001,"max":1,"unit":"1","label":"Elastic swelling slope"},"nu":{"default":0.2,"min":-0.9,"max":0.49,"unit":"1","label":"Elastic Poisson ratio"},"beta":{"default":0.67,"min":0,"max":10,"unit":"1","label":"Relative shear contribution to fabric rotation"},"mu":{"default":20,"min":0,"max":1000,"unit":"1","label":"Fabric rotation rate"}},"formulation":{"time_dependence":"strain_path","equation_form":"incremental_residual","kinematics":"small_strain_3d","frame":"fixed_spatial","objective_rate":"none","tensor_representation":"mandel","stress_sign":"compression_positive","strain_sign":"compression_positive","inputs":{"equation":{"de":{"quantity":"strain_increment","measure":"infinitesimal_strain","shape":"sym","unit":"1","configuration":"current","sampling":"increment","constraint":"finite"}},"advance":{}},"stress":{"source":"state","name":"sigma","measure":"cauchy","scope":"effective"}},"state":[{"name":"sigma","shape":"sym","unit":"Pa","initial":[20000,12500,12500,0,0,0],"scale":"p_ref","semantics":{"role":"persistent","quantity":"cauchy_stress","transformation":"symmetric_spatial_tensor"}},{"name":"fabric","shape":"sym","unit":"1","initial":[0.28,-0.14,-0.14,0,0,0],"scale":"1","semantics":{"role":"persistent","quantity":"deviatoric_fabric_tensor","transformation":"symmetric_spatial_tensor"}},{"name":"v","shape":"scalar","unit":"1","initial":3.46,"scale":"1","semantics":{"role":"persistent","quantity":"specific_volume","transformation":"scalar_invariant"}},{"name":"pm","shape":"scalar","unit":"Pa","initial":17600,"scale":"p_ref","semantics":{"role":"persistent","quantity":"yield_surface_size","transformation":"scalar_invariant"}},{"name":"gamma","shape":"scalar","unit":"1","initial":0,"scale":"1","semantics":{"role":"plastic_multiplier","quantity":"scaled_incremental_plastic_multiplier","transformation":"scalar_invariant"}}],"initialization":{"method":"explicit_state","default_policy":"examples_only","required_state":["sigma","fabric","v","pm"],"validation":"domain_and_initial_checks"},"derived":[{"name":"mean","expr":"trace(sigma) / 3"},{"name":"sdev","expr":"dev(sigma)"},{"name":"a2","expr":"1.5 * dot(fabric,fabric)"},{"name":"shift","expr":"sdev - mean * fabric"},{"name":"yield_dim","expr":"1.5 * dot(shift,shift) - (M**2 - a2) * (pm - mean) * mean"},{"name":"yield_scaled","expr":"yield_dim / p_ref**2"},{"name":"flow_volume","expr":"2 * M**2 * mean - 3 * dot(sdev,fabric) - (M**2 - a2) * pm"},{"name":"flow_dev","expr":"3 * shift"},{"name":"plastic_volume","expr":"gamma * flow_volume / p_ref"},{"name":"plastic_shear","expr":"gamma * sqrt(2.0 / 3.0) * norm(flow_dev) / p_ref"},{"name":"K","expr":"v * mean / kappa"},{"name":"G","expr":"3 * K * (1 - 2 * nu) / (2 * (1 + nu))"}],"equations":{"sigma":"sigma - sigma_n - K * (trace(de) - plastic_volume) * I - 2 * G * (dev(de) - gamma * flow_dev / p_ref)","fabric":"fabric - fabric_n - mu * ((3 * sdev / (4 * mean) - fabric) * max(plastic_volume, 0) + beta * (sdev / (3 * mean) - fabric) * plastic_shear)","v":"v - v_n * exp(-trace(de))","pm":"pm - pm_n * exp(v * plastic_volume / (lambda_c - kappa))","gamma":"sqrt(gamma**2 + yield_scaled**2) - gamma + yield_scaled"},"domain":["lambda_c > kappa","mean > 0 * p_ref","pm > 0 * p_ref","v > 1","M**2 > a2","abs(trace(fabric)) < 1e-9","gamma > -1e-9"],"initial_checks":["yield_scaled <= 1e-8"]}]}
