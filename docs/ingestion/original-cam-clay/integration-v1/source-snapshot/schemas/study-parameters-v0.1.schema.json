{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://benjym.github.io/constitutive-atlas/schemas/study-parameters-v0.1.schema.json",
  "title": "Historical development study parameter accounting",
  "description": "Structural contract; semantic validation binds exact definitions/allocation and checks complete parameter coverage, values, units, ranges and provenance. Does not certify scientific applicability or a prospective CAL-02 freeze.",
  "type": "object",
  "required": [
    "schema_version",
    "kind",
    "id",
    "phase",
    "allocation_sha256",
    "models",
    "limitations"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "kind": {
      "const": "study-parameter-policy"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "phase": {
      "const": "historical_development"
    },
    "allocation_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "models": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "definition_sha256",
          "parameters"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "definition_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "parameters": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {
              "oneOf": [
                {
                  "type": "object",
                  "required": [
                    "category",
                    "value",
                    "unit",
                    "provenance",
                    "role",
                    "bounds",
                    "transform"
                  ],
                  "properties": {
                    "category": {
                      "enum": [
                        "material",
                        "numerical_scale",
                        "specialization"
                      ]
                    },
                    "value": {
                      "type": "number"
                    },
                    "unit": {
                      "type": "string",
                      "minLength": 1
                    },
                    "provenance": {
                      "type": "object",
                      "required": [
                        "kind",
                        "locator"
                      ],
                      "properties": {
                        "kind": {
                          "enum": [
                            "definition_default",
                            "literature",
                            "analyst_choice"
                          ]
                        },
                        "locator": {
                          "type": "string",
                          "minLength": 1
                        },
                        "url": {
                          "type": "string",
                          "pattern": "^https?://"
                        }
                      },
                      "additionalProperties": false,
                      "if": {
                        "properties": {
                          "kind": {
                            "const": "literature"
                          }
                        }
                      },
                      "then": {
                        "required": [
                          "url"
                        ]
                      }
                    },
                    "role": {
                      "const": "fitted"
                    },
                    "bounds": {
                      "type": "array",
                      "minItems": 2,
                      "maxItems": 2,
                      "items": {
                        "type": "number"
                      }
                    },
                    "transform": {
                      "enum": [
                        "linear",
                        "log"
                      ]
                    }
                  },
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "required": [
                    "category",
                    "value",
                    "unit",
                    "provenance",
                    "role"
                  ],
                  "properties": {
                    "category": {
                      "enum": [
                        "material",
                        "numerical_scale",
                        "specialization"
                      ]
                    },
                    "value": {
                      "type": "number"
                    },
                    "unit": {
                      "type": "string",
                      "minLength": 1
                    },
                    "provenance": {
                      "type": "object",
                      "required": [
                        "kind",
                        "locator"
                      ],
                      "properties": {
                        "kind": {
                          "enum": [
                            "definition_default",
                            "literature",
                            "analyst_choice"
                          ]
                        },
                        "locator": {
                          "type": "string",
                          "minLength": 1
                        },
                        "url": {
                          "type": "string",
                          "pattern": "^https?://"
                        }
                      },
                      "additionalProperties": false,
                      "if": {
                        "properties": {
                          "kind": {
                            "const": "literature"
                          }
                        }
                      },
                      "then": {
                        "required": [
                          "url"
                        ]
                      }
                    },
                    "role": {
                      "const": "fixed"
                    }
                  },
                  "additionalProperties": false
                }
              ]
            }
          }
        },
        "additionalProperties": false
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "additionalProperties": false
}
