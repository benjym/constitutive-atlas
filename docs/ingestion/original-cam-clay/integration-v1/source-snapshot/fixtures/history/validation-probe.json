{
  "schema_version": "experimental-history-0.1",
  "id": "synthetic-validation-history",
  "sources": [
    {
      "url": "https://github.com/benjym/constitutive-atlas/blob/main/docs/HISTORY_TRANSACTIONS.md",
      "locator": "Synthetic finite-intermediate and transactional rollback acceptance probe."
    }
  ],
  "fields": {
    "x": {
      "shape": "scalar",
      "unit": "1",
      "storage": "state"
    }
  },
  "inputs": {
    "gate": {
      "shape": "scalar",
      "unit": "1"
    },
    "value": {
      "shape": "scalar",
      "unit": "1"
    }
  },
  "phases": [
    {
      "name": "validate",
      "kind": "advance",
      "base": "parent",
      "guard": "min(exp(gate),1)-2",
      "bindings": {
        "gate": {
          "input": "gate"
        },
        "value": {
          "input": "value"
        }
      },
      "writes": {
        "x": "value"
      },
      "checks": [
        "exp(x) > 0"
      ]
    }
  ]
}
