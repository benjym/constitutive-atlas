  "state": [
    {
      "name": "sigma_net",
      "shape": "sym",
      "unit": "Pa",
      "initial": [
        5185790.988798023,
        5185790.988798023,
        5185790.988798023,
        0,
        0,
        0
      ],
      "scale": "pr",
      "semantics": {
        "role": "persistent",
        "quantity": "net_cauchy_stress",
        "transformation": "symmetric_spatial_tensor"
      }
    },
    {
      "name": "e",
      "shape": "scalar",
      "unit": "1",
      "initial": 0.725,
      "scale": "1",
      "semantics": {
        "role": "persistent",
        "quantity": "global_void_ratio",
        "transformation": "scalar_invariant"
      }
    },
    {
      "name": "a_scan",
      "shape": "scalar",
      "unit": "1",
      "initial": 0,
