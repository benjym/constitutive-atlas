      "semantics": {
        "role": "persistent",
        "quantity": "hydraulic_scanning_memory",
        "transformation": "scalar_invariant"
      }
    }
  ],
  "derived": [
    {
      "name": "source_sigma",
      "expr": "-sigma_net"
    },
    {
      "name": "source_rate",
      "expr": "-strain_rate"
    },
    {
      "name": "thermal_factor",
      "expr": "(thermal_a+thermal_b*temperature)/(thermal_a+thermal_b*Tr)"
    },
    {
      "name": "pm",
      "expr": "-trace(source_sigma)/3+suction"
    },
    {
      "name": "em",
      "expr": "em_ref*exp(-(pm/hms)**nm)*thermal_factor"
    },
    {
      "name": "eM",
      "expr": "(e-em)/(1+em)"
    },
    {
      "name": "sen",
      "expr": "se_ref*eM_ref/eM*thermal_factor"
    },
    {
      "name": "se",
      "expr": "sen*(ae+a_scan-ae*a_scan)"
    },
    {
      "name": "retention_power",
      "expr": "(se/suction)**lp"
    },
    {
      "name": "SM",
      "expr": "1-exp(-retention_power)"
    },
    {
      "name": "sigmaM",
      "expr": "source_sigma-SM*suction*I"
    },
    {
      "name": "pM",
      "expr": "-trace(sigmaM)/3"
    },
    {
      "name": "macro_dev",
      "expr": "dev(sigmaM)"
    },
    {
      "name": "macro_dev_sq",
      "expr": "dot(macro_dev,macro_dev)"
    },
    {
      "name": "macro_dev_det",
      "expr": "determinant(macro_dev)"
    },
    {
      "name": "invariant_denominator",
      "expr": "8*pM**3-pM*macro_dev_sq+macro_dev_det"
    },
    {
      "name": "Fm",
      "expr": "(3*pM*macro_dev_sq+9*macro_dev_det)/invariant_denominator"
    },
    {
      "name": "shat",
      "expr": "sigmaM/trace(sigmaM)-I/3"
    },
    {
      "name": "shat_sq",
      "expr": "dot(shat,shat)"
    },
    {
      "name": "cos3theta",
      "expr": "select(shat_sq>0,-sqrt(6)*cube_trace(shat)/shat_sq**1.5,0)"
    },
    {
      "name": "omega",
      "expr": "-log(cos(phi)**2)/log(Oc)+0.3*(Fm-sin(phi)**2)"
    },
    {
      "name": "Nst",
      "expr": "Nref-ns/lp*log(SM)+nT*log(temperature/Tr)"
    },
    {
      "name": "lam",
      "expr": "lambda_ref-ls/lp*log(SM)+lT*log(temperature/Tr)"
    },
    {
      "name": "pe",
      "expr": "pr*exp((Nst-log(1+e))/lam)"
    },
    {
      "name": "OI",
      "expr": "pe/pM"
    },
    {
      "name": "OA",
      "expr": "OI*(1-Fm)**(1/omega)"
    },
    {
      "name": "eA",
      "expr": "exp(log(1+e)+lam*log(OA))-1"
    },
    {
      "name": "re",
      "expr": "(e-em)/(eA-em)"
    },
    {
      "name": "fm",
      "expr": "1-re**coupling_m"
    },
    {
      "name": "fscan",
      "expr": "select(suction_rate>0*pr*Dr,a_scan,select(suction_rate<0*pr*Dr,1-a_scan,0))"
    },
    {
      "name": "rlambda",
      "expr": "0.1+0.9*fscan**3"
    },
    {
      "name": "DsS",
      "expr": "rlambda/suction*(1-SM)*lp*log(1-SM)"
    },
    {
      "name": "DseS",
      "expr": "-(1-SM)*lp*log(1-SM)/se"
    },
    {
      "name": "DeMse",
      "expr": "-se/eM"
    },
    {
      "name": "DTse",
      "expr": "se*thermal_b/(thermal_a+thermal_b*temperature)"
    },
    {
      "name": "Dp",
      "expr": "-em*nm/pm*(pm/hms)**nm"
    },
    {
      "name": "DTm",
      "expr": "em*thermal_b/(thermal_a+thermal_b*temperature)"
    },
    {
      "name": "Aact",
      "expr": "DseS*se/(lp*SM)*(ns-ls*log(pM/pr))"
    },
    {
      "name": "lact_denominator",
      "expr": "eM*(1+em)-Aact*(1+e)"
    },
    {
      "name": "lact",
      "expr": "(eM*(1+em)*lam+Aact*Dp*pM*(1+eM))/lact_denominator"
    },
    {
      "name": "fs",
      "expr": "3*pM/2*(lact+kappa)/(lact*kappa)*(1-2*nu)/(1+nu)"
    },
    {
      "name": "ci_denominator",
      "expr": "(lact+kappa)*(OI**alpha_f-OA**alpha_f)+2*kappa*OA**alpha_f"
    },
    {
      "name": "ci",
      "expr": "((lact+kappa)*(OI**alpha_f-1)+2*kappa)/ci_denominator"
    },
    {
      "name": "fu",
      "expr": "OA**(-coupling_m)"
    },
    {
      "name": "DsP",
      "expr": "-pe*DsS/(lp*SM*lam)*(ns-ls*log(pe/pr))"
    },
    {
      "name": "DTP",
      "expr": "pe/(temperature*lam)*(nT-lT*log(pe/pr))"
    },
    {
      "name": "sign_Ds",
      "expr": "select(DsP<0,1,select(DsP>0,-1,0))"
    },
    {
      "name": "sign_DT",
      "expr": "select(DTP<0*pr/Tr,1,select(DTP>0*pr/Tr,-1,0))"
    },
    {
      "name": "Hs_prime",
      "expr": "ci*sigmaM*DsP/pe*sign_Ds*select(-DsP*suction_rate>=0*pr*Dr,1,0)"
    },
    {
      "name": "HT_prime",
      "expr": "ci*sigmaM*DTP/pe*sign_DT*select(-DTP*temperature_rate>=0*pr*Dr,1,0)"
    },
    {
      "name": "dB",
      "expr": "nu/(1-2*nu)"
    },
    {
      "name": "bB",
      "expr": "-DseS*DeMse*suction*(1+eM)*Dp/(3*(1+em))"
    },
    {
      "name": "cB",
      "expr": "-fs*fm*Dp/(9*(1+em))"
    },
    {
      "name": "qB",
      "expr": "bB+cB+3*cB*dB"
    },
    {
      "name": "B_denominator",
      "expr": "1+3*qB"
    },
    {
      "name": "d_raw",
      "expr": "-shat+I*(2/3-(cos3theta+1)/4*Fm**0.25)*(Fm**(xi/2)-sin(phi)**xi)/(1-sin(phi)**xi)"
    },
    {
      "name": "d_direction",
      "expr": "d_raw/norm(d_raw)"
    },
    {
      "name": "Ad",
      "expr": "fs*(d_direction+dB*trace(d_direction)*I)+sigmaM*trace(d_direction)/lact"
    },
    {
      "name": "Iv",
      "expr": "0.004+IvT*((temperature-Tr)/one_kelvin)**3*0.00000001"
    },
    {
      "name": "NE",
      "expr": "(vf-1)*OA**(-alpha_f)*Ad"
    },
    {
      "name": "NVE",
      "expr": "-vf*OA**(-1/Iv)*Ad"
    },
    {
      "name": "HLsE",
      "expr": "-Dp*fs*fm/(3*(1+em))*(1+3*dB)*I+(DsS*suction+SM-Dp*DseS*DeMse*suction*(1+eM)/(1+em))*I"
    },
    {
      "name": "HNsE",
      "expr": "fu*Hs_prime-sqrt(3)*frm*fm/3*NE*abs(Dp)/(1+em)"
    },
    {
      "name": "HLTE",
      "expr": "-alpha_s*fs*fm/3*(1+3*dB)*I+DseS*suction*(DTse-DeMse*DTm*(1+eM)/(1+em))*I"
    },
    {
      "name": "HNTE",
      "expr": "fu*HT_prime-sqrt(3)*frm*fm/3*NE*abs(alpha_s)"
    },
    {
      "name": "LE_rate",
      "expr": "fs*(source_rate+dB*trace(source_rate)*I)+DseS*DeMse*suction*(1+eM)*trace(source_rate)*I"
    },
    {
      "name": "source_rhs",
      "expr": "LE_rate+NE*norm(source_rate)+NVE*Dr+HLsE*suction_rate+HNsE*abs(suction_rate)+HLTE*temperature_rate+HNTE*abs(temperature_rate)"
    },
    {
      "name": "source_stress_rate",
      "expr": "source_rhs-qB/B_denominator*trace(source_rhs)*I"
    },
    {
      "name": "Sr_value",
      "expr": "SM+em/e*(1-SM)"
    }
  ],
  "equations": {
    "sigma_net": "-source_stress_rate",
    "e": "-(1+e)*trace(strain_rate)",
    "a_scan": "(se/sen)*(1-rlambda)/(suction*(1-ae))*suction_rate"
  },
  "domain": [
    "suction>0*pr",
    "temperature>0*Tr",
    "thermal_factor>0",
    "pm>0*pr",
    "e>0",
    "em>0",
    "eM>0",
    "a_scan>=0",
    "a_scan<=1",
    "SM>0",
    "SM<1",
    "pM>0*pr",
    "abs(invariant_denominator)>0*pr**3",
    "Fm>=0",
    "Fm<1",
    "omega>0",
    "lam>0",
    "pe>0*pr",
    "OI>0",
    "OA>=1",
    "eA>em",
    "re>0",
    "abs(lact_denominator)>0",
    "lact>0",
    "abs(ci_denominator)>0",
    "abs(B_denominator)>0",
    "Iv>0",
    "norm(d_raw)>0",
    "Sr_value>=0",
    "Sr_value<=1"
  ],
  "observables": [
    {
      "name": "stress",
