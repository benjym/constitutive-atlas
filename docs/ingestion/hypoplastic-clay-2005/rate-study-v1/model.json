{
  "schema_version": "0.1",
  "id": "hypoplastic-clay-2005-appc-eq40-research",
  "name": "Mašín2005 AppendixC/Eq40 zero-spin research draft",
  "family": "hypoplasticity",
  "description": "Original five-parameter base, compression-positive full7rate. Printed main Eq38 unloading sign conflicts with Eq40 and AppendixC; this explicit variant follows AppendixC/Eq40. Raw-Lode margin and nonzero j2 floor are project arithmetic support rejections, no clipping. Final publisher equivalence, near-isotropic accuracy and scientific admission remain unresolved.",
  "status": "draft",
  "sources": [
    {
      "url": "https://doi.org/10.1002/nag.416",
      "locator": "Main2005 AppendixC Eqs73-85 pp24-25, unloading Eq40/41 p10; Eq38 conflict retained",
      "role": "primary publication"
    },
    {
      "url": "https://web.natur.cuni.cz/uhigug/masin/download/MasinIJNAMG05-pp.pdf",
      "locator": "Accepted manuscript SHA2568650dd58a4b5725dc0176ab9cf3a034ed211847b840524254876c2652bdf9ff3",
      "role": "pinned author source"
    },
    {
      "url": "https://doi.org/10.1016/j.compgeo.2005.09.001",
      "locator": "Companion2005 p9 Eq25 density; SOM differs from SBS pp12-14",
      "role": "density and initialization context"
    }
  ],
  "integration": "rate",
  "parameters": {
    "p_ref": {
      "default": 1000,
      "min": 1000,
      "max": 1000,
      "unit": "Pa",
      "label": "Fixed source reference pressure"
    },
    "p_scale": {
      "default": 100000,
      "min": 1,
      "max": 1000000000000.0,
      "unit": "Pa",
      "label": "Numerical stress error scale, not material calibration"
    },
    "phi_c": {
      "default": 0.3944444109507185,
      "min": 0.01,
      "max": 1.4,
      "unit": "1",
      "label": "Critical angle radians"
    },
    "lambda_star": {
      "default": 0.11,
      "min": 0.0001,
      "max": 1.0,
      "unit": "1",
      "label": "NCL slope"
    },
    "kappa_star": {
      "default": 0.016,
      "min": 1e-05,
      "max": 1.0,
      "unit": "1",
      "label": "Initial NCL unloading slope"
    },
    "N": {
      "default": 1.375,
      "min": -10.0,
      "max": 10.0,
      "unit": "1",
      "label": "Log density intercept at1000Pa"
    },
    "r": {
      "default": 0.4,
      "min": 0.01,
      "max": 10.0,
      "unit": "1",
      "label": "Initial NCL Ki/Gi"
    },
    "lode_allowance": {
      "default": 1.4210854715202004e-14,
      "min": 1.4210854715202004e-14,
      "max": 1.4210854715202004e-14,
      "unit": "1",
      "label": "Fixed raw Lode admissibility margin, no clipping"
    },
    "j2_floor": {
      "default": 1e-100,
      "min": 1e-100,
      "max": 1e-100,
      "unit": "1",
      "label": "Project nonzero-deviator support floor; smaller nonzero values rejected"
    }
  },
  "state": [
    {
      "name": "sigma",
      "shape": "sym",
      "unit": "Pa",
      "initial": [
        100000,
        100000,
        100000,
        0,
        0,
        0
      ],
      "scale": "p_scale"
    },
    {
      "name": "e",
      "shape": "scalar",
      "unit": "1",
      "initial": 0.8,
      "scale": "1"
    }
  ],
  "derived": [
    {
      "name": "p",
      "expr": "trace(sigma)/3"
    },
    {
      "name": "H",
      "expr": "sigma/trace(sigma)"
    },
    {
      "name": "Hdev",
      "expr": "dev(dev(sigma))/trace(sigma)"
    },
    {
      "name": "j2",
      "expr": "dot(Hdev,Hdev)"
    },
    {
      "name": "j3",
      "expr": "cube_trace(Hdev)"
    },
    {
      "name": "detH",
      "expr": "1/27-j2/6+j3/3"
    },
    {
      "name": "pairH",
      "expr": "1/3-j2/2"
    },
    {
      "name": "a",
      "expr": "sqrt(3)*(3-sin(phi_c))/(2*sqrt(2)*sin(phi_c))"
    },
    {
      "name": "Q",
      "expr": "3+a*a"
    },
    {
      "name": "alpha",
      "expr": "log(((lambda_star-kappa_star)/(lambda_star+kappa_star))*Q/(a*sqrt(3)))/log(2)"
    },
    {
      "name": "Delta",
      "expr": "Q-2**alpha*a*sqrt(3)"
    },
    {
      "name": "c1",
      "expr": "2*Delta/(9*r)"
    },
    {
      "name": "c2",
      "expr": "1+(1-c1)*3/(a*a)"
    },
    {
      "name": "Yi",
      "expr": "sqrt(3)*a/Q"
    },
    {
      "name": "Y",
      "expr": "Yi+(1-Yi)*(j2-3*j3)*cos(phi_c)**2/(8*detH*sin(phi_c)**2)"
    },
    {
      "name": "raw_lode",
      "expr": "select(j2 >= j2_floor,-sqrt(6)*j3/j2**(3/2),0)"
    },
    {
      "name": "tanpsi",
      "expr": "sqrt(3*j2)"
    },
    {
      "name": "F",
      "expr": "sqrt(tanpsi**2/8+(2-tanpsi**2)/(2+sqrt(2)*tanpsi*raw_lode))-tanpsi/(2*sqrt(2))"
    },
    {
      "name": "m",
      "expr": "select(j2 > 0,-a/F*(H+Hdev-(H/3)*(6*dot(H,H)-1)/((F/a)**2+dot(H,H))),(-a/Q)*I)"
    },
    {
      "name": "m_unit",
      "expr": "m/norm(m)"
    },
    {
      "name": "pe",
      "expr": "p_ref*exp((N-log1p(e))/lambda_star)"
    },
    {
      "name": "fd",
      "expr": "(2*p/pe)**alpha"
    },
    {
      "name": "fs",
      "expr": "3*p/(lambda_star*Delta)"
    },
    {
      "name": "LE",
      "expr": "3*(c1*de+c2*a*a*H*dot(H,de))"
    },
    {
      "name": "Lm",
      "expr": "3*(c1*m_unit+c2*a*a*H*dot(H,m_unit))"
    },
    {
      "name": "stress_rate",
      "expr": "fs*(LE+fd*Y*Lm*norm(de))"
    },
    {
      "name": "e_rate",
      "expr": "-(1+e)*trace(de)"
    },
    {
      "name": "sphere_residual",
      "expr": "abs(dot(sigma,sym(1,-1,0,0,0,0)))+abs(dot(sigma,sym(0,1,-1,0,0,0)))+abs(dot(sigma,sym(0,0,0,1,0,0)))+abs(dot(sigma,sym(0,0,0,0,1,0)))+abs(dot(sigma,sym(0,0,0,0,0,1)))"
    }
  ],
  "equations": {
    "sigma": "stress_rate",
    "e": "e_rate"
  },
  "domain": [
    "e >= 0",
    "lambda_star > kappa_star",
    "alpha > 0",
    "p > 0*p_ref",
    "pairH > 0",
    "detH > 0",
    "c1 > 0",
    "c1+c2*a*a*dot(H,H) > 0",
    "select(j2 > 0,j2/j2_floor,1) >= 1",
    "select(j2 > 0,0*p_ref,sphere_residual) <= 0*p_ref",
    "raw_lode >= -1-lode_allowance",
    "raw_lode <= 1+lode_allowance",
    "F > 0",
    "Y > 0",
    "norm(m) > 0",
    "pe > 0*p_ref",
    "fd > 0",
    "fs > 0*p_ref",
    "abs(j2) <= 1e250",
    "abs(j3) <= 1e250",
    "abs(detH) <= 1e250",
    "abs(pairH) <= 1e250",
    "abs(a) <= 1e250",
    "abs(Q) <= 1e250",
    "abs(alpha) <= 1e250",
    "abs(Delta) <= 1e250",
    "abs(c1) <= 1e250",
    "abs(c2) <= 1e250",
    "abs(Yi) <= 1e250",
    "abs(Y) <= 1e250",
    "abs(raw_lode) <= 1e250",
    "abs(tanpsi) <= 1e250",
    "abs(F) <= 1e250",
    "abs(fd) <= 1e250",
    "abs(e_rate) <= 1e250",
    "norm(m) <= 1e250",
    "norm(m_unit) <= 1e250",
    "norm(LE) <= 1e250",
    "norm(Lm) <= 1e250",
    "abs(p) <= p_ref*1e250",
    "abs(pe) <= p_ref*1e250",
    "abs(fs) <= p_ref*1e250",
    "norm(stress_rate) <= p_ref*1e250"
  ]
}
