{
  "schema_version": "0.3",
  "id": "hypoplastic-clay-2005-appc-plus-spd-interior-v3-research",
  "name": "Mašín2005 AppendixC/source-plus conservative SPD interior — v0.3 rate candidate",
  "family": "hypoplasticity",
  "description": "Original five-physical-parameter AppendixC base, zero spin, compression-positive full7rate research draft. Additive correction: pinned manuscript Eq38 has PLUS unloading bracket, consistent withEq40 and AppendixC; previous minus claim is historical extraction error. Same source rate algebra asv1. Separate normalized Cartesian/Mandel diagonal/minor64epsilon guards restrict numerical interior; not certifiedSPD theorem. RawLode margin and j2 floor unchanged; no clipping. No near-isotropic/near-singular rate accuracy, finite integration or admission claim. Explicit v0.3 strain-path contract; persistent effective Cauchy stress and scalar void ratio, infinitesimal fixed spatial zero-spin restriction. Accepted manuscript, not final-publisher equivalence. London-clay source calibration defaults are not universal clay parameters; illustrative stress/e is not a prepared specimen. No inferred initialization, finite-path verification or scientific admission.",
  "status": "draft",
  "sources": [
    {
      "url": "https://doi.org/10.1002/nag.416",
      "locator": "Mašín2005 accepted manuscript AppendixC Eqs73–85 pp24–25; p10 Eq38 PLUS bracket consistent withEqs40–41. Historical minus claim corrected additively.",
      "role": "primary publication"
    },
    {
      "url": "https://web.natur.cuni.cz/uhigug/masin/download/MasinIJNAMG05-pp.pdf",
      "locator": "Accepted manuscript SHA2568650dd58a4b5725dc0176ab9cf3a034ed211847b840524254876c2652bdf9ff3",
      "role": "pinned author source"
    },
    {
      "url": "https://doi.org/10.1016/j.compgeo.2005.09.001",
      "locator": "Companion2005 p9 Eq25 density; SOM differs from SBS pp12-14",
      "role": "density and initialization context"
    },
    {
      "url": "https://github.com/benjym/constitutive-atlas/blob/main/docs/ingestion/hypoplastic-clay-2005/rate-study-v2/SOURCE_CORRECTION.md",
      "role": "Additive correction to earlier Atlas extraction",
      "locator": "Pinned accepted manuscript p10Eq38 is PLUS, consistent withEq40/AppendixC; no author-equation correction or rate change."
    },
    {
      "url": "https://github.com/benjym/constitutive-atlas/blob/main/docs/ingestion/hypoplastic-clay-2005/guard-review-v2/README.md",
      "role": "Conservative support and compiled-corpus scope",
      "locator": "41accuracy cases distinct from29support witnesses;10finite-only accepted,19excluded; not an all-SPD or near-boundary accuracy theorem."
    }
  ],
  "parameters": {
    "p_ref": {
      "default": 1000,
      "min": 1000,
      "max": 1000,
      "unit": "Pa",
      "label": "Fixed source reference pressure"
    },
    "p_scale": {
      "default": 100000,
      "min": 1,
      "max": 1000000000000.0,
      "unit": "Pa",
      "label": "Numerical stress error scale, not material calibration"
    },
    "phi_c": {
      "default": 0.3944444109507185,
      "min": 0.01,
      "max": 1.4,
      "unit": "1",
      "label": "Critical angle radians"
    },
    "lambda_star": {
      "default": 0.11,
      "min": 0.0001,
      "max": 1.0,
      "unit": "1",
      "label": "NCL slope"
    },
    "kappa_star": {
      "default": 0.016,
      "min": 1e-05,
      "max": 1.0,
      "unit": "1",
      "label": "Initial NCL unloading slope"
    },
    "N": {
      "default": 1.375,
      "min": -10.0,
      "max": 10.0,
      "unit": "1",
      "label": "Log density intercept at1000Pa"
    },
    "r": {
      "default": 0.4,
      "min": 0.01,
      "max": 10.0,
      "unit": "1",
      "label": "Initial NCL Ki/Gi"
    },
    "lode_allowance": {
      "default": 1.4210854715202004e-14,
      "min": 1.4210854715202004e-14,
      "max": 1.4210854715202004e-14,
      "unit": "1",
      "label": "Fixed raw Lode admissibility margin, no clipping"
    },
    "j2_floor": {
      "default": 1e-100,
      "min": 1e-100,
      "max": 1e-100,
      "unit": "1",
      "label": "Project nonzero-deviator support floor; smaller nonzero values rejected"
    }
  },
  "state": [
    {
      "name": "sigma",
      "shape": "sym",
      "unit": "Pa",
      "initial": [
        100000,
        100000,
        100000,
        0,
        0,
        0
      ],
      "scale": "p_scale",
      "semantics": {
        "role": "persistent",
        "quantity": "cauchy_stress",
        "transformation": "symmetric_spatial_tensor"
      }
    },
    {
      "name": "e",
      "shape": "scalar",
      "unit": "1",
      "initial": 0.8,
      "scale": "1",
      "semantics": {
        "role": "persistent",
        "quantity": "void_ratio",
        "transformation": "scalar_invariant"
      }
    }
  ],
  "derived": [
    {
      "name": "support_scaled_stress",
      "expr": "sigma/p_ref"
    },
    {
      "name": "support_norm",
      "expr": "norm(support_scaled_stress)"
    },
    {
      "name": "support_unit",
      "expr": "select(support_norm > 0,support_scaled_stress/support_norm,0*I)"
    },
    {
      "name": "support_xx",
      "expr": "dot(support_unit,sym(1,0,0,0,0,0))"
    },
    {
      "name": "support_yy",
      "expr": "dot(support_unit,sym(0,1,0,0,0,0))"
    },
    {
      "name": "support_zz",
      "expr": "dot(support_unit,sym(0,0,1,0,0,0))"
    },
    {
      "name": "support_xy",
      "expr": "dot(support_unit,sym(0,0,0,1,0,0))"
    },
    {
      "name": "support_yz",
      "expr": "dot(support_unit,sym(0,0,0,0,1,0))"
    },
    {
      "name": "support_xz",
      "expr": "dot(support_unit,sym(0,0,0,0,0,1))"
    },
    {
      "name": "support_minor2",
      "expr": "support_xx*support_yy-support_xy**2/2"
    },
    {
      "name": "support_det",
      "expr": "support_xx*support_yy*support_zz-(support_xx*support_yz**2+support_yy*support_xz**2+support_zz*support_xy**2)/2+support_xy*support_yz*support_xz/sqrt(2)"
    },
    {
      "name": "p",
      "expr": "trace(sigma)/3"
    },
    {
      "name": "H",
      "expr": "sigma/trace(sigma)"
    },
    {
      "name": "Hdev",
      "expr": "dev(dev(sigma))/trace(sigma)"
    },
    {
      "name": "j2",
      "expr": "dot(Hdev,Hdev)"
    },
    {
      "name": "j3",
      "expr": "cube_trace(Hdev)"
    },
    {
      "name": "detH",
      "expr": "1/27-j2/6+j3/3"
    },
    {
      "name": "pairH",
      "expr": "1/3-j2/2"
    },
    {
      "name": "a",
      "expr": "sqrt(3)*(3-sin(phi_c))/(2*sqrt(2)*sin(phi_c))"
    },
    {
      "name": "Q",
      "expr": "3+a*a"
    },
    {
      "name": "alpha",
      "expr": "log(((lambda_star-kappa_star)/(lambda_star+kappa_star))*Q/(a*sqrt(3)))/log(2)"
    },
    {
      "name": "Delta",
      "expr": "Q-2**alpha*a*sqrt(3)"
    },
    {
      "name": "c1",
      "expr": "2*Delta/(9*r)"
    },
    {
      "name": "c2",
      "expr": "1+(1-c1)*3/(a*a)"
    },
    {
      "name": "Yi",
      "expr": "sqrt(3)*a/Q"
    },
    {
      "name": "Y",
      "expr": "Yi+(1-Yi)*(j2-3*j3)*cos(phi_c)**2/(8*detH*sin(phi_c)**2)"
    },
    {
      "name": "raw_lode",
      "expr": "select(j2 >= j2_floor,-sqrt(6)*j3/j2**(3/2),0)"
    },
    {
      "name": "tanpsi",
      "expr": "sqrt(3*j2)"
    },
    {
      "name": "F",
      "expr": "sqrt(tanpsi**2/8+(2-tanpsi**2)/(2+sqrt(2)*tanpsi*raw_lode))-tanpsi/(2*sqrt(2))"
    },
    {
      "name": "m",
      "expr": "select(j2 > 0,-a/F*(H+Hdev-(H/3)*(6*dot(H,H)-1)/((F/a)**2+dot(H,H))),(-a/Q)*I)"
    },
    {
      "name": "m_unit",
      "expr": "m/norm(m)"
    },
    {
      "name": "pe",
      "expr": "p_ref*exp((N-log1p(e))/lambda_star)"
    },
    {
      "name": "fd",
      "expr": "(2*p/pe)**alpha"
    },
    {
      "name": "fs",
      "expr": "3*p/(lambda_star*Delta)"
    },
    {
      "name": "LE",
      "expr": "3*(c1*de+c2*a*a*H*dot(H,de))"
    },
    {
      "name": "Lm",
      "expr": "3*(c1*m_unit+c2*a*a*H*dot(H,m_unit))"
    },
    {
      "name": "stress_rate",
      "expr": "fs*(LE+fd*Y*Lm*norm(de))"
    },
    {
      "name": "e_rate",
      "expr": "-(1+e)*trace(de)"
    },
    {
      "name": "sphere_residual",
      "expr": "abs(dot(sigma,sym(1,-1,0,0,0,0)))+abs(dot(sigma,sym(0,1,-1,0,0,0)))+abs(dot(sigma,sym(0,0,0,1,0,0)))+abs(dot(sigma,sym(0,0,0,0,1,0)))+abs(dot(sigma,sym(0,0,0,0,0,1)))"
    }
  ],
  "equations": {
    "sigma": "stress_rate",
    "e": "e_rate"
  },
  "domain": [
    "support_norm > 0",
    "support_xx > 0",
    "support_yy > 0",
    "support_zz > 0",
    "support_minor2 > 1.4210854715202004e-14",
    "support_det > 1.4210854715202004e-14",
    "e >= 0",
    "lambda_star > kappa_star",
    "alpha > 0",
    "p > 0*p_ref",
    "pairH > 0",
    "detH > 0",
    "c1 > 0",
    "c1+c2*a*a*dot(H,H) > 0",
    "select(j2 > 0,j2/j2_floor,1) >= 1",
    "select(j2 > 0,0*p_ref,sphere_residual) <= 0*p_ref",
    "raw_lode >= -1-lode_allowance",
    "raw_lode <= 1+lode_allowance",
    "F > 0",
    "Y > 0",
    "norm(m) > 0",
    "pe > 0*p_ref",
    "fd > 0",
    "fs > 0*p_ref",
    "abs(j2) <= 1e250",
    "abs(j3) <= 1e250",
    "abs(detH) <= 1e250",
    "abs(pairH) <= 1e250",
    "abs(a) <= 1e250",
    "abs(Q) <= 1e250",
    "abs(alpha) <= 1e250",
    "abs(Delta) <= 1e250",
    "abs(c1) <= 1e250",
    "abs(c2) <= 1e250",
    "abs(Yi) <= 1e250",
    "abs(Y) <= 1e250",
    "abs(raw_lode) <= 1e250",
    "abs(tanpsi) <= 1e250",
    "abs(F) <= 1e250",
    "abs(fd) <= 1e250",
    "abs(e_rate) <= 1e250",
    "norm(m) <= 1e250",
    "norm(m_unit) <= 1e250",
    "norm(LE) <= 1e250",
    "norm(Lm) <= 1e250",
    "abs(p) <= p_ref*1e250",
    "abs(pe) <= p_ref*1e250",
    "abs(fs) <= p_ref*1e250",
    "norm(stress_rate) <= p_ref*1e250"
  ],
  "formulation": {
    "time_dependence": "strain_path",
    "equation_form": "strain_path_rate",
    "kinematics": "small_strain_3d",
    "frame": "fixed_spatial",
    "objective_rate": "none",
    "tensor_representation": "mandel",
    "stress_sign": "compression_positive",
    "strain_sign": "compression_positive",
    "stress": {
      "source": "state",
      "name": "sigma",
      "measure": "cauchy",
      "scope": "effective"
    },
    "inputs": {
      "equation": {
        "de": {
          "quantity": "strain_increment",
          "measure": "infinitesimal_strain",
          "shape": "sym",
          "unit": "1",
          "configuration": "current",
          "sampling": "increment",
          "constraint": "finite"
        }
      },
      "advance": {}
    }
  },
  "initialization": {
    "method": "explicit_state",
    "default_policy": "examples_only",
    "required_state": [
      "sigma",
      "e"
    ],
    "validation": "domain_and_initial_checks"
  }
}
