{
  "schema_version": "0.1",
  "status": "draft",
  "parameters": {
    "p_ref": {
      "default": 1000,
      "min": 1,
      "max": 1000000000.0,
      "unit": "Pa"
    },
    "limit": {
      "default": 100,
      "min": 0.001,
      "max": 1000000000.0,
      "unit": "1"
    }
  },
  "state": [
    {
      "name": "sigma",
      "shape": "sym",
      "unit": "Pa",
      "scale": "p_ref",
      "initial": [
        100,
        100,
        100,
        0,
        0,
        0
      ]
    },
    {
      "name": "coordinate",
      "shape": "scalar",
      "unit": "1",
      "scale": "1",
      "initial": 1
    },
    {
      "name": "anchor",
      "shape": "scalar",
      "unit": "1",
      "scale": "1",
      "initial": 0
    }
  ],
  "derived": [],
  "domain": [
    "abs(coordinate) < limit"
  ],
  "integration": "rate",
  "id": "test-parent-reset-cutback",
  "name": "Synthetic nonlinear parent-reset cutback fixture",
  "family": "engine verification only",
  "description": "Transactional reset verification only; not SANISAND.",
  "sources": [
    {
      "url": "https://github.com/benjym/constitutive-atlas/blob/main/docs/PARENT_INCREMENT_RESETS.md",
      "role": "Analytical engine verification specification",
      "locator": "Constant loading coordinate and frozen parent-memory reset"
    }
  ],
  "equations": {
    "sigma": "p_ref * de",
    "coordinate": "coordinate * trace(de)",
    "anchor": "0"
  },
  "increment_reset": {
    "scope": "parent_increment",
    "updates": [
      {
        "target": "anchor",
        "guard": "(coordinate - anchor) * trace(de)",
        "value": "coordinate"
      }
    ]
  }
}
