    "abs(friction_a) <= 1e300",
    "abs(alpha_argument) <= 1e300",
    "abs(alpha_f) <= 1e300",
    "abs(stress_norm) <= p_ref*1e300",
    "norm(stress_unit) <= 1e300",
    "abs(s0) <= 1e300",
    "abs(s1) <= 1e300",
    "abs(s2) <= 1e300",
    "abs(s3) <= 1e300",
    "abs(s4) <= 1e300",
    "abs(s5) <= 1e300",
    "abs(stress_minor) <= 1e300",
    "abs(stress_det) <= 1e300",
    "abs(p) <= p_ref*1e300",
    "norm(a) <= 1e300",
    "abs(j2) <= 1e300",
    "abs(j3) <= 1e300",
    "abs(fm) <= 1e300",
    "abs(omega) <= 1e300",
    "abs(pe) <= p_ref*1e300",
    "abs(fd) <= 1e300",
    "abs(fdA) <= 1e300",
    "abs(fs) <= p_ref*1e300",
    "abs(cos3theta) <= 1e300",
    "abs(xi) <= 1e300",
    "norm(dA) <= 1e300",
    "norm(d) <= 1e300",
    "abs(E0) <= 1e300",
    "abs(E1) <= 1e300",
    "abs(E2) <= 1e300",
    "abs(E3) <= 1e300",
    "abs(E4) <= 1e300",
    "abs(E5) <= 1e300",
    "norm(mixed_E) <= 1e300",
    "norm(LE) <= 1e300",
    "abs(d0) <= 1e300",
