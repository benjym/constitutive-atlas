  ],
  "integration": "rate",
  "parameters": {
    "p_ref": {
      "default": 1000,
      "min": 1000,
      "max": 1000,
      "unit": "Pa",
      "label": "Fixed source reference pressure; not a calibration parameter"
    },
    "p_scale": {
      "default": 100000,
      "min": 1,
      "max": 1000000000000.0,
      "unit": "Pa",
      "label": "Numerical stress error scale"
    },
    "phi_c": {
      "default": 0.5235987755982988,
      "min": 0.01,
      "max": 1.4,
      "unit": "1",
      "label": "Critical friction angle, radians; illustrative"
    },
    "lambda_star": {
      "default": 0.12,
      "min": 0.0001,
      "max": 1.0,
      "unit": "1",
      "label": "Logarithmic compression slope; illustrative"
    },
    "kappa_star": {
      "default": 0.025,
      "min": 1e-05,
      "max": 1.0,
      "unit": "1",
      "label": "Logarithmic swelling slope; illustrative"
    },
    "N": {
      "default": 1.1,
      "min": -10.0,
      "max": 10.0,
      "unit": "1",
      "label": "Logarithmic density intercept at 1000Pa; illustrative"
    },
    "nu_pp": {
      "default": 0.1,
      "min": -0.9,
      "max": 0.49,
      "unit": "1",
      "label": "Illustrative inplane Poissonratio; notcalibration"
    },
    "alpha_G": {
      "default": 2,
      "min": 0.01,
      "max": 100,
      "unit": "1",
      "label": "Explicit independent anisotropy ratio; illustrative"
    },
    "alpha_E": {
      "default": 2.378414230005442,
      "min": 0.01,
      "max": 100,
      "unit": "1",
      "label": "Explicit independent anisotropy ratio; illustrative"
    },
    "alpha_nu": {
      "default": 2,
      "min": 0.01,
      "max": 100,
      "unit": "1",
      "label": "Explicit independent anisotropy ratio; illustrative"
    },
    "n1": {
      "default": 0,
      "min": -1,
      "max": 1,
      "unit": "1",
      "label": "Fixed actual unitaxis component; no normalization"
    },
    "n2": {
      "default": 0,
      "min": -1,
      "max": 1,
      "unit": "1",
      "label": "Fixed actual unitaxis component; no normalization"
    },
    "n3": {
      "default": 1,
      "min": -1,
      "max": 1,
      "unit": "1",
      "label": "Fixed actual unitaxis component; no normalization"
    },
    "source_a": {
      "default": 0.3,
      "min": 0.3,
      "max": 0.3,
      "unit": "1",
      "label": "Fixed declared source/numerical policy"
    },
    "lode_roundoff_allowance": {
      "default": 1.4210854715202004e-14,
      "min": 1.4210854715202004e-14,
      "max": 1.4210854715202004e-14,
      "unit": "1",
      "label": "Fixed declared source/numerical policy"
    },
    "orientation_allowance": {
      "default": 1.4210854715202004e-14,
      "min": 1.4210854715202004e-14,
      "max": 1.4210854715202004e-14,
      "unit": "1",
      "label": "Fixed declared source/numerical policy"
    },
    "stress_interior_margin": {
      "default": 1.4210854715202004e-14,
      "min": 1.4210854715202004e-14,
      "max": 1.4210854715202004e-14,
      "unit": "1",
      "label": "Fixed declared source/numerical policy"
    }
  },
  "state": [
    {
      "name": "sigma",
      "shape": "sym",
      "unit": "Pa",
      "initial": [
        10000.0,
        10000.0,
        10000.0,
        0.0,
        0.0,
        0.0
      ],
      "scale": "p_scale"
    },
    {
      "name": "e",
      "shape": "scalar",
      "unit": "1",
      "initial": 0.8,
      "scale": "1"
    }
  ],
  "derived": [
    {
      "name": "axis_norm2",
      "expr": "n1*n1+n2*n2+n3*n3"
    },
    {
      "name": "P",
      "expr": "sym(n1*n1,n2*n2,n3*n3,sqrt(2)*n1*n2,sqrt(2)*n2*n3,sqrt(2)*n1*n3)"
    },
    {
      "name": "B",
      "expr": "1-nu_pp-2*alpha_E*nu_pp**2/alpha_nu**2"
    },
    {
      "name": "a1",
      "expr": "alpha_E*B"
    },
    {
      "name": "a2",
      "expr": "alpha_E*nu_pp*(1+alpha_E*nu_pp/alpha_nu**2)"
    },
    {
      "name": "a3",
      "expr": "alpha_E*nu_pp*(1/alpha_nu+nu_pp/alpha_nu-1-alpha_E*nu_pp/alpha_nu**2)"
    },
    {
      "name": "a4",
      "expr": "alpha_E*B*(1-alpha_G)/alpha_G"
    },
    {
      "name": "a5",
      "expr": "alpha_E*(1-alpha_E*nu_pp**2/alpha_nu**2)+1-nu_pp**2-2*alpha_E*nu_pp*(1+nu_pp)/alpha_nu-2*alpha_E*B/alpha_G"
    },
    {
      "name": "Am",
      "expr": "nu_pp**2*(4*alpha_E/alpha_nu-2*alpha_E**2+2*alpha_E**2/alpha_nu**2-1)+nu_pp*(4*alpha_E/alpha_nu+2*alpha_E)+2*alpha_E+1"
    },
    {
      "name": "Am_trace",
      "expr": "3*a1+9*a2+6*a3+2*a4+a5"
    },
    {
      "name": "Am_discrepancy",
      "expr": "Am-Am_trace"
    },
    {
      "name": "elastic_scale",
      "expr": "abs(a1)+3*abs(a2)+2*abs(a3)+2*abs(a4)+abs(a5)"
    },
    {
      "name": "elastic_xx",
      "expr": "(a1+a2)/elastic_scale"
    },
    {
      "name": "elastic_xy",
      "expr": "a2/elastic_scale"
    },
    {
      "name": "elastic_xz",
      "expr": "(a2+a3)/elastic_scale"
    },
    {
      "name": "elastic_zz",
      "expr": "(a1+a2+2*a3+2*a4+a5)/elastic_scale"
    },
    {
      "name": "elastic_minor",
      "expr": "elastic_xx**2-elastic_xy**2"
    },
    {
      "name": "elastic_det",
      "expr": "(elastic_xx-elastic_xy)*((elastic_xx+elastic_xy)*elastic_zz-2*elastic_xz**2)"
    },
    {
      "name": "friction_a",
      "expr": "sqrt(3)*(3-sin(phi_c))/(2*sqrt(2)*sin(phi_c))"
    },
    {
      "name": "alpha_argument",
      "expr": "((lambda_star-kappa_star)/(lambda_star+kappa_star))*(3+friction_a**2)/(friction_a*sqrt(3))"
    },
    {
      "name": "alpha_f",
      "expr": "log(alpha_argument)/log(2)"
    },
    {
      "name": "stress_norm",
      "expr": "norm(sigma)"
    },
    {
      "name": "stress_unit",
      "expr": "sigma/stress_norm"
    },
    {
      "name": "s0",
      "expr": "dot(stress_unit,sym(1,0,0,0,0,0))"
    },
    {
      "name": "s1",
      "expr": "dot(stress_unit,sym(0,1,0,0,0,0))"
    },
    {
      "name": "s2",
      "expr": "dot(stress_unit,sym(0,0,1,0,0,0))"
    },
    {
      "name": "s3",
      "expr": "dot(stress_unit,sym(0,0,0,1,0,0))"
    },
    {
      "name": "s4",
      "expr": "dot(stress_unit,sym(0,0,0,0,1,0))"
    },
    {
      "name": "s5",
      "expr": "dot(stress_unit,sym(0,0,0,0,0,1))"
    },
    {
      "name": "stress_minor",
      "expr": "s0*s1-s3*s3/2"
    },
    {
      "name": "stress_det",
      "expr": "s0*s1*s2-(s0*s4*s4+s1*s5*s5+s2*s3*s3)/2+s3*s4*s5/sqrt(2)"
    },
    {
      "name": "p",
      "expr": "trace(sigma)/3"
    },
    {
      "name": "a",
      "expr": "dev(dev(sigma))/trace(sigma)"
    },
    {
      "name": "j2",
      "expr": "dot(a,a)"
    },
    {
      "name": "j3",
      "expr": "cube_trace(a)"
    },
    {
      "name": "fm",
      "expr": "(j2-3*j3)/(8/27-(j2+j3)/3)"
    },
    {
      "name": "omega",
      "expr": "-log(cos(phi_c)**2)/log(2)+source_a*(fm-sin(phi_c)**2)"
    },
    {
      "name": "pe",
      "expr": "p_ref*exp((N-log(1+e))/lambda_star)"
    },
    {
      "name": "fd",
      "expr": "(2*p/pe)**alpha_f"
    },
    {
      "name": "fdA",
      "expr": "2**alpha_f*(1-fm)**(alpha_f/omega)"
    },
    {
      "name": "fs",
      "expr": "9*p/(2*Am)*(1/lambda_star+1/kappa_star)"
    },
    {
      "name": "cos3theta",
      "expr": "select(j2 > 0,-sqrt(6)*j3/j2**(3/2),0)"
    },
    {
      "name": "xi",
      "expr": "1.7+3.9*sin(phi_c)**2"
    },
    {
      "name": "dA",
      "expr": "-a+I*(2/3-(cos3theta+1)*fm**(1/4)/4)*(fm**(xi/2)-sin(phi_c)**xi)/(1-sin(phi_c)**xi)"
    },
    {
      "name": "d",
      "expr": "dA/norm(dA)"
    },
    {
      "name": "E0",
      "expr": "dot(de,sym(1,0,0,0,0,0))"
    },
    {
      "name": "E1",
      "expr": "dot(de,sym(0,1,0,0,0,0))"
    },
    {
      "name": "E2",
      "expr": "dot(de,sym(0,0,1,0,0,0))"
    },
    {
      "name": "E3",
      "expr": "dot(de,sym(0,0,0,1,0,0))"
    },
    {
      "name": "E4",
      "expr": "dot(de,sym(0,0,0,0,1,0))"
    },
    {
      "name": "E5",
      "expr": "dot(de,sym(0,0,0,0,0,1))"
    },
    {
      "name": "mixed_E",
      "expr": "sym(2*n1*n1*E0+sqrt(2)*n1*n2*E3+sqrt(2)*n1*n3*E5,2*n2*n2*E1+sqrt(2)*n1*n2*E3+sqrt(2)*n2*n3*E4,2*n3*n3*E2+sqrt(2)*n1*n3*E5+sqrt(2)*n2*n3*E4,(n1*n1+n2*n2)*E3+sqrt(2)*n1*n2*(E0+E1)+n1*n3*E4+n2*n3*E5,(n2*n2+n3*n3)*E4+sqrt(2)*n2*n3*(E1+E2)+n1*n2*E5+n1*n3*E3,(n1*n1+n3*n3)*E5+sqrt(2)*n1*n3*(E0+E2)+n1*n2*E4+n2*n3*E3)"
    },
    {
      "name": "LE",
      "expr": "a1*de+a2*trace(de)*I+a3*(P*trace(de)+I*dot(P,de))+a4*mixed_E+a5*P*dot(P,de)"
    },
    {
      "name": "d0",
      "expr": "dot(d,sym(1,0,0,0,0,0))"
    },
    {
      "name": "d1",
      "expr": "dot(d,sym(0,1,0,0,0,0))"
    },
    {
      "name": "d2",
      "expr": "dot(d,sym(0,0,1,0,0,0))"
    },
    {
      "name": "d3",
      "expr": "dot(d,sym(0,0,0,1,0,0))"
    },
    {
      "name": "d4",
      "expr": "dot(d,sym(0,0,0,0,1,0))"
    },
    {
      "name": "d5",
      "expr": "dot(d,sym(0,0,0,0,0,1))"
    },
    {
      "name": "mixed_d",
      "expr": "sym(2*n1*n1*d0+sqrt(2)*n1*n2*d3+sqrt(2)*n1*n3*d5,2*n2*n2*d1+sqrt(2)*n1*n2*d3+sqrt(2)*n2*n3*d4,2*n3*n3*d2+sqrt(2)*n1*n3*d5+sqrt(2)*n2*n3*d4,(n1*n1+n2*n2)*d3+sqrt(2)*n1*n2*(d0+d1)+n1*n3*d4+n2*n3*d5,(n2*n2+n3*n3)*d4+sqrt(2)*n2*n3*(d1+d2)+n1*n2*d5+n1*n3*d3,(n1*n1+n3*n3)*d5+sqrt(2)*n1*n3*(d0+d2)+n1*n2*d4+n2*n3*d3)"
    },
    {
      "name": "Ld",
      "expr": "a1*d+a2*trace(d)*I+a3*(P*trace(d)+I*dot(P,d))+a4*mixed_d+a5*P*dot(P,d)"
    },
    {
      "name": "linear_stress_rate",
      "expr": "fs*LE"
    },
    {
      "name": "Ad",
      "expr": "fs*Ld-(sigma/lambda_star)*trace(d)"
    },
    {
      "name": "stress_rate",
      "expr": "linear_stress_rate+(fd/fdA)*Ad*norm(de)"
    },
    {
      "name": "e_rate",
      "expr": "-(1+e)*trace(de)"
    },
    {
      "name": "asbs",
      "expr": "fm+(p/pe)**omega-1"
    },
    {
      "name": "spherical_residual",
      "expr": "abs(dot(sigma,sym(1,-1,0,0,0,0)))+abs(dot(sigma,sym(0,1,-1,0,0,0)))+abs(dot(sigma,sym(0,0,0,1,0,0)))+abs(dot(sigma,sym(0,0,0,0,1,0)))+abs(dot(sigma,sym(0,0,0,0,0,1)))"
    }
  ],
  "equations": {
    "sigma": "stress_rate",
    "e": "e_rate"
  },
  "domain": [
    "e >= 0",
    "lambda_star > kappa_star",
    "alpha_G > 0",
    "alpha_E > 0",
    "alpha_nu > 0",
    "select(j2 > 0,0*p_ref,spherical_residual) <= 0*p_ref",
    "abs(axis_norm2-1) <= orientation_allowance",
    "B > 0",
    "Am > 0",
    "elastic_scale > 0",
    "elastic_xx > 1.4210854715202004e-14",
    "elastic_minor > 1.4210854715202004e-14",
    "elastic_det > 1.4210854715202004e-14",
    "a1/elastic_scale > 1.4210854715202004e-14",
    "(a1+a4)/elastic_scale > 1.4210854715202004e-14",
    "alpha_argument > 0",
    "stress_norm > 0*p_ref",
    "stress_minor > stress_interior_margin",
    "s0 > 0",
    "s1 > 0",
    "s2 > 0",
    "stress_det > stress_interior_margin",
    "p > p*0",
    "fm >= 0",
    "fm < 1",
    "omega > 0",
    "pe > pe*0",
    "fd > 0",
    "fdA > 0",
    "fs > fs*0",
    "cos3theta >= -1-lode_roundoff_allowance",
    "cos3theta <= 1+lode_roundoff_allowance",
    "norm(dA) > 0",
    "abs(axis_norm2) <= 1e300",
    "norm(P) <= 1e300",
    "abs(B) <= 1e300",
    "abs(a1) <= 1e300",
    "abs(a2) <= 1e300",
    "abs(a3) <= 1e300",
    "abs(a4) <= 1e300",
