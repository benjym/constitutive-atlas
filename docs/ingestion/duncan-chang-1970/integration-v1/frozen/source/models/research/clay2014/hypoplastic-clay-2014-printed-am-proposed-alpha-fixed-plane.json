{
  "schema_version": "0.1",
  "id": "hypoplastic-clay-2014-printed-am-proposed-alpha-fixed-plane-research",
  "name": "Clay hypoplasticity2014 \u2014 printedAm/proposedalpha fixedplane research",
  "family": "hypoplasticity",
  "description": "Isolated7state rate transcription of2014author manuscript Eqs2-15,34-50; printedEq14Am selected despite discrepancy fromtraceL(I), proposedEq49alpha_f andfixedsourcea0.3; compressionpositive/zero-spin/fixedactualmaterialplane, noIGS. Illustrativefixtures,notcalibration. No experimental/integration/tangent/publicadmission; sourcefinalreconciliationopen.",
  "status": "draft",
  "sources": [
    {
      "url": "https://doi.org/10.1680/geot.13.P.065",
