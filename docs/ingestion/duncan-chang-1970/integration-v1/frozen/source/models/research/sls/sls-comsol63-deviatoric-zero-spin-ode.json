{
  "schema_version": "0.3",
  "id": "sls-comsol63-deviatoric-zero-spin-ode",
  "name": "COMSOL 6.3 Standard Linear Solid \u2014 deviatoric dry zero-spin ODE",
  "family": "linear viscoelasticity",
  "description": "One Maxwell branch parallel to an equilibrium spring; purely elastic bulk. Small-strain fixed-spatial compression-positive specialization of COMSOL 6.3 SLS theory with no initial stress offset, thermal, pore or fractional effects. State q is branch overstress, not the source spring-strain q_m. Parameters, numerical bounds, trace tolerance and zero example state are project choices, not calibration.",
  "status": "draft",
  "sources": [
    {
      "url": "https://doc.comsol.com/6.3/doc/com.comsol.help.sme/sme_ug_theory.06.029.html#3441011",
      "locator": "Standard Linear Solid Model; Fig3-5; anchors3441067,3441073,3954540; images078\u2013080; generalized Maxwell Eq3-29 and Eq3-31; linear elasticity image010",
      "role": "primary vendor mathematical formulation"
    },
    {
      "url": "https://doc.comsol.com/6.3/doc/com.comsol.help.sme/sme_ug_solid.07.016.html",
      "locator": "Viscoelasticity Model: Deviatoric; Standard Linear Solid settings: branch shear modulus, relaxation time and long-term parent stiffness",
      "role": "primary variant and parameter units"
    }
  ],
  "formulation": {
    "time_dependence": "physical_time",
    "equation_form": "ode",
    "kinematics": "small_strain_3d",
    "frame": "fixed_spatial",
    "objective_rate": "none",
    "tensor_representation": "mandel",
    "stress_sign": "compression_positive",
    "strain_sign": "compression_positive",
    "inputs": {
      "equation": {
        "time": {
          "quantity": "time",
          "shape": "scalar",
          "unit": "s",
          "sampling": "stage",
          "constraint": "finite"
        },
        "strain_rate": {
          "quantity": "strain_rate",
          "measure": "infinitesimal_strain_rate",
          "shape": "sym",
          "unit": {
            "si": [
              0,
              0,
              -1,
              0
            ]
          },
          "configuration": "current",
          "sampling": "stage",
          "constraint": "finite"
        }
      },
      "advance": {
        "start_time": {
          "quantity": "time",
          "shape": "scalar",
          "unit": "s",
          "sampling": "start",
          "constraint": "finite"
        },
        "duration": {
          "quantity": "duration",
          "shape": "scalar",
          "unit": "s",
          "sampling": "interval",
          "constraint": "positive_finite"
        }
      }
    },
    "stress": {
      "source": "observable",
      "name": "stress",
      "measure": "cauchy",
      "scope": "total"
    }
  },
  "parameters": {
    "K": {
      "default": 20000000.0,
      "min": 1e-12,
      "max": 1e+30,
      "unit": "Pa",
      "label": "Project illustrative K"
    },
    "Ginf": {
      "default": 4000000.0,
      "min": 1e-12,
      "max": 1e+30,
      "unit": "Pa",
      "label": "Project illustrative Ginf"
    },
    "G1": {
      "default": 6000000.0,
      "min": 1e-12,
      "max": 1e+30,
      "unit": "Pa",
      "label": "Project illustrative G1"
    },
    "tau": {
      "default": 2.0,
      "min": 1e-12,
      "max": 1e+30,
      "unit": "s",
      "label": "Project illustrative tau"
    }
  },
  "state": [
    {
      "name": "eps",
      "shape": "sym",
      "unit": "1",
      "scale": "1",
      "initial": [
        0,
        0,
        0,
        0,
        0,
        0
      ],
      "semantics": {
        "role": "persistent",
        "quantity": "infinitesimal_strain",
        "transformation": "symmetric_spatial_tensor"
      }
    },
    {
      "name": "q",
      "shape": "sym",
      "unit": "Pa",
      "scale": "G1",
      "initial": [
        0,
        0,
        0,
        0,
        0,
        0
      ],
      "semantics": {
        "role": "persistent",
        "quantity": "deviatoric_branch_overstress",
        "transformation": "symmetric_spatial_tensor"
      }
    }
  ],
  "derived": [],
  "equations": {
    "eps": "strain_rate",
    "q": "2 * G1 * dev(strain_rate) - q / tau"
  },
  "domain": [
    "K > 0 * K",
    "Ginf > 0 * Ginf",
    "G1 > 0 * G1",
    "tau > 0 * tau",
    "abs(trace(q)) <= 1e-10 * (Ginf + G1)"
  ],
  "initial_checks": [
    "abs(trace(q)) <= 1e-10 * (Ginf + G1)"
  ],
  "observables": [
    {
      "name": "stress",
      "shape": "sym",
      "unit": "Pa",
      "scale": "K",
      "expr": "K * trace(eps) * I + 2 * Ginf * dev(eps) + q"
    }
  ],
  "initialization": {
    "method": "explicit_state",
    "default_policy": "examples_only",
    "required_state": [
      "eps",
      "q"
    ],
    "validation": "domain_and_initial_checks"
  }
}
