        "derived": [
          {
            "name": "axis_norm2",
            "expr": "n1*n1+n2*n2+n3*n3"
          },
          {
            "name": "P",
            "expr": "sym(n1*n1,n2*n2,n3*n3,sqrt(2)*n1*n2,sqrt(2)*n2*n3,sqrt(2)*n1*n3)"
          },
          {
            "name": "B",
            "expr": "1-nu_pp-2*alpha_E*nu_pp**2/alpha_nu**2"
          },
          {
            "name": "a1",
            "expr": "alpha_E*B"
          },
          {
            "name": "a2",
            "expr": "alpha_E*nu_pp*(1+alpha_E*nu_pp/alpha_nu**2)"
          },
          {
            "name": "a3",
            "expr": "alpha_E*nu_pp*(1/alpha_nu+nu_pp/alpha_nu-1-alpha_E*nu_pp/alpha_nu**2)"
          },
          {
            "name": "a4",
            "expr": "alpha_E*B*(1-alpha_G)/alpha_G"
          },
          {
            "name": "a5",
            "expr": "alpha_E*(1-alpha_E*nu_pp**2/alpha_nu**2)+1-nu_pp**2-2*alpha_E*nu_pp*(1+nu_pp)/alpha_nu-2*alpha_E*B/alpha_G"
          },
          {
            "name": "Am",
            "expr": "nu_pp**2*(4*alpha_E/alpha_nu-2*alpha_E**2+2*alpha_E**2/alpha_nu**2-1)+nu_pp*(4*alpha_E/alpha_nu+2*alpha_E)+2*alpha_E+1"
          },
          {
            "name": "Am_trace",
            "expr": "3*a1+9*a2+6*a3+2*a4+a5"
          },
          {
            "name": "Am_discrepancy",
            "expr": "Am-Am_trace"
          },
          {
            "name": "elastic_scale",
            "expr": "abs(a1)+3*abs(a2)+2*abs(a3)+2*abs(a4)+abs(a5)"
          },
          {
            "name": "elastic_xx",
            "expr": "(a1+a2)/elastic_scale"
          },
          {
            "name": "elastic_xy",
            "expr": "a2/elastic_scale"
          },
          {
            "name": "elastic_xz",
            "expr": "(a2+a3)/elastic_scale"
          },
          {
            "name": "elastic_zz",
            "expr": "(a1+a2+2*a3+2*a4+a5)/elastic_scale"
          },
          {
            "name": "elastic_minor",
            "expr": "elastic_xx**2-elastic_xy**2"
          },
          {
            "name": "elastic_det",
            "expr": "(elastic_xx-elastic_xy)*((elastic_xx+elastic_xy)*elastic_zz-2*elastic_xz**2)"
          },
          {
            "name": "friction_a",
            "expr": "sqrt(3)*(3-sin(phi_c))/(2*sqrt(2)*sin(phi_c))"
          },
          {
            "name": "alpha_argument",
            "expr": "((lambda_star-kappa_star)/(lambda_star+kappa_star))*(3+friction_a**2)/(friction_a*sqrt(3))"
          },
          {
            "name": "alpha_f",
            "expr": "log(alpha_argument)/log(2)"
          },
          {
            "name": "stress_norm",
            "expr": "norm(sigma)"
          },
          {
            "name": "stress_unit",
            "expr": "sigma/stress_norm"
          },
          {
            "name": "s0",
            "expr": "dot(stress_unit,sym(1,0,0,0,0,0))"
          },
          {
            "name": "s1",
            "expr": "dot(stress_unit,sym(0,1,0,0,0,0))"
          },
          {
            "name": "s2",
            "expr": "dot(stress_unit,sym(0,0,1,0,0,0))"
          },
          {
            "name": "s3",
            "expr": "dot(stress_unit,sym(0,0,0,1,0,0))"
          },
          {
            "name": "s4",
            "expr": "dot(stress_unit,sym(0,0,0,0,1,0))"
          },
          {
            "name": "s5",
            "expr": "dot(stress_unit,sym(0,0,0,0,0,1))"
