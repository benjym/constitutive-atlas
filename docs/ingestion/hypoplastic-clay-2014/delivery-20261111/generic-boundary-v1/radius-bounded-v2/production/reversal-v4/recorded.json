          {
            "name": "fd",
            "expr": "(2*p/pe)**alpha_f"
          },
          {
            "name": "fdA",
            "expr": "2**alpha_f*(1-fm)**(alpha_f/omega)"
          },
          {
            "name": "fs",
            "expr": "9*p/(2*Am_trace)*(1/lambda_star+1/kappa_star)"
          },
          {
            "name": "cos3theta",
            "expr": "select(j2 > 0,-sqrt(6)*j3/j2**(3/2),0)"
          },
          {
            "name": "xi",
            "expr": "1.7+3.9*sin(phi_c)**2"
          },
          {
            "name": "dA",
            "expr": "-a+I*(2/3-(cos3theta+1)*fm**(1/4)/4)*(fm**(xi/2)-sin(phi_c)**xi)/(1-sin(phi_c)**xi)"
          },
          {
            "name": "d",
