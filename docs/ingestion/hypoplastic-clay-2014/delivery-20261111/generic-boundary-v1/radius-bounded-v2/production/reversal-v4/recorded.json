          {
            "name": "stress_minor",
            "expr": "s0*s1-s3*s3/2"
          },
          {
            "name": "stress_det",
            "expr": "s0*s1*s2-(s0*s4*s4+s1*s5*s5+s2*s3*s3)/2+s3*s4*s5/sqrt(2)"
          },
          {
            "name": "p",
            "expr": "trace(sigma)/3"
          },
          {
            "name": "a",
            "expr": "dev(dev(sigma))/trace(sigma)"
          },
          {
            "name": "j2",
            "expr": "dot(a,a)"
          },
          {
            "name": "j3",
            "expr": "cube_trace(a)"
          },
          {
            "name": "fm",
            "expr": "(j2-3*j3)/(8/27-(j2+j3)/3)"
          },
          {
            "name": "omega",
