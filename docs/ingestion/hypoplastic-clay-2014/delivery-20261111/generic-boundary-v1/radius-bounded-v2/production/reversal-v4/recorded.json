          {
            "name": "E0",
            "expr": "dot(de,sym(1,0,0,0,0,0))"
          },
          {
            "name": "E1",
            "expr": "dot(de,sym(0,1,0,0,0,0))"
          },
          {
            "name": "E2",
            "expr": "dot(de,sym(0,0,1,0,0,0))"
          },
          {
            "name": "E3",
            "expr": "dot(de,sym(0,0,0,1,0,0))"
          },
          {
            "name": "E4",
            "expr": "dot(de,sym(0,0,0,0,1,0))"
          },
          {
            "name": "E5",
            "expr": "dot(de,sym(0,0,0,0,0,1))"
          },
          {
            "name": "mixed_E",
            "expr": "sym(2*n1*n1*E0+sqrt(2)*n1*n2*E3+sqrt(2)*n1*n3*E5,2*n2*n2*E1+sqrt(2)*n1*n2*E3+sqrt(2)*n2*n3*E4,2*n3*n3*E2+sqrt(2)*n1*n3*E5+sqrt(2)*n2*n3*E4,(n1*n1+n2*n2)*E3+sqrt(2)*n1*n2*(E0+E1)+n1*n3*E4+n2*n3*E5,(n2*n2+n3*n3)*E4+sqrt(2)*n2*n3*(E1+E2)+n1*n2*E5+n1*n3*E3,(n1*n1+n3*n3)*E5+sqrt(2)*n1*n3*(E0+E2)+n1*n2*E4+n2*n3*E3)"
          },
          {
            "name": "LE",
            "expr": "a1*de+a2*trace(de)*I+a3*(P*trace(de)+I*dot(P,de))+a4*mixed_E+a5*P*dot(P,de)"
          },
          {
            "name": "d0",
            "expr": "dot(d,sym(1,0,0,0,0,0))"
          },
          {
            "name": "d1",
            "expr": "dot(d,sym(0,1,0,0,0,0))"
          },
          {
            "name": "d2",
            "expr": "dot(d,sym(0,0,1,0,0,0))"
          },
          {
            "name": "d3",
            "expr": "dot(d,sym(0,0,0,1,0,0))"
          },
          {
            "name": "d4",
            "expr": "dot(d,sym(0,0,0,0,1,0))"
          },
          {
            "name": "d5",
            "expr": "dot(d,sym(0,0,0,0,0,1))"
          },
          {
            "name": "mixed_d",
            "expr": "sym(2*n1*n1*d0+sqrt(2)*n1*n2*d3+sqrt(2)*n1*n3*d5,2*n2*n2*d1+sqrt(2)*n1*n2*d3+sqrt(2)*n2*n3*d4,2*n3*n3*d2+sqrt(2)*n1*n3*d5+sqrt(2)*n2*n3*d4,(n1*n1+n2*n2)*d3+sqrt(2)*n1*n2*(d0+d1)+n1*n3*d4+n2*n3*d5,(n2*n2+n3*n3)*d4+sqrt(2)*n2*n3*(d1+d2)+n1*n2*d5+n1*n3*d3,(n1*n1+n3*n3)*d5+sqrt(2)*n1*n3*(d0+d2)+n1*n2*d4+n2*n3*d3)"
          },
          {
            "name": "Ld",
            "expr": "a1*d+a2*trace(d)*I+a3*(P*trace(d)+I*dot(P,d))+a4*mixed_d+a5*P*dot(P,d)"
          },
          {
            "name": "linear_stress_rate",
            "expr": "fs*LE"
          },
          {
            "name": "Ad",
            "expr": "fs*Ld-(sigma/lambda_star)*trace(d)"
          },
          {
            "name": "Hnorm",
            "expr": "norm(H)"
          },
          {
            "name": "h",
            "expr": "select(Hnorm > 0,H/Hnorm,0*H)"
          },
          {
            "name": "rho",
            "expr": "Hnorm/R"
          },
          {
            "name": "q",
            "expr": "dot(h,de)"
          },
          {
            "name": "w",
            "expr": "rho**chi"
          },
          {
            "name": "Gtarget",
            "expr": "p_ref*Ag*(p/p_ref)**ng"
          },
          {
            "name": "mR",
            "expr": "Gtarget*4*Am_trace*alpha_G/(9*p*alpha_E)*lambda_star*kappa_star/(lambda_star+kappa_star)/B"
          },
          {
            "name": "mT",
            "expr": "mrat*mR"
          },
          {
            "name": "c_igs",
            "expr": "w*mT+(1-w)*mR"
          },
          {
            "name": "h0",
            "expr": "dot(h,sym(1,0,0,0,0,0))"
          },
          {
            "name": "h1",
            "expr": "dot(h,sym(0,1,0,0,0,0))"
          },
          {
            "name": "h2",
            "expr": "dot(h,sym(0,0,1,0,0,0))"
          },
          {
            "name": "h3",
            "expr": "dot(h,sym(0,0,0,1,0,0))"
          },
          {
            "name": "h4",
            "expr": "dot(h,sym(0,0,0,0,1,0))"
          },
          {
            "name": "h5",
            "expr": "dot(h,sym(0,0,0,0,0,1))"
          },
          {
            "name": "mixed_h",
            "expr": "sym(2*n1*n1*h0+sqrt(2)*n1*n2*h3+sqrt(2)*n1*n3*h5,2*n2*n2*h1+sqrt(2)*n1*n2*h3+sqrt(2)*n2*n3*h4,2*n3*n3*h2+sqrt(2)*n1*n3*h5+sqrt(2)*n2*n3*h4,(n1*n1+n2*n2)*h3+sqrt(2)*n1*n2*(h0+h1)+n1*n3*h4+n2*n3*h5,(n2*n2+n3*n3)*h4+sqrt(2)*n2*n3*(h1+h2)+n1*n2*h5+n1*n3*h3,(n1*n1+n3*n3)*h5+sqrt(2)*n1*n3*(h0+h2)+n1*n2*h4+n2*n3*h3)"
          },
          {
            "name": "Lh",
            "expr": "a1*h+a2*trace(h)*I+a3*(P*trace(h)+I*dot(P,h))+a4*mixed_h+a5*P*dot(P,h)"
          },
          {
            "name": "H_rate",
            "expr": "select(q > 0,de-h*rho**beta_r*q,de)"
          },
          {
            "name": "normalized_LE",
            "expr": "de+(a2/a1)*trace(de)*I+(a3/a1)*(P*trace(de)+I*dot(P,de))+(a4/a1)*mixed_E+(a5/a1)*P*dot(P,de)"
          },
          {
            "name": "normalized_Lh",
            "expr": "h+(a2/a1)*trace(h)*I+(a3/a1)*(P*trace(h)+I*dot(P,h))+(a4/a1)*mixed_h+(a5/a1)*P*dot(P,h)"
          },
          {
            "name": "calibrated_LE",
            "expr": "2*Gtarget*alpha_G*normalized_LE"
          },
          {
            "name": "calibrated_Lh",
            "expr": "2*Gtarget*alpha_G*normalized_Lh"
          },
          {
            "name": "stress_rate",
            "expr": "(w*mrat+(1-w))*calibrated_LE+select(q > 0,w*(fs*Lh-mrat*calibrated_Lh)*q+w*(fd/fdA)*Ad*q,w*(1-mrat)*calibrated_Lh*q)"
          },
          {
            "name": "e_rate",
            "expr": "-(1+e)*trace(de)"
          },
          {
            "name": "asbs",
            "expr": "fm+(p/pe)**omega-1"
          },
          {
            "name": "spherical_residual",
            "expr": "abs(dot(sigma,sym(1,-1,0,0,0,0)))+abs(dot(sigma,sym(0,1,-1,0,0,0)))+abs(dot(sigma,sym(0,0,0,1,0,0)))+abs(dot(sigma,sym(0,0,0,0,1,0)))+abs(dot(sigma,sym(0,0,0,0,0,1)))"
          }
        ],
        "equations": {
