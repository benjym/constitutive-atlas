{
  "schema_version": "0.1",
  "sha256": "401d964b9f08adcf13bb62e5efe0ead831d3bc22396299762a6883eca49a5c92",
  "models": [
    {
      "schema_version": "0.3",
      "id": "perzyna-comsol63-mises-perfect-zero-spin-ode",
      "name": "COMSOL 6.3 Perzyna \u2014 von Mises perfect viscoplastic dry zero-spin ODE",
      "family": "elastoviscoplasticity",
      "description": "Small-strain isotropic elastic associative von Mises Perzyna law with yield-normalized nonlinear overstress, constant positive yield stress, stress exponent n>=1, no hardening and no thermal/pore effects. Compression-positive fixed-frame specialization. Illustrative parameters are not source calibration; numerical envelope is separately qualified.",
      "status": "draft",
      "sources": [
        {
          "url": "https://doc.comsol.com/6.3/doc/com.comsol.help.sme/sme_ug_theory.06.039.html",
          "locator": "Perzyna Model images073\u2013075; common flow057/059/060; Mises016/022; yield070. Printed mathematical law defines normalization and exponent.",
          "role": "primary vendor mathematical formulation"
        },
        {
          "url": "https://doc.comsol.com/6.3/doc/com.comsol.help.sme/sme_ug_solid.07.024.html",
          "locator": "Perzyna settings discrepancy: lists reference stress but omits n; printed theory073 is selected. Plasticity Model: von Mises/Associated, Perfectly plastic, No kinematic hardening, thermal None.",
          "role": "primary exact variant and viscosity unit"
        },
        {
          "url": "https://doc.comsol.com/6.3/doc/com.comsol.help.sme/sme_ug_theory.06.029.html",
          "locator": "Linear Viscoelasticity introduction: elastic strain subtraction; isotropic elastic stress images008\u2013010",
          "role": "primary isotropic elasticity and source sign convention"
        }
      ],
      "formulation": {
        "time_dependence": "physical_time",
        "equation_form": "ode",
        "kinematics": "small_strain_3d",
        "frame": "fixed_spatial",
        "objective_rate": "none",
        "tensor_representation": "mandel",
        "stress_sign": "compression_positive",
        "strain_sign": "compression_positive",
        "inputs": {
          "equation": {
            "time": {
              "quantity": "time",
              "shape": "scalar",
              "unit": "s",
              "sampling": "stage",
              "constraint": "finite"
            },
            "strain_rate": {
              "quantity": "strain_rate",
              "measure": "infinitesimal_strain_rate",
              "shape": "sym",
              "unit": {
                "si": [
                  0,
                  0,
                  -1,
                  0
                ]
              },
              "configuration": "current",
              "sampling": "stage",
              "constraint": "finite"
            }
          },
          "advance": {
            "start_time": {
              "quantity": "time",
              "shape": "scalar",
              "unit": "s",
              "sampling": "start",
              "constraint": "finite"
            },
            "duration": {
              "quantity": "duration",
              "shape": "scalar",
              "unit": "s",
              "sampling": "interval",
              "constraint": "positive_finite"
            }
          }
        },
        "stress": {
          "source": "observable",
          "name": "stress",
          "measure": "cauchy",
          "scope": "total"
        }
      },
      "parameters": {
        "K": {
          "default": 20000000.0,
          "min": 1e-12,
          "max": 1e+30,
          "unit": "Pa",
          "label": "Project illustrative K"
        },
        "G": {
          "default": 10000000.0,
          "min": 1e-12,
          "max": 1e+30,
          "unit": "Pa",
          "label": "Project illustrative G"
        },
        "sigma_y": {
          "default": 100000.0,
          "min": 1e-12,
          "max": 1e+30,
          "unit": "Pa",
          "label": "Project illustrative sigma_y"
        },
        "A": {
          "default": 0.002,
          "min": 1e-15,
          "max": 1000000.0,
          "unit": {
            "si": [
              0,
              0,
              -1,
              0
            ]
          },
          "label": "Project illustrative viscoplastic rate coefficient"
        },
        "n": {
          "default": 2.0,
          "min": 1.0,
          "max": 8.0,
          "unit": "1",
          "label": "Regular Perzyna stress exponent"
        }
      },
      "state": [
        {
          "name": "eps",
          "shape": "sym",
          "unit": "1",
          "scale": "1",
          "initial": [
            0,
            0,
            0,
            0,
            0,
            0
          ],
          "semantics": {
            "role": "persistent",
            "quantity": "infinitesimal_strain",
            "transformation": "symmetric_spatial_tensor"
          }
        },
        {
          "name": "eps_vp",
          "shape": "sym",
          "unit": "1",
          "scale": "1",
          "initial": [
            0,
            0,
            0,
            0,
            0,
            0
          ],
          "semantics": {
            "role": "persistent",
            "quantity": "viscoplastic_strain",
            "transformation": "symmetric_spatial_tensor"
          }
        },
        {
          "name": "alpha",
          "shape": "scalar",
          "unit": "1",
          "scale": "1",
          "initial": 0,
          "semantics": {
            "role": "persistent",
            "quantity": "accumulated_equivalent_viscoplastic_strain",
            "transformation": "scalar_invariant"
          }
        }
      ],
      "derived": [
        {
          "name": "elastic_strain",
          "expr": "eps - eps_vp"
        },
        {
          "name": "sdev",
          "expr": "2 * G * dev(elastic_strain)"
        },
        {
          "name": "q",
          "expr": "sqrt(1.5) * norm(sdev)"
        },
        {
          "name": "lambda_vp",
          "expr": "A * max(q / sigma_y - 1, 0) ** n"
        }
      ],
      "equations": {
        "eps": "strain_rate",
        "eps_vp": "1.5 * lambda_vp / max(q, sigma_y) * sdev",
        "alpha": "lambda_vp"
      },
      "domain": [
        "K > 0 * K",
        "G > 0 * G",
        "sigma_y > 0 * sigma_y",
        "alpha >= 0",
        "abs(trace(eps_vp)) <= 1e-10",
        "A > 0 * A",
        "n >= 1",
        "n <= 8"
      ],
      "initial_checks": [
        "alpha >= 0",
        "abs(trace(eps_vp)) <= 1e-10",
        "alpha + 1e-10 >= sqrt(2 / 3) * norm(eps_vp)"
      ],
      "observables": [
        {
          "name": "stress",
          "shape": "sym",
          "unit": "Pa",
          "scale": "K",
          "expr": "K * trace(elastic_strain) * I + sdev"
        }
      ],
      "initialization": {
        "method": "explicit_state",
        "default_policy": "examples_only",
        "required_state": [
          "eps",
          "eps_vp",
          "alpha"
        ],
        "validation": "domain_and_initial_checks"
      }
    }
  ]
}
